    <l n="1" type="heading" level="1" caput="49" para="true">TABVLA XLIX.</l>
    <l n="2" type="diagram" level="1">Causa EFFICIENS est vel</l>
    <l n="3" type="diagram" level="2">Per se: quæ rursus dividitur ex efficiendi, tum</l>
    <l n="4" type="diagram" level="3">Vi ac modo: est aut</l>
    <l n="5" type="diagram" level="4">Principalis, &amp; hæc rursus</l>
    <l n="6" type="diagram" level="5">Solitaria, Socia. Est autem sociata vel</l>
    <l n="7" type="diagram" level="6">Necessaria, Contingentes.</l>
    <l n="8" type="diagram" level="5">Impulsiva, quæ vel [?]</l>
    <l n="9" type="diagram" level="6">[?] (Greek)</l>
    <l n="10" type="diagram" level="6">[?] (Greek)</l>
    <l n="11" type="diagram" level="4">Minus principalis, item aut</l>
    <l n="12" type="diagram" level="5">Instrumentalis: est autem instrumentum</l>
    <l n="13" type="diagram" level="6">1. Cooperans, Passivum.</l>
    <l n="14" type="diagram" level="6">2. Absolutum, Secundum.</l>
    <l n="15" type="diagram" level="4">2. Naturalis, Voluntaria; quæ rursus libera vel</l>
    <l n="16" type="diagram" level="5">Mere, Secundum quid.</l>
    <l n="17" type="diagram" level="4">3. Transmutativa, Emanativa.</l>
    <l n="18" type="diagram" level="4">4. Æquivoca, Univoca.</l>
    <l n="19" type="diagram" level="3">Ordine, &amp; sic alia est subordinata</l>
    <l n="20" type="diagram" level="4">Essentialiter &amp; per se: quæ vel</l>
    <l n="21" type="diagram" level="5">Prima, quæ itenum talis</l>
    <l n="22" type="diagram" level="6">Simpliciter &amp; absoluta, Secundum quid.</l>
    <l n="23" type="diagram" level="6">Remota, Propinqua.</l>
    <l n="24" type="diagram" level="5">Secunda, quæ vel</l>
    <l n="25" type="diagram" level="6">Mediata, Immediata.</l>
    <l n="26" type="diagram" level="4">Contingenter.</l>
    <l n="27" type="diagram" level="2">Per accidens, quæ est vel in agentibus</l>
    <l n="28" type="diagram" level="3">Naturalibus,</l>
    <l n="29" type="diagram" level="3">Voluntariis.</l>
