    <l n="1" type="heading" level="1" caput="27" para="true">TABVLA XXVII.</l>
    <l n="2" type="diagram" level="1">Viles &amp; sordidæ Artes sunt vel</l>
    <l n="3" type="diagram" level="2">[?]riaria; Coquæ vel</l>
    <l n="4" type="diagram" level="3">Præparans: vt ars alutariorum alborum &amp; rubrorum, vt vulgo distinguuntur,</l>
    <l n="5" type="diagram" level="3">Conficiens: vt</l>
    <l n="6" type="diagram" level="4">Sutoria,</l>
    <l n="7" type="diagram" level="4">Pellionum &amp;c.</l>
    <l n="8" type="diagram" level="4">Ephippiaria.</l>
    <l n="9" type="diagram" level="2">Purgatoria quæuis: vt, Balneatorum, barbitonsorum, &amp; aliorum huius generis.</l>
    <l n="10" type="heading" level="1" caput="28" para="true">TABVLA XXIIX.</l>
    <l n="11" type="diagram" level="1">Viuendi</l>
    <l n="12" type="diagram" level="2">Decoræ, vt est ars</l>
    <l n="13" type="diagram" level="3">Pictoria, seu acu, seu calamo &amp; penicillo.</l>
    <l n="14" type="diagram" level="3">Cælatoria,</l>
    <l n="15" type="diagram" level="3">Sculptoria.</l>
    <l n="16" type="diagram" level="2">Iucunde: vt ars</l>
    <l n="17" type="diagram" level="3">Cantoria</l>
    <l n="18" type="diagram" level="4">Vocalis,</l>
    <l n="19" type="diagram" level="4">Instrumentalis.</l>
    <l n="20" type="diagram" level="3">Saltatoria,</l>
    <l n="21" type="diagram" level="3">Histrionica,</l>
    <l n="22" type="diagram" level="3">Cupedinaria,</l>
    <l n="23" type="diagram" level="3">Lusoria per pilam, &amp; alia eiusmodi exercitamenta palæstrica.</l>
    <l n="24" type="heading" level="1" caput="29" para="true">TABVLA XXIX.</l>
    <l n="25" type="diagram" level="1">Actualis qualitas est vel</l>
    <l n="26" type="diagram" level="2">Afficiens (scilicet sensus, seu patibilis, vel</l>
    <l n="27" type="diagram" level="3">Prima: eaque vel</l>
    <l n="28" type="diagram" level="4">Magis efficax: vt</l>
    <l n="29" type="diagram" level="5">Lux,</l>
    <l n="30" type="diagram" level="5">Frigus,</l>
    <l n="31" type="diagram" level="5">Calor.</l>
    <l n="32" type="diagram" level="4">Minus efficax: vt</l>
    <l n="33" type="diagram" level="5">Humiditas,</l>
    <l n="34" type="diagram" level="5">Siccitas.</l>
    <l n="35" type="diagram" level="3">Secunda, seu orta à primis: idq; vel</l>
    <l n="36" type="diagram" level="4">Propinquæ: vt</l>
    <l n="37" type="diagram" level="5">Raritas,</l>
    <l n="38" type="diagram" level="5">Densitas,</l>
    <l n="39" type="diagram" level="5">Leuitas,</l>
    <l n="40" type="diagram" level="5">Grauitas,</l>
    <l n="41" type="diagram" level="5">Mollities,</l>
    <l n="42" type="diagram" level="5">Duritics,</l>
    <l n="43" type="diagram" level="5">Lævitas,</l>
    <l n="44" type="diagram" level="5">Asperitas,</l>
    <l n="45" type="diagram" level="5">Lubricitas,</l>
    <l n="46" type="diagram" level="5">Viscositas &amp; Lentor,</l>
    <l n="47" type="diagram" level="5">Friabilitas,</l>
    <l n="48" type="diagram" level="5">Ariditas.</l>
    <l n="49" type="diagram" level="4">Remotæ: vt Vide Tab. [?]</l>
    <l n="50" type="diagram" level="2">Conformans, &amp; dicitur Forma ac Figura, quæ vel</l>
    <l n="51" type="diagram" level="3">Naturalis in corporibus</l>
    <l n="52" type="diagram" level="4">Imperfectis: vt Meteora non pauca: Chasmata, iris, fossæ, parelia, &amp;c.</l>
    <l n="53" type="diagram" level="4">Perfectis: vt figuræ plantarum, animalium.</l>
    <l n="54" type="diagram" level="3">Artificialis: vt figura vestis, sellæ, mensæ, gladii, &amp;c.</l>
