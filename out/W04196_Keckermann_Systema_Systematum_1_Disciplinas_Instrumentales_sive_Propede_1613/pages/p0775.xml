    <l n="1" type="heading" level="1" caput="78" para="true">TABVLA LXXVIII.</l>
    <l n="2" type="diagram" level="1">Deprehensio: Est enim vel</l>
    <l n="3" type="diagram" level="2">Formæ: cum violantur Canones figurarum, vel generales vel speciales,</l>
    <l n="4" type="diagram" level="2">Materiæ, eaque vel</l>
    <l n="5" type="diagram" level="3">In dictione</l>
    <l n="6" type="diagram" level="4">Simplici, ex voci</l>
    <l n="7" type="diagram" level="5">Insolentia. Vide Tab: 79.</l>
    <l n="8" type="diagram" level="5">Ambiguitate. Tab.80.</l>
    <l n="9" type="diagram" level="4">Coniunctæ in quâ est amphibolia, vel ex</l>
    <l n="10" type="diagram" level="5">Syntaxi,</l>
    <l n="11" type="diagram" level="5">Phrasi,</l>
    <l n="12" type="diagram" level="5">Compositione &amp; Diuisione.</l>
    <l n="13" type="diagram" level="3">Extra dictionem, eaque vel circa</l>
    <l n="14" type="diagram" level="4">Conclusionem seu quæstionem: vt</l>
    <l n="15" type="diagram" level="5">Plures interrogationes,</l>
    <l n="16" type="diagram" level="5">Ignoratio Elenchi.</l>
    <l n="17" type="diagram" level="4">Probationem, eaque vel</l>
    <l n="18" type="diagram" level="5">Medium</l>
    <l n="19" type="diagram" level="6">Petitio principii,</l>
    <l n="20" type="diagram" level="6">Sumptio medii falsi.</l>
    <l n="21" type="diagram" level="5">Præmissas</l>
    <l n="22" type="diagram" level="6">Consequentia,</l>
    <l n="23" type="diagram" level="6">A dicto secundum quid.</l>
    <l n="24" type="diagram" level="1">Solutio, quæ est vel</l>
    <l n="25" type="diagram" level="2">Vera,</l>
    <l n="26" type="diagram" level="3">Directa</l>
    <l n="27" type="diagram" level="4">Formæ,</l>
    <l n="28" type="diagram" level="4">Materiæ</l>
    <l n="29" type="diagram" level="5">1. Status controuersiæ vera constitutio.</l>
    <l n="30" type="diagram" level="5">2. Vocis &amp; phrasis ambiguæ distinctio &amp; explicatio.</l>
    <l n="31" type="diagram" level="5">3. Inficiatio falsæ præmissæ.</l>
    <l n="32" type="diagram" level="5">4. Reiectio vitiosæ consequentiæ.</l>
    <l n="33" type="diagram" level="5">5. Limitatio.</l>
    <l n="34" type="diagram" level="3">Indirecta: quæ est vel ad</l>
    <l n="35" type="diagram" level="4">Rem</l>
    <l n="36" type="diagram" level="5">Retorsio.</l>
    <l n="37" type="diagram" level="5">Anthypophora,</l>
    <l n="38" type="diagram" level="5">Ostensio ἀσυστάτ(ου) [?],</l>
    <l n="39" type="diagram" level="5">Oppositio paris aut maioris auctoritatis.</l>
    <l n="40" type="diagram" level="4">Personam</l>
    <l n="41" type="diagram" level="5">ἐπιπαλήξις [?],</l>
    <l n="42" type="diagram" level="5">Obiectio paris vel maioris.</l>
    <l n="43" type="diagram" level="2">Apparens,</l>
    <l n="44" type="diagram" level="3">1. Cum nihil ad rem respondetur.</l>
    <l n="45" type="diagram" level="3">2. Applicatio fallaciæ male intellectæ.</l>
    <l n="46" type="diagram" level="3">3. Irritatio aduersarii.</l>
    <l n="47" type="diagram" level="3">4. ἐξωθενισμός [?],</l>
    <l n="48" type="diagram" level="3">5. παρεκβασις [?].</l>
    <l n="49" type="heading" level="1" caput="79" para="true">TABVLA LXXIX.</l>
    <l n="50" type="diagram" level="1">Ænigmatica obscuritate.</l>
    <l n="51" type="diagram" level="2">ἀσαφής [?]</l>
    <l n="52" type="diagram" level="2">ἀσυνηλογία [?]</l>
    <l n="53" type="heading" level="1" caput="90" para="true">TABVLA XC.</l>
    <l n="54" type="diagram" level="1">Multitudine significationis,</l>
    <l n="55" type="diagram" level="1">Ambiguo flexu, qui iterum vel ratione</l>
    <l n="56" type="diagram" level="2">Orthographiæ,</l>
    <l n="57" type="diagram" level="2">Etymologiæ, vel ex</l>
    <l n="58" type="diagram" level="3">Prosodiæ.</l>
    <l n="59" type="diagram" level="3">Similitudine terminationis,</l>
    <l n="60" type="diagram" level="3">Confusione singularis &amp; pluralis numeri,</l>
    <l n="61" type="diagram" level="3">Diuersitate partium orationis.</l>
    <l n="62" type="heading" level="1" caput="91" para="true">TABVLA XCI.</l>
    <l n="63" type="diagram" level="1">1. Subiectum</l>
    <l n="64" type="diagram" level="2">Vnum, vnitate collectionis &amp; vniuersitatis.</l>
    <l n="65" type="diagram" level="2">Præcognoscitur</l>
    <l n="66" type="diagram" level="3">1. Quod fit,</l>
    <l n="67" type="diagram" level="3">2. Quid fit,</l>
    <l n="68" type="diagram" level="3">3. Vt habeat certa propria seu affectiones.</l>
    <l n="69" type="diagram" level="1">2. Principia, quæ præcognoscuntur</l>
    <l n="70" type="diagram" level="2">1. Quod sint,</l>
    <l n="71" type="diagram" level="2">2. Quid significent.</l>
    <l n="72" type="diagram" level="1">3. Affectiones, quæ præcognoscuntur quod significent.</l>
  </main_text>
