    <head level="1" caput="49">TABVLA XLIX.</head>
    <l type="diagram" level="1">Causa EFFICIENS est vel</l>
    <l type="diagram" level="2">Per se: quæ rursus dividitur ex efficiendi, tum</l>
    <l type="diagram" level="3">Vi ac modo: est aut</l>
    <l type="diagram" level="4">Principalis, &amp; hæc rursus</l>
    <l type="diagram" level="5">Solitaria, Socia. Est autem sociata vel</l>
    <l type="diagram" level="6">Necessaria, Contingentes.</l>
    <l type="diagram" level="5">Impulsiva, quæ vel [?]</l>
    <l type="diagram" level="6">[?] (Greek)</l>
    <l type="diagram" level="6">[?] (Greek)</l>
    <l type="diagram" level="4">Minus principalis, item aut</l>
    <l type="diagram" level="5">Instrumentalis: est autem instrumentum</l>
    <l type="diagram" level="6">1. Cooperans, Passivum.</l>
    <l type="diagram" level="6">2. Absolutum, Secundum.</l>
    <l type="diagram" level="4">2. Naturalis, Voluntaria; quæ rursus libera vel</l>
    <l type="diagram" level="5">Mere, Secundum quid.</l>
    <l type="diagram" level="4">3. Transmutativa, Emanativa.</l>
    <l type="diagram" level="4">4. Æquivoca, Univoca.</l>
    <l type="diagram" level="3">Ordine, &amp; sic alia est subordinata</l>
    <l type="diagram" level="4">Essentialiter &amp; per se: quæ vel</l>
    <l type="diagram" level="5">Prima, quæ itenum talis</l>
    <l type="diagram" level="6">Simpliciter &amp; absoluta, Secundum quid.</l>
    <l type="diagram" level="6">Remota, Propinqua.</l>
    <l type="diagram" level="5">Secunda, quæ vel</l>
    <l type="diagram" level="6">Mediata, Immediata.</l>
    <l type="diagram" level="4">Contingenter.</l>
    <l type="diagram" level="2">Per accidens, quæ est vel in agentibus</l>
    <l type="diagram" level="3">Naturalibus,</l>
    <l type="diagram" level="3">Voluntariis.</l>
    <head level="1" caput="50">TABVLA L.</head>
