    <l n="25" type="heading" level="2">noris cultu prosequendis;</l>
    <l n="26" para="true">
      <i>Has agelli sui primitias, pluribus, nec parvis ipsorum</i>
    </l>
    <l n="27">
      <i>meritis obstrictus,</i>
    </l>
