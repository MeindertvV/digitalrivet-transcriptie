    <l n="66" para="true">12. Utrum in expensas condemnandus,</l>
    <l n="67">qui jusjurandum adversario detulit,</l>
    <l n="68">secundum quod est judicatum?</l>
    <l n="69" type="heading" level="2" para="true">§. 2.</l>
