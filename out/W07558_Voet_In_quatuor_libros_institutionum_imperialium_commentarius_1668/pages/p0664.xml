    <l n="52" para="true">Plures actiones unius rei nomine com-</l>
    <l n="53">petere poterunt.</l>
    <l n="54" type="heading" level="2" para="true">§. 6.</l>
    <l n="55" para="true">Inter filium fam. &amp; servum multiplex</l>
    <l n="56">servatur differentia.</l>
