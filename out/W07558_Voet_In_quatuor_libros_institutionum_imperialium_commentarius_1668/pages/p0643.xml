  <running_head>MATERIARUM</running_head>
  <main_text>
    <l n="1" type="heading" level="2" para="true">§. 5.</l>
    <l n="2" para="true">Necessaria requisita substitutionis pu-</l>
    <l n="3">pillaris enumerantur.</l>
    <l n="4" type="heading" level="2" para="true">§. 6.</l>
    <l n="5" para="true">Novissimo morienti substitui potest.</l>
    <l n="6" type="heading" level="2" para="true">§. 7.</l>
    <l n="7" para="true">Modus, quo alicui substitui potest ex-</l>
    <l n="8">plicatur.</l>
    <l n="9" type="heading" level="2" para="true">§. 8</l>
    <l n="10" para="true">1. Substitutio vulgaris variis modis eva-</l>
    <l n="11">nescit.</l>
    <l n="12" para="true">2. Aliis modis evanescit pupillaris.</l>
    <l n="13" type="heading" level="2" para="true">§. 9.</l>
    <l n="14" para="true">1. Substitutio vel directa vel fideicommis-</l>
    <l n="15">saria.</l>
    <l n="16" para="true">2. Differentia utriusque recensentur.</l>
    <l n="17" para="true">3. Miles solummodo verbis directis ultra</l>
    <l n="18">pubertatem substituere potest.</l>
    <l n="19" para="true">4. Militaris substitutio ab aliis specie di-</l>
    <l n="20">stincta non est.</l>
    <l n="21" para="true">5. Mores circa materiam substitutionis de-</l>
    <l n="22">scribuntur.</l>
    <l n="23" para="true">6. Jus Canonicum refertur.</l>
    <l n="24" type="heading" level="1" caput="17" para="true">LIBR. 2. INSTIT. TIT. 17.</l>
    <l n="25" type="heading" level="2" para="true">Quibus modis testamenta infirmantur.</l>
    <l n="26" para="true">Testamentum vel injustum, vel nu-</l>
    <l n="27">llum, vel ruptum, vel irritum.</l>
    <l n="28" type="heading" level="2" para="true">§. 1.</l>
    <l n="29" para="true">1. Rumpitur testamentum variis modis.</l>
    <l n="30" para="true">2. Etiam agnatione posthumi.</l>
    <l n="31" para="true">3. Quid moribus?</l>
    <l n="32" type="heading" level="2" para="true">§. 2.</l>
    <l n="33">1. Rumpitur prius per posterius ipso jure.</l>
    <l n="34" para="true">2. Quid si facta sint duo testamenta simul?</l>
    <l n="35" para="true">3. Quid si posteriori testamento quis scrip-</l>
    <l n="36">tus sis heres ex re certa?</l>
    <l n="37" para="true">4. Quia si priori testamento jusjurandum</l>
    <l n="38">de non revocando fuerit appositum?</l>
    <l n="39" para="true">5. Quid si testator posterius inciderit?</l>
    <l n="40" type="heading" level="2" para="true">§. 3.</l>
    <l n="41" para="true">1. Non semper testamentum posterius</l>
    <l n="42">rumpit prius.</l>
    <l n="43" para="true">2. Quid moribus?</l>
    <l n="44" type="heading" level="2" para="true">§. 4.</l>
    <l n="45" para="true">Testamentum multis modis fit irritum.</l>
    <l n="46" type="heading" level="2" para="true">§. 5.</l>
    <l n="47" para="true">Vox irritum, varias admittit signifi-</l>
    <l n="48">cationes.</l>
    <l n="49" type="heading" level="2" para="true">§. 6.</l>
    <l n="50" para="true">1. Testamentum irritum factum quando-</l>
    <l n="51">que convalescit.</l>
    <l n="52" para="true">2. Quid moribus?</l>
    <l n="53" type="heading" level="2" para="true">§. 7.</l>
    <l n="54" para="true">1. Nudâ voluntate testamentum non re-</l>
    <l n="55">vocatur.</l>
    <l n="56" para="true">2. Excipitur casus.</l>
    <l n="57" para="true">3. Quid moribus?</l>
    <l n="58" type="heading" level="2" para="true">§. 8.</l>
    <l n="59" para="true">Princeps non vult esse heres ex testa-</l>
    <l n="60">mento imperfecto?</l>
    <l n="61" type="heading" level="1" caput="18" para="true">LIBR. 2. INSTIT. TIT. 18.</l>
    <l n="62" type="heading" level="2" para="true">De Inofficioso testamento.</l>
    <l n="63" para="true">1. ORigo querela explicatur.</l>
    <l n="64" para="true">2. Estque judicium principale.</l>
    <l n="65" para="true">3. Querela quando competat?</l>
    <l n="66" type="heading" level="2" para="true">§. 1.</l>
    <l n="67" para="true">1. Competit liberis.</l>
    <l n="68" para="true">2. Quid moribus?</l>
    <l n="69" para="true">3. Competit parentibus.</l>
    <l n="70" para="true">4. Non tamen sicut liberis.</l>
    <l n="71" para="true">5. Quid moribus?</l>
    <l n="72" para="true">6. Concessa est querela fratribus.</l>
    <l n="73" para="true">**** 7.</l>
  </main_text>
