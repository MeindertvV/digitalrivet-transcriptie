  <main_text>
    <l n="1" para="true">
      <i>Donec arentes riget innocenti</i>
    </l>
    <l n="2" para="true">
      <i>Sanguine fauces.</i>
    </l>
    <l n="3" para="true">
      <i>Sed Deus tantum reprimit furorem,</i>
    </l>
    <l n="4" para="true">
      <i>Nec capi dextra sinit hunc cruenta,</i>
    </l>
    <l n="5" para="true">
      <i>Et sub iniusto quoties laborat</i>
    </l>
    <l n="6" para="true">
      <i>Iudice, seruat.</i>
    </l>
    <l n="7" para="true">
      <i>Vrgeant si te mala multa, spera,</i>
    </l>
    <l n="8" para="true">
      <i>Et Dei iustas uenerare leges,</i>
    </l>
    <l n="9" para="true">
      <i>Illius tandem quoq; te iacentem</i>
    </l>
    <l n="10" para="true">
      <i>Dextra leuabit.</i>
    </l>
    <l n="11" para="true">
      <i>Portio terræ tibi magna cedet,</i>
    </l>
    <l n="12" para="true">
      <i>Hanc in æternum tua stirps tenebit.</i>
    </l>
    <l n="13" para="true">
      <i>At malos contrà scelerum uidebis</i>
    </l>
    <l n="14" para="true">
      <i>Pendere pœnas.</i>
    </l>
    <l n="15" para="true">
      <i>Impios lauro similes uirenti</i>
    </l>
    <l n="16" para="true">
      <i>Ferre conspexi capita alta cœlo.</i>
    </l>
    <l n="17" para="true">
      <i>Sed breui tantos reprimi Gigantes</i>
    </l>
    <l n="18" para="true">
      <i>Tempore uidi.</i>
    </l>
    <l n="19" para="true">
      <i>Iustus, &amp; ueri studiosus æqui,</i>
    </l>
    <l n="20" para="true">
      <i>Cladibus multis licet hic prematur,</i>
    </l>
    <l n="21" para="true">
      <i>Attamen curis semel his solutus</i>
    </l>
    <l n="22" para="true">
      <i>Pace fruetur.</i>
    </l>
    <l n="23" para="true">
      <i>At quibus nec ius pietasq; cordi est,</i>
    </l>
    <l n="24" para="true">
      <i>Exitu certè misero peribunt,</i>
    </l>
    <l n="25" para="true">
      <i>Vna lux illos tumidos uidebit,</i>
    </l>
    <l n="26" para="true">
      <i>Vna iacentes.</i>
