  <page_number>225</page_number>
  <running_head>PARS PRIMA</running_head>
  <bottom_margin>
    <catchword>Culmina</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Quin etiam nota visuntur imaginis umbra,</i>
    </l>
    <l n="2">
      <i>Post obitum maneis Parca redire facit,In</i>
    </l>
    <l n="3">
      <i>cameris etiam chorea peraguntur inanes,</i>
    </l>
    <l n="4">
      <i>Sepius organicum carmina fingit opus.</i>
    </l>
    <l n="5" para="true">
      <i>Sepius horrendi simulant incendia fumi,</i>
    </l>
    <l n="6">
      <i>Sepius audiri fulmina luce solent,</i>
    </l>
    <l n="7">
      <i>Fulmina mentito deterrent, fulgure terram,</i>
    </l>
    <l n="8">
      <i>Nulla licet nubes axe minetur aquam.</i>
    </l>
    <l n="9" para="true">
      <i>Sulphur ab ambrarum cathedris afflatur, &amp;</i>
    </l>
    <l n="10">
      <i>aura,Naribus hostilis fumida peste cadit.</i>
    </l>
    <l n="11">
      <i>Sic adamantaeo sedes ardore ligantur,</i>
    </l>
    <l n="12">
      <i>Nemo queat fixas ut removere loco.</i>
    </l>
    <l n="13" para="true">
      <i>Tartara si dubites hic volvere talia prasto,</i>
    </l>
    <l n="14">
      <i>Hic tibi Ruranæ Tartara vallis erunt.</i>
    </l>
    <l n="15" para="true">
      <i>Dum non rite pilis videantur ducere nomen,</i>
    </l>
    <l n="16">
      <i>Rectius hæc Rura nomina vallis habet.</i>
    </l>
    <l n="17" para="true">
      <i>Eruta deserti spectantur rudera castri,</i>
    </l>
    <l n="18">
      <i>Tecta latent, tecti monstrat arena pedem.</i>
    </l>
    <l n="19">
      <i>Cella patet prabens aditum diversa latebris,</i>
    </l>
    <l n="20">
      <i>Dira pavimentum turbat imago sigit.</i>
    </l>
    <l n="21">
      <i>Desolata iacent aliis vestigia castris,</i>
    </l>
    <l n="22">
      <i>Tractibus hæc etiam Damone plena iacent.</i>
    </l>
    <l n="23" para="true">
      <i>Visitur horribili Volmenia Damone rupes,</i>
    </l>
    <l n="24">
      <i>Horrida terribili visitur arce locus.</i>
    </l>
    <l n="25" para="true">
      <i>Monte canes degunt furvi terrore colono-</i>
    </l>
    <l n="26">
      <i>sAfficiunt, alto tecta fragore tonant.</i>
    </l>
    <l n="27" para="true">
      <i>Quisquis Casareo suspectat vertice castrum,</i>
    </l>
    <l n="28">
      <i>Degenerem nescit dissimulare metum.</i>
    </l>
    <l n="29" para="true">
      <i>Proximus Oestvico Volmam prædatur, &amp; Henna-</i>
    </l>
    <l n="30">
      <i>Brachia, Mescheda proximus ore rapit.</i>
    </l>
    <l n="31" para="true">
      <i>Venna Vrunnole Ruram delapsus adurget,</i>
    </l>
    <l n="32">
      <i>Henna Vredenburgæ raptus omittit aquam.</i>
    </l>
    <l n="33">
      <i>Castra Sicamburgi simulac axessit eundo,</i>
    </l>
    <l n="34">
      <i>Inferius Lenani Rara furore bibit.</i>
    </l>
    <l n="35" para="true">
      <i>Præterit Heerdicum (dextro stat limite pagu-</i>
    </l>
    <l n="36">
      <i>s)Ponte sub oblonge Rura sed arctar aquas.</i>
    </l>
    <l n="37" para="true">
      <i>Deserit ad lævam salebrosi fragmina montis,</i>
    </l>
    <l n="38">
      <i>Casare deductum fragmina nomen habent.</i>
    </l>
    <l n="39" para="true">
      <i>Adjacet excelso Volmenia vertice rupes,</i>
    </l>
    <l n="40">
      <i>Stirpitus eversam culmine Rura vide-</i>
    </l>
    <l n="41">
      <i>t.</i>
    </l>
    <l n="42" para="true">
      <i>Turris adhuc quadrata situ munita repâglis-</i>
    </l>
    <l n="43">
      <i>Surgit, adhuc tecti signa videre licet.</i>
    </l>
    <l n="44" para="true">
      <i>Subjacet horrendi scapulo Weterenia</i>
    </l>
    <l n="45">
      <i>montis,Sepius elabi culmina monte timet.</i>
    </l>
    <l n="46" para="true">
      <i>Flumine Tenȼleros sinuato dissecat amnis,</i>
    </l>
    <l n="47">
      <i>Amnis ad Hatnegi mœnia pene ruit.</i>
    </l>
  </main_text>
