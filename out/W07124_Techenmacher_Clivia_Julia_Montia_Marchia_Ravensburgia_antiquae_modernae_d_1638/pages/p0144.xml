<page type="text" lines="ocr">
  <layout>One page of verse in italic, centred block; running head at top; page number top left; black-letter marginal notes in the right margin beside lines of verse; a catchword-like word "Cratia" at lower right, outside the text block.</layout>
  <page_number>114</page_number>
  <running_head>ANNALIUM</running_head>
  <bottom_margin>
    <catchword>Cratia</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Thurus ad Enshemum leviore nec Ombacus unda</i>
    </l>
    <l n="2" para="true">
      <i>Ad rubeas Ello conciliantur aquas.</i>
    </l>
    <l n="3" para="true">
      <i>Phacidos hinc undam Colmaria mancipat Ello</i>
    </l>
    <l n="4" para="true">
      <i>Mænia Sletstadii fluctifer Ellus adit.</i>
    </l>
    <l n="5" para="true">
      <i>Mænia Benfeldi declivior alluit Ellus</i>
    </l>
    <l n="6" para="true">
      <i>Auctior ad Rhenum ductile flectit iter.</i>
    </l>
    <l n="7" para="true">
      <i>Excipit ad lævam sinuosi flumina Prusis,</i>
    </l>
    <l n="8" para="true">
      <i>Prusis ab occiduo defluit orbe satus.</i>
    </l>
    <l n="9" para="true">
      <i>Alluit argento qua nomina mutuat, urbem,</i>
    </l>
    <l n="10" para="true">
      <i>Compita vicatim prapete lambit aqua.</i>
    </l>
    <l n="11" para="true">
      <i>Hinc quinquaginta stadiis Scuttera fluentum</i>
    </l>
    <l n="12" para="true">
      <i>Quod removet, Rheni labra subire dedit.</i>
    </l>
    <l n="13" para="true">
      <i>Inde decem passus descendunt flumina Rheni</i>
    </l>
    <l n="14" para="true">
      <i>Mille, videt Sornam Rhenus adesse sibi.</i>
    </l>
    <l n="15" para="true">
      <i>Qui latias adiit fluvio simul atque Tabernas</i>
    </l>
    <l n="16" para="true">
      <i>Ante pharetrati fragmina montis abit.</i>
    </l>
    <l n="17" para="true">
      <i>Yennichis occurrit, qui nomine nominat urbem</i>
    </l>
    <l n="18" para="true">
      <i>Rennichiam, Rheni flumen adauget aquis.</i>
    </l>
    <l n="19" para="true">
      <i>Vrbs procul à Rheno, Zephyri declinat ad oras</i>
    </l>
    <l n="20" para="true">
      <i>Nomen Hagenoja rebus adepta fuit.</i>
    </l>
    <l n="21" para="true">
      <i>Ardua provolvit resonantis flumina Malta</i>
    </l>
    <l n="22" para="true">
      <i>Flumina punicco longius acta pede.</i>
    </l>
    <l n="23" para="true">
      <i>Cum subigit læva Benhemia margine ripa</i>
    </l>
    <l n="24" para="true">
      <i>Thermiacas löge dextra relinquit aquas.</i>
    </l>
    <l n="25" para="true">
      <i>Rhenus Saletium delibat mænia gentis,</i>
    </l>
    <l n="26" para="true">
      <i>Saletus Rheni læva subitur aquis.</i>
    </l>
    <l n="27" para="true">
      <i>Infra Rastadium defertur flumine Murgus,</i>
    </l>
    <l n="28" para="true">
      <i>Rastadium dextra Rhenus abesse videt.</i>
    </l>
    <l n="29" para="true">
      <i>Sex simulac gressu superavit millia passum</i>
    </l>
    <l n="30" para="true">
      <i>Flumina Lutteri cominus ire videt.</i>
    </l>
    <l n="31" para="true">
      <i>Dum sua confini Lutterus nomina Castro</i>
    </l>
    <l n="32" para="true">
      <i>Mancipat, hunc Rheni gurgite læva tegit.</i>
    </l>
    <l n="33" para="true">
      <i>Comiter æquato procedit flumine Rhenus</i>
    </l>
    <l n="34" para="true">
      <i>Mænia Numburgi comiter alta ferit.</i>
    </l>
    <l n="35" para="true">
      <i>Suspicit excursu Mulburgi culmina dextro,</i>
    </l>
    <l n="36" para="true">
      <i>Culmina Mulburgi longius amne sita.</i>
    </l>
    <l n="37" para="true">
      <i>Rhenanas alia spectat regione Tabernas</i>
    </l>
    <l n="38" para="true">
      <i>Rhenus adhuc restat signa videre loci.</i>
    </l>
    <l n="39" para="true">
      <i>Vlterius Fortuna dedit restare Tabernas</i>
    </l>
    <l n="40" para="true">
      <i>Solis ad occasum nomina montis habent.</i>
    </l>
    <l n="41" para="true">
      <i>Obviat adverso Srectanum limite Rheni</i>
    </l>
    <l n="42" para="true">
      <i>Dextera Srecanum fluminis ora quatit.</i>
    </l>
    <l n="43" para="true">
      <i>Germarsheima latus Rheni fortita sinistrum</i>
    </l>
    <l n="44" para="true">
      <i>Parva tamen gestit dote superba loci.</i>
    </l>
    <l n="45" para="true">
      <i>Hinc latus ad dextrum subit Vdenhemia, Rhenus</i>
    </l>
    <l n="46" para="true">
      <i>Quattuor ut passum millia carpsit iter.</i>
    </l>
    <l n="47" para="true">
      <i>Altius ad lævam Nemeti stant fluminis ora</i>
    </l>
    <l n="48" para="true">
      <i>Imperium Iuris Speira rigore</i>
    </l>
    <l n="49">
      <i>tenet.</i>
    </l>
  </main_text>
  <marginalia>
