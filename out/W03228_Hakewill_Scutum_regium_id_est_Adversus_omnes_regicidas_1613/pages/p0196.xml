  <page_number>180</page_number>
  <running_head>Scutum Regium LIB. III</running_head>
  <main_text>
    <l n="1" para="true">
      <i>Reddendum est quicquid mundi bene</i>
    </l>
    <l n="2">
      <i>postulat ordo,</i>
    </l>
    <l n="3">
      <i>Propositum, piæ non violat fidei.</i>
    </l>
    <l n="4">
      <i>Mutibus &amp; sanctis nulla est spernenda</i>
    </l>
    <l n="5">
      <i>potestas,</i>
    </l>
    <l n="6">
      <i>Æquum seruire est regibus &amp; dominis.</i>
    </l>
    <l n="7">
      <i>Vt Christi famulis ad verum prosit ho-</i>
    </l>
    <l n="8">
      <i>norem,</i>
    </l>
    <l n="9">
      <i>Dilexisse bonos &amp; tolerâsse malos.</i>
    </l>
    <l n="10" type="heading" level="1" caput="8" para="true">CAP. VIII. <i>De obedientia Orthodoxorum omnium, im-</i>
    </l>
    <l n="11" type="heading" level="1" caput="8">
      <i>primis vero Romanorum pontificum</i>
    </l>
    <l n="12" type="heading" level="1" caput="8">
      <i>erga Anastasium Imperator. Eutychianum:</i>
    </l>
    <l n="13" para="true">Antequam <i>Anastasij</i> Imperatoris</l>
    <l n="14">res gestas aggrediar, operæpretium</l>
    <l n="15">erit in transitu, <i>Valentiani Iunioris</i>, qui</l>
    <l n="16">in Occidente imperauit interitum, &amp;</l>
    <l n="17">pariter in Regicidam Dei unidictam,</l>
    <l n="18">breuiter enarrare. Occisus igitur est</l>
    <l n="19">
      <i>Valentianus</i> in campo Martio ({i}<i>ait Cassi-</i>
    </l>
    <l n="20">
      <i>odorus</i>) dolo <i>Maximi</i> (<i>addit Marcelli-</i>
    </l>
    <l n="21">
      <i>nus</i>) per <i>Ostiam</i> &amp; <i>Transtilam</i> satellites;</l>
    <l n="22">causam verò cur insidias Imperatoris</l>
    <l n="23">vitæ</l>
  </main_text>
  <marginalia>
    <note letter="i" side="left" at="Occisus igitur est" line_from="18" line_to="18">i utriq[?] in Chron.</note>
  </marginalia>
