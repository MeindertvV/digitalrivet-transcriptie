  <running_head>ΕΙΚΩΝ ΒΑΣΙΛΙΚΗ:</running_head>
  <bottom_margin>
    <catchword>respectu</catchword>
  </bottom_margin>
  <main_text>
    <l n="1">Re Ecclesiastica, &amp; Religione discre-</l>
    <l n="2">pantias, liberæ Synodi consultationi,</l>
    <l n="3">vel <i>Convocationi</i> rite electæ permittere,</l>
    <l n="4">cujus tandem decretis (cum omnium</l>
    <l n="5">essent suffragia inclusa) verisimile est</l>
    <l n="6">omnes acquieturos.</l>
    <l n="7" para="true">
      <i>Conventum</i> illum <i>Theologorum</i> quos (mo-</l>
    <l n="8">re quodam insolito &amp; extraordinario)</l>
    <l n="9">
      <i>Domus Vtraque</i> ad deliberandum de <i>Ec-</i>
    </l>
    <l n="10">
      <i>clesiasticis</i> adhibuerunt, hactenus tantum</l>
    <l n="11">non probo, quòd nec legitime <i>congregati</i>
    </l>
    <l n="12">nec <i>electi</i> fuerint; nec totius Cleri <i>An-</i>
    </l>
    <l n="13">
      <i>glicæ</i> partes sustineant, neque omnino</l>
    <l n="14">liberè &amp; incorruptè agere possint, cùm</l>
    <l n="15">(etiamsi nulla alia vis fieret) intra cer-</l>
    <l n="16">tos tamen limites &amp; fines constrin-</l>
    <l n="17">gantur.</l>
    <l n="18" para="true">Illud enim haud facile credam, tot</l>
    <l n="19">homines doctrinæ &amp; pietatis nomine</l>
    <l n="20">insignes, qui <i>Liturgiam</i> &amp; Regimen</l>
    <l n="21">
      <i>Anglicanæ</i> Ecclesiæ haud ita pridem (in</l>
    <l n="22">præcipuis) probaverant, adeo derepen-</l>
    <l n="23">te confensuros in <i>utrunque extirpandum</i>,</l>
    <l n="24">(cum Illud saltem ignorare non possent</l>
    <l n="25">si non <i>Apostolica</i> institutione, at <i>Primiti-</i>
    </l>
    <l n="26">
      <i>va</i> &amp; <i>Vniversali</i> Praxi defendi) modo in-</l>
    <l n="27">tegra fuisset suffragandi libertas, nec</l>
    <l n="28">Diversæ Factionis potentia occultas</l>
    <l n="29">spes &amp; metus instillando in eos tandem</l>
    <l n="30">valuissent, ut has simul promoverent</l>
    <l n="31">plenissimas periculi Novitates, nullo</l>
  </main_text>
