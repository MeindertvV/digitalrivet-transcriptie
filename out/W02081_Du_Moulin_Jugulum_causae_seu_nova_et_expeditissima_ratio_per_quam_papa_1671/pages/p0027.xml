  <running_head>Admonitio.</running_head>
  <main_text>
    <l n="1">&amp; concidente imperio eâdem</l>
    <l n="2">ruinâ involutum iri fidem, Re-</l>
    <l n="3">ligionem &amp; Ecclesiam Roma-</l>
    <l n="4">nensem: tum Sacræ Scripturæ</l>
    <l n="5">suam authoritatem redituram;</l>
    <l n="6">ac proinde omnem authorita-</l>
    <l n="7">tem Romanensium doctrinarum</l>
    <l n="8">perituram: tam inquam neces-</l>
    <l n="9">sariâ consecutione hæc sequen-</l>
    <l n="10">tur &amp; evenient, quam certum</l>
    <l n="11">est orto sole nulla non objecta,</l>
    <l n="12">se datura in conspectum ocula-</l>
    <l n="13">torum: cui consecutioni natu-</l>
    <l n="14">rali, fidem astruit tota cohors</l>
    <l n="15">Romanensium Doctorum, im-</l>
    <l n="16">primis Jesuitarum: namque</l>
    <l n="17">quisquis cum Andradio ait, <i>fide Papæ nostra</i>
    </l>
    <l n="18">
      <i>continetur, &amp; ex ejus unius authoritate nostra salus pendet</i>;</l>
    <l n="19">&amp; cum Gretzero; <i>non recipimus</i>
    </l>
    <l n="20">
      <i>pro verbo Dei, nisi quod definivit</i>
    </l>
    <l n="21">
      <i>Papa in cathedra Petri, hoc ipso</i>
    </l>
    <l n="22">
      <i>dicit diruto Papa ejusque im-</i>
    </l>
    <l n="23">
      <i>perio,</i>
    </l>
  </main_text>
  <notes />
</page>
