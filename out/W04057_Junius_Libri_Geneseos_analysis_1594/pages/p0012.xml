    <l n="1" type="heading" level="1" para="true">SYNOPSIS LIBRI GENESEOS.</l>
    <l n="2" type="heading" level="2" para="true">TABVLA I.</l>
    <l n="3" type="diagram" level="1">Libro Geneseos narrantur</l>
    <l n="4" type="diagram" level="2">generatio</l>
    <l n="5" type="diagram" level="3">universitatis huius,cap.1.</l>
    <l n="6" type="diagram" level="3">generis humani &amp; Ecclesiæ,cap.2.</l>
    <l n="7" type="diagram" level="3">peccati &amp; maledictionum ex eo,cap.3.</l>
    <l n="8" type="diagram" level="2">constitutio mundi</l>
    <l n="9" type="diagram" level="3">prisci,ante diluuium, secundū</l>
    <l n="10" type="diagram" level="4">propagatione peccati maledictionumque,cap.4.</l>
    <l n="11" type="diagram" level="4">conseruationem Ecclesiæ in mundo peccatore,cap.5.</l>
    <l n="12" type="diagram" level="4">iudicia Dei</l>
    <l n="13" type="diagram" level="5">prænūtiatione &amp; significatione,c.6.</l>
    <l n="14" type="diagram" level="5">exsequutione, c.7.</l>
    <l n="15" type="diagram" level="3">sequētis,à diluuio</l>
    <l n="16" type="heading" level="2" para="true">TABVLA II.</l>
    <l n="17" type="diagram" level="1">Constitutio mundi sequentis à diluuio exponitur.</l>
    <l n="18" type="diagram" level="2">quà instauratus est, secundum</l>
    <l n="19" type="diagram" level="3">naturam communem universitatis,cap.8.</l>
    <l n="20" type="diagram" level="3">ius</l>
    <l n="21" type="diagram" level="4">cōmune universitatis,</l>
    <l n="22" type="diagram" level="4">particulare Ecclesiæ, cap.9.</l>
    <l n="23" type="diagram" level="2">post instaurationem, secundum tempora</l>
    <l n="24" type="diagram" level="3">à diluuio ad Abrahamū vsq;</l>
    <l n="25" type="diagram" level="4">communis, mūdi cap.10.</l>
    <l n="26" type="diagram" level="4">singularis, Ecclesiæ, cap.11.</l>
    <l n="27" type="diagram" level="3">Abrahami,B.</l>
    <l n="28" type="diagram" level="3">Isaaci,C.</l>
    <l n="29" type="diagram" level="3">Iacobi,D.</l>
    <l n="30" type="heading" level="2" para="true">TABVLA III.</l>
    <l n="31" type="diagram" level="1">Abrahami tempora distincta sunt</l>
    <l n="32" type="diagram" level="2">vocatione, cuius</l>
    <l n="33" type="diagram" level="3">propositio summa promissionibus coniuncta, fine[?] cap.11. exponitur.</l>
    <l n="34" type="diagram" level="4">sermone,c. 12. &amp; 13.</l>
    <l n="35" type="diagram" level="4">opere, cap. 14.</l>
    <l n="36" type="diagram" level="3">expositio promissionum</l>
    <l n="37" type="diagram" level="4">de hæreditate demonstratur</l>
    <l n="38" type="diagram" level="4">de hæredibus c. 15.&amp;16.</l>
    <l n="39" type="diagram" level="2">federe cap.17.</l>
    <l n="40" type="diagram" level="2">usu effectisque federis promissionum ex vocatione Dei</l>
    <l n="41" type="diagram" level="3">à Deo, communicatione</l>
    <l n="42" type="diagram" level="4">consiliorum, 18.</l>
    <l n="43" type="diagram" level="4">beneficiorum,19.</l>
    <l n="44" type="diagram" level="4">salutis,20.</l>
    <l n="45" type="diagram" level="4">prolis &amp; gloriæ,21.</l>
    <l n="46" type="diagram" level="3">à fidelib.</l>
    <l n="47" type="diagram" level="4">obsequio fidei,22.</l>
    <l n="48" type="diagram" level="4">officiis humanitatis,23.</l>
    <l n="49" type="diagram" level="4">pietate,24.</l>
  </main_text>
