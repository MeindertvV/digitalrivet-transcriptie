  <running_head>DE CRVCE</running_head>
  <main_text>
    <l n="1">tudinem, &amp; præsertim diuturni-</l>
    <l n="2">tatem pœnarum in eâ attendis.</l>
    <l n="3">Dicta hæc ipsa <i>Extrema pœna.</i> ut</l>
    <l n="4">in Apuleio de servo cruciando:</l>
    <l n="5">
      <i>Certum extrema pœna, quæ more</i>
    </l>
    <l n="6">
      <i>majorum in eum competit.</i> An &amp;</l>
    <l n="7">sic Arnobius? <i>Crucem mereatur</i>
    </l>
    <l n="8">
      <i>extremam, quisquis vobis dominis</i>
    </l>
    <l n="9">
      <i>supplicarit.</i> Quod tamen etiam</l>
    <l n="10">laxè, &amp; de peste aut pernicie capit</l>
    <l n="11">interpretari.</l>
    <l n="12" type="heading" level="2" para="true">CAP. II.</l>
    <l n="13" type="heading" level="2" para="true">
      <i>Duplex figendi Modus, Vulgaris</i>
    </l>
    <l n="14" type="heading" level="2">
      <i>&amp; Rarus. In illo Flagellatio ex</i>
    </l>
    <l n="15" type="heading" level="2">
      <i>more semper anteivit.</i>
    </l>
    <l n="16" para="true">SEd sævi fœdiqueque quid in hoc</l>
    <l n="17">supplicio fuerit, Modus ipse</l>
    <l n="18">dixerit: quem graphicè imus re-</l>
    <l n="19">præsentatum. Ut magis possit;</l>
    <l n="20">partimur, &amp; duplicem eum fa-</l>
    <l n="21">cimus: <i>Vulgarem, &amp; Rarum.</i>
    </l>
    <l n="22">Illum, <i>qui receptissimus, &amp; quo</i>
    </l>
    <l n="23">
      <i>vulgo</i>
    </l>
