  <page_number>135</page_number>
  <running_head>LIBER TERTIVS.</running_head>
  <main_text>
    <l n="1" para="true">
      <i>Vite capistratas cogebat ad esse-</i>
    </l>
    <l n="2">
      <i>da tigres,</i>
    </l>
    <l n="3">
      <i>Intrabat duplicem quà temo race-</i>
    </l>
    <l n="4">
      <i>mifer arcum.</i>
    </l>
    <l n="5" para="true">Denique cum descriptione Dio-</l>
    <l n="6">nysii mihi convenire videtur exa-</l>
    <l n="7">mussim. Da Furcam istam pau-</l>
    <l n="8">latim divaricantem; ab humeris</l>
    <l n="9">per pectus, &amp; inde manus veniat;</l>
    <l n="10">est illud ipsum lignum quod de-</l>
    <l n="11">scripsit. Jam Plauti Carbona-</l>
    <l n="12">rium, quò nisi huc referas? Ecce</l>
    <l n="13">qui lignarios fasces aut carbonum</l>
    <l n="14">faccellos hodieque ferunt, furcam</l>
    <l n="15">jungunt. cujus caput cum ex-</l>
    <l n="16">stantiâ aliquâ bacillorum à ter-</l>
    <l n="17">go est; longiores duo fines di-</l>
    <l n="18">versi per pectus descendunt, &amp;</l>
    <l n="19">manu utrâque ( quasi ad con-</l>
    <l n="20">tranixum ) sustentantur. Atqui</l>
    <l n="21">inquies, manus hîc non in alto</l>
    <l n="22">expansæ. Fateor non in alto,</l>
    <l n="23">expansæ tamen : &amp; cùm funi-</l>
    <l n="24">bus traherentur, ligatis ad extre-mas</l>
    <l n="25" type="foot" para="true">Injessi remota.</l>
  </main_text>
  <marginalia>
    <note side="right" at="Fateor non in" line_from="22" line_to="22">Injessi</note>
    <note side="right" at="Fateor non in" line_from="22" line_to="22">remo-ta.</note>
  </marginalia>
