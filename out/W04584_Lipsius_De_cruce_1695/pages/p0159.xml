  <running_head>LIBER TERTIVS.</running_head>
  <main_text>
    <l n="1" type="heading" level="1" caput="6" para="true">CAP. VI.</l>
    <l n="2" type="heading" level="2" para="true">Ratio suspendendi per singulas illas</l>
    <l n="3" type="heading" level="2">formas expofita, atque etiam ocu-</l>
    <l n="4" type="heading" level="2">lis propofita.</l>
    <l n="5" para="true">TRes fententias fuper Furcæ</l>
    <l n="6">formâ habes : tu elige : etsi</l>
    <l n="7">nos ad ultimam vides proclina-</l>
    <l n="8">tos. Quomodo autem nunc Su-</l>
    <l n="9">spensio? Pro formis distinguenda</l>
    <l n="10">est. Si prima placet, res facilis.</l>
    <l n="11">in trunco abscifo, in paxillo in-</l>
    <l n="12">fixo, imò in sissurâ superne factâ,</l>
    <l n="13">potuit firmiter appendi. Ima-</l>
    <l n="14">ginem (oculorum enim magis</l>
    <l n="15">res quàm verborum est) in-</l>
    <l n="16">frà habes. Si altera, tùm sic</l>
    <l n="17">censeo, ductos quidem cum</l>
    <l n="18">duplici ligno ad Crucem, sed</l>
    <l n="19">non cum utroque in eam actos.</l>
    <l n="20">Quod ante pectus, depositum</l>
    <l n="21">putem: manus fixas in alte-</l>
    <l n="22">ro, atque id ipsum in trunco,</l>
    <l n="23">paxillo, sissurâ (ut priùs) firma-</l>
    <l n="24">tum.</l>
  </main_text>
  <marginalia>
    <note side="right" at="Si prima placet," line_from="10" line_to="10">In prima Furcæ</note>
    <note side="right" at="in trunco abscifo," line_from="11" line_to="11">suspensio.</note>
    <note side="right" at="Si altera, tùm" line_from="16" line_to="16">In secunda.</note>
