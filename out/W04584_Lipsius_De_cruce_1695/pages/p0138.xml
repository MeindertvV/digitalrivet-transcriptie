  <main_text>
    <l n="1" type="heading" level="1" para="true">IVSTI LIPSII</l>
    <l n="2" type="heading" level="1">DE CRVCE</l>
    <l n="3" type="heading" level="1">LIBER III.</l>
    <l n="4" type="heading" level="2" caput="1" para="true">CAPVT I.</l>
    <l n="5" type="heading" level="3" para="true">Transitiò ad Rarum figendi Mo-</l>
    <l n="6" type="heading" level="3">dum. Furca divisa, &amp; hîc de</l>
    <l n="7" type="heading" level="3">Ignominiosâ dictum.</l>
    <l n="8" para="true">ABunde, quæ ad <i>Vulgarem</i>
    </l>
    <l n="9">crucifigendi modum, di-</l>
    <l n="10">ximus : <i>Rarus</i> supereft,</l>
    <l n="11">quem ipsum pari curâ imus ex-</l>
    <l n="12">punctum. Eum suprà descripsi-</l>
    <l n="13">mus (&amp; vox præfert) <i>sepositum</i>,</l>
    <l n="14">&amp; minùs in assiduo usu. Seposi-</l>
    <l n="15">tum ævo, Inusitatum vel <i>Sche-</i>
    </l>
    <l n="16">
      <i>mate</i> vel <i>Fine</i>. De his tribus ordi-</l>
    <l n="17">ne &amp; partitè dicam (juvat in his</l>
    <l n="18">talibus) &amp; in lucem fortasse pro-</l>
    <l n="19">traham, quæ usque adhuc pa-</l>
    <l n="20">rum claro oculo confpecta. Ævo</l>
    <l n="21">seposita <i>Furca</i> est: olim quidem</l>
    <l n="22">in creberrimo usu, sed quæ pau-</l>
    <l n="23">latim</l>
  </main_text>
  <marginalia>
    <note side="left" at="Eum suprà descripsimus" line_from="12" line_to="12">Quid rarus modus? Is divisus.</note>
  </marginalia>
</page>
