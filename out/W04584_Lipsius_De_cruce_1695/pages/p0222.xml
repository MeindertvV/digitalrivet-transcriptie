  <page_number>190</page_number>
  <running_head>NOTÆ AD LIB. I.</running_head>
  <main_text>
    <l n="1" para="true">Athenæus recitat lib. xii. sed</l>
    <l n="2">utrùm de hac nostrâ in cruce su-</l>
    <l n="3">spensione, an de aliâ in trabe acci-</l>
    <l n="4">pimus ? in trabe, inquam, ad</l>
    <l n="5">verberandum flagellandumque.</l>
    <l n="6">quem morem Græcis Latinisque</l>
    <l n="7">fuisse, comœdiæ atque alia do-</l>
    <l n="8">cent.</l>
    <l n="9" para="true">Pag. 15. lin. 12. &amp; 13. <i>Alio-</i>
    </l>
    <l n="10">
      <i>rum inanes logos.</i>] Ita verè, inanes.</l>
    <l n="11">Nam Alciati quale est? Ait <i>Hi-</i>
    </l>
    <l n="12">
      <i>stiæum Milesium</i> intelligi, <i>quem</i>
    </l>
    <l n="13">
      <i>Sardibus prapositum Artaphernes</i>
    </l>
    <l n="14">
      <i>&amp; Harpagus cruci fixerunt, capite</i>
    </l>
    <l n="15">
      <i>desecto &amp; ad regem misso.</i> Ita He-</l>
    <l n="16">rodotus, inquit, libro sexto.</l>
    <l n="17">Quod verum est: sed quid Hi-</l>
    <l n="18">stiæo, cum Achæo? Respondet,</l>
    <l n="19">
      <i>ideò sic vocari à poëtâ, quia Histiæus</i>
    </l>
    <l n="20">
      <i>Milesius fuit, Milesii coloni Ionum,</i>
    </l>
    <l n="21">
      <i>Iones Achæi. Ergo à patria,</i>
    </l>
    <l n="22">
      <i>Achæus.</i> Quis color in hoc ser-</l>
    <l n="23">mone? Sed nec amicum nostrum</l>
    <l n="24">audio sine auctore scribentem:</l>
    <l n="25">
      <i>Achæum intelligi Lydiæ regem,</i>
    </l>
    <l n="26">
      <i>qui</i>
    </l>
  </main_text>
