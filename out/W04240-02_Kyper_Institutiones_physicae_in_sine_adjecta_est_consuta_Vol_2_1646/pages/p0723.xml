  <running_head>APOLOG. PLEMPII</running_head>
  <bottom_margin>
    <catchword>aationes</catchword>
  </bottom_margin>
  <main_text>
    <l n="1">concesía, ita progredior.</l>
    <l n="2" para="true">
      <i>Sola constitutio partium naturalis vel</i>
    </l>
    <l n="3">
      <i>præternaturalis immediate actionem</i>
    </l>
    <l n="4">
      <i>in animali edere potest. Omne sym-</i>
    </l>
    <l n="5">
      <i>ptoma proficiscitur ab eo in animali</i>
    </l>
    <l n="6">
      <i>quod actionem immediate edere po-</i>
    </l>
    <l n="7">
      <i>test. Ergo sola constitutio partium</i>
    </l>
    <l n="8">
      <i>naturalis vel præternaturalis imme-</i>
    </l>
    <l n="9">
      <i>diate symptoma edere potest,</i>
    </l>
    <l n="10">
      <i>At symptoma non procedit à constitu-</i>
    </l>
    <l n="11">
      <i>tione partium naturali.</i>
    </l>
    <l n="12" para="true">
      <i>Ergo omne symptoma procedit à consti-</i>
    </l>
    <l n="13">
      <i>tutione partium præternaturali. Hæc</i>
    </l>
    <l n="14">
      <i>autem reciproce est morbus. Ergo om-</i>
    </l>
    <l n="15">
      <i>ne symptoma proficiscitur à morbo.</i>
    </l>
    <l n="16" para="true">Prima propositio confirmatur: quia</l>
    <l n="17">Omnis in animali actio proficiscitur</l>
    <l n="18">ab ejus anima, per instrumentum or-</l>
    <l n="19">ganicum; &amp; quidem cum id organum</l>
    <l n="20">se habet debite fit actio naturæ ejus</l>
    <l n="21">convenienter, adeoque bene: &amp; cum se</l>
    <l n="22">habet male, neque actionem conve-</l>
    <l n="23">nienter edere potest. Minor vero ex</l>
    <l n="24">priùs probato argumento desumpta</l>
    <l n="25">est. Sequitur ergo conclusio, &amp; sequun-</l>
    <l n="26">tur pariter quæcunque necessaria illa-</l>
    <l n="27">tione ex ea deduximus.</l>
    <l n="28" para="true">Plempius solam majorem hanc in</l>
    <l n="29">dubium vocat, atque tum in cit. loco</l>
    <l n="30">ex fund. tum in Pseud-Apolog. judicat</l>
    <l n="31">actiones</l>
  </main_text>
