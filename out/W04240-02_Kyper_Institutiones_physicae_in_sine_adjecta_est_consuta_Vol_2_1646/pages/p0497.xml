  <running_head>PHYSICARUM LIB.VIII.</running_head>
  <bottom_margin>
    <signature>X 4</signature>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">§. 3. Hic rursus quæritur: <i>An cum</i>
    </l>
    <l n="2">
      <i>varii sint sensus interni operationibus distincti,</i>
    </l>
    <l n="3">
      <i>varia etiam cerebri partes ad ope-</i>
    </l>
    <l n="4">
      <i>rationum istarum commodum exercitium</i>
    </l>
    <l n="5">
      <i>a natura ordinata sint?</i> Arabes anterio-</l>
    <l n="6">rem cerebri partem sensui communi,</l>
    <l n="7">mediam phantasiæ, &amp; posticam memoriæ</l>
    <l n="8">adjudicant. Græci autem</l>
    <l n="9">Medici &amp; cum iis recentiores non pauci</l>
    <l n="10">putant ex diversa temperie cerebri il-</l>
    <l n="11">las operationes procedere. Ego neu-</l>
    <l n="12">tram sententiam firmis rationibus</l>
    <l n="13">suffultam esse arbitror, attamen non</l>
    <l n="14">judico improbabilem eorum senten-</l>
    <l n="15">tiam, qui diversas cerebri partes diver-</l>
    <l n="16">sis illis operationibus attribuunt.Nam</l>
    <l n="17">quoniam illæ operationes non solum</l>
    <l n="18">diversæ, sed ita variantes sunt, ut sub</l>
    <l n="19">eadem materiali habitudine commode</l>
    <l n="20">exerceri nequeant, videtur necessum</l>
    <l n="21">esse, ut diversa organa sint constituta,</l>
    <l n="22">attamen conspirantia, sicut ipsæ ope-</l>
    <l n="23">rationes istorum sensuum sibi subordi-</l>
    <l n="24">natæ sunt. Atque rem ita se habere div-</l>
    <l n="25">ersarum partium cerebri constitutio</l>
    <l n="26">arguere videtur. Sed tamen ventri-</l>
    <l n="27">culos cerebri eum usum obtinere non</l>
    <l n="28">existimo, cum &amp; aperti sint, &amp; sic spi-</l>
    <l n="29">ritibus exitum concedant, &amp; plerum-</l>
    <l n="30">que excrementitiis humoribus imbuti</l>
    <l n="31">adver-</l>
  </main_text>
