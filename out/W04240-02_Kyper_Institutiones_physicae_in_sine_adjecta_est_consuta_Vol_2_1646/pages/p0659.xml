  <running_head>Apolog. Plempii</running_head>
  <main_text>
    <l n="1">nunc monstrare. Quantum vero intel-</l>
    <l n="2">ligere poßum 1.1. fund. c. 3. duas pro</l>
    <l n="3">sua sententia adducit rationes. Harum</l>
    <l n="4">prima in Syllogismum redacta talis est:</l>
    <l n="5" para="true">
      <i>Cuicunque conveniunt omnes condi-</i>
    </l>
    <l n="6">
      <i>tiones objecti scientia, id est objectum</i>
    </l>
    <l n="7">
      <i>Medicina:</i>
    </l>
    <l n="8" para="true">
      <i>Sed corpori viventi conveniunt omnes</i>
    </l>
    <l n="9">
      <i>conditiones scientia.</i>
    </l>
    <l n="10" para="true">
      <i>Ergo corpus vivens est objectum Medi-</i>
    </l>
    <l n="11">
      <i>cina.</i>
    </l>
    <l n="12" para="true">Secunda ratio ipsius non tam directe</l>
    <l n="13">intendit probare corpus vivens esse</l>
    <l n="14">Medicinae objectum, quam quod Ve-</l>
    <l n="15">terinaria &amp; Agricultura sub Medicina</l>
    <l n="16">comprehendantur, ex quo probato</l>
    <l n="17">prius fluit: Ita vero in forma sonat.</l>
    <l n="18" para="true">
      <i>Quaecunque habent communia prae-ce-</i>
    </l>
    <l n="19">
      <i>pta, &amp; finem communem: illus com-</i>
    </l>
    <l n="20">
      <i>petit quoque commune nomen scien-</i>
    </l>
    <l n="21">
      <i>tia vel artis:</i>
    </l>
    <l n="22" para="true">
      <i>Sed Veterinaria &amp; Agricultura ha-</i>
    </l>
    <l n="23">
      <i>bent ista communia cum Medicina</i>
    </l>
    <l n="24">
      <i>humani corporis. Ergo.</i>
    </l>
    <l n="25" para="true">Praeter has tertiam quoque rationem</l>
    <l n="26">adfert in Pfeud-Apol. c.2. quae talis est,</l>
    <l n="27" para="true">
      <i>De quocunque Medicina praedicatur</i>
    </l>
    <l n="28">
      <i>tanquam superius de inferiore: illud</i>
    </l>
    <l n="29">
      <i>sub Medicina continetur.</i>
    </l>
    <l n="30" para="true">
      <i>At de Veterinaria &amp; Agricultura Me-</i>
    </l>
    <l n="31">
      <i>dicina</i>
    </l>
  </main_text>
