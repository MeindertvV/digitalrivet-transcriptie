  <main_text>
    <l n="1" para="true">pugnam descenderit, ab ordi-</l>
    <l n="2">naria legis Corneliæ pœnâ ex-</l>
    <l n="3">cusari ille poterit, qui crebris</l>
    <l n="4">adversarii injuriis ita exacer-</l>
    <l n="5">batus fuit, ut diutius collectam</l>
    <l n="6">iræ vim sustinere nequiverit.</l>
    <l n="7" type="heading" level="1" caput="18" para="true">CAP. XVIII.</l>
    <l n="8" type="heading" level="2" para="true">
      <i>Utrum æqualitas armorum sit</i>
    </l>
    <l n="9" type="heading" level="2">
      <i>necessaria?</i>
    </l>
    <l n="10" para="true">I-</l>
    <l n="11">Nter conditiones ad mode-</l>
    <l n="12">ramen inculpatæ tutelæ re-</l>
    <l n="13">quisitas, nonnulli inter juris-</l>
    <l n="14">consultos exigunt, ut defensio-</l>
    <l n="15">nis ad offensionem sit propor-</l>
    <l n="16">tio, adeoque eo modo, quo vis</l>
    <l n="17">infertur, eadem repellatur.</l>
    <l n="18" para="true">Unde etiam armorum æqua-</l>
    <l n="19">litatem maximopere spectari</l>
    <l n="20">volunt, ut defensio legitima</l>
    <l n="21">dicatur. Probabiliorem tamen</l>
    <l n="22">eam sententiam existimavero,</l>
    <l n="23">quæ non semper æqualia arma</l>
    <l n="24">desiderari, aut spectari, statuir.</l>
  </main_text>
