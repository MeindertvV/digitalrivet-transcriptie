  <main_text>
    <l n="1" para="true">
      <i>Duello extincto maximo, atque</i>
    </l>
    <l n="2">
      <i>internecatis hostibus.</i>
    </l>
    <l n="3">Et Capteiv. in Prolog. <i>---</i>
    </l>
    <l n="4">
      <i>Valete judices justissimi</i>
    </l>
    <l n="5">
      <i>Domi; bellique duellatores optimi.</i>
    </l>
    <l n="6" para="true">Quia tamen alibi Plautus,</l>
    <l n="7">
      <i>duellum,</i> non ad bellum, sed duo-</l>
    <l n="8">rum pugnam refert, contra aut</l>
    <l n="9">praeter belli formam dimican-</l>
    <l n="10">tium; quidni eadem vox idem,</l>
    <l n="11">quod singulare certamen, si-</l>
    <l n="12">gnificabit. Sic enim ille inAm-</l>
    <l n="13">phitruone. (Quamvis non</l>
    <l n="14">ignorem à quibusdam criticis</l>
    <l n="15">hos versus inter reos relatos.)</l>
    <l n="16" para="true">
      <i>Confimiles sunt adeo, ut utri af-</i>
    </l>
    <l n="17">
      <i>sim[?] nesciam: rixam tamen,</i>
    </l>
    <l n="18">
      <i>Ut poteft, dirimam. Amphitruo</i>
    </l>
    <l n="19">
      <i>noli Amphitruonem duello</i>
    </l>
    <l n="20">
      <i>perdere.</i>
    </l>
    <l n="21" para="true">
      <i>Linque collum precor. ---</i>
    </l>
    <l n="22" para="true">Malui, non sine auctoritate</l>
    <l n="23">scriptoris antiqui, vocem ho-</l>
    <l n="24">die usitatam, quaeque sine peri-</l>
    <l n="25">phrasi rem latis exptimit reti-</l>
    <l n="26">nere. Quae ut olim plerum-</l>
    <l n="27">que</l>
  </main_text>
