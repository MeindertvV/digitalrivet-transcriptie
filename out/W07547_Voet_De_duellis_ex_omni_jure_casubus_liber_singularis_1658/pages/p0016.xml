  <running_head>P. VOET</running_head>
  <bottom_margin>
    <catchword>Duello</catchword>
  </bottom_margin>
  <main_text>
    <l n="1">aut saltem non usitatam apud</l>
    <l n="2">classicos linguæ latinæ autores,</l>
    <l n="3">alium à recentioribus scriptori-</l>
    <l n="4">bus, isti vocabulo additum usú</l>
    <l n="5">censet[?], quam quidem par erat.</l>
    <l n="6" para="true">Hinc etiam abstinendo à voce</l>
    <l n="7">duelli, maluit rem exprimere</l>
    <l n="8">nominibus <i>singularis certaminis.</i>
    </l>
    <l n="9" para="true">Quod institutum quamvis non</l>
    <l n="10">improbandum, sic nec adversæ</l>
    <l n="11">sententiæ ratio negligenda.</l>
    <l n="12" para="true">Fateor quidem usitatissime <i>du-</i>
    </l>
    <l n="13">
      <i>elli</i> nomine antiquitus bellum</l>
    <l n="14">fuisse designatum, quia <i>bellum</i>
    </l>
    <l n="15">
      <i>à duello;</i>(non quod minime <i>bel-</i>
    </l>
    <l n="16">
      <i>lum,</i> ut nonnulli perperam exi-</l>
    <l n="17">stumabat, quos reprehendit E-</l>
    <l n="18">ruditiss. Vossius) etiam bellum</l>
    <l n="19">ubique fere significatum fuisse</l>
    <l n="20">duelli vocabulo: ut apud Fe-</l>
    <l n="21">stum, Varronem, Lucretium a-</l>
    <l n="22">liosque. Imprimis apud Plau-</l>
    <l n="23">tum, cujus aliquot loca hic</l>
    <l n="24">solum recensebo: <i>Victores victis</i>
    </l>
    <l n="25">
      <i>hostibus legiones reveniunt domum.</i>
    </l>
  </main_text>
