  <running_head>P. VOET</running_head>
  <bottom_margin>
    <catchword>Et</catchword>
  </bottom_margin>
  <main_text>
    <l n="1">lucernæ furi non jure oculum</l>
    <l n="2">effodisse. Utmulto minùs licu-</l>
    <l n="3">erit eundem propter ereptam</l>
    <l n="4">lucernam occidere. 4. Cùm</l>
    <l n="5">passim in legibus mentio tute-læ</l>
    <l n="6">corporis &amp; defensionis, si ei</l>
    <l n="7">accedat aggressoris occisio,fru-</l>
    <l n="8">stra quispiam ad solam bono-</l>
    <l n="9">rum id traxerit defensionem.</l>
    <l n="10">Quinimo anxiè &amp; accurate ci-</l>
    <l n="11">viles leges distinguunt circa</l>
    <l n="12">furem, utrum eundem occide-</l>
    <l n="13">re liceat, nec ne? Cum tamen</l>
    <l n="14">certissimum sit, quemcunque</l>
    <l n="15">furem venire animo furandi,</l>
    <l n="16">id est bona nostra auferendi. Aut</l>
    <l n="17">si propter solam bonorum de-</l>
    <l n="18">fensionem aut ablationem oc-</l>
    <l n="19">cidere fas esset, omnem indi-</l>
    <l n="20">stinctè furem occidere liceret.</l>
    <l n="21">Verùm tantùm nocturnum</l>
    <l n="22">furem necare fas erat, quod</l>
    <l n="23">nesciatur, an venerit animo</l>
    <l n="24">furandi, an etiam occidendi.</l>
    <l n="25">Ut lex 12. Tabularum, sese</l>
    <l n="26">fundet in corporis defensione. Et</l>
  </main_text>
