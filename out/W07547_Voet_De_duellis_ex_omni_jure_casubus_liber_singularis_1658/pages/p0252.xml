  <main_text>
    <l n="1">rumque deficere. Et certe nisi</l>
    <l n="2">quisque certam spem victoriæ</l>
    <l n="3">concepisset, non ita facile ad</l>
    <l n="4">certamen descenderet. Exem-</l>
    <l n="5">plo sit illud Cæcilii Metelli,</l>
    <l n="6">(apud Plutarchum in Apo-</l>
    <l n="7">pthegm.) munito loco exerci-</l>
    <l n="8">tum admovere volentis. Cum</l>
    <l n="9">enim ei centurio dixisser[?], si so-</l>
    <l n="10">lum decem viros perdidisser[?],</l>
    <l n="11">se locum esse capturum, eum</l>
    <l n="12">interrogavit, num unus ex illis</l>
    <l n="13">decem esse vellet. Ad quam</l>
    <l n="14">interrogationem silentio o-</l>
    <l n="15">stendit, se vitam periculo ex-</l>
    <l n="16">ponere noluisse. Ita si duella-</l>
    <l n="17">tores judicarent sibi imminere</l>
    <l n="18">grande periculum, nec victoria</l>
    <l n="19">sibi pollicerentur, non adeo li-</l>
    <l n="20">bere provocarent ad certamen,</l>
    <l n="21">meticulosis in eo pares, &amp; ipsi</l>
    <l n="22">meticulosi.</l>
  </main_text>
