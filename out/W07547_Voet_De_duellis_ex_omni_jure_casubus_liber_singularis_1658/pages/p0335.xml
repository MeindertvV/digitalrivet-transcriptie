  <main_text>
    <l n="1">filium hoc fuit Theodorici.</l>
    <l n="2">Gothorum regis. <i>Illud, inquit,</i>
    </l>
    <l n="3">
      <i>præterea vos credimus admonendos,</i>
    </l>
    <l n="4">
      <i>ut non in vos, sed in hostem sævire</i>
    </l>
    <l n="5">
      <i>cupiatis. Et post: Imitamini certe</i>
    </l>
    <l n="6">
      <i>Gothos nostros, qui foris prælia, in-</i>
    </l>
    <l n="7">
      <i>tus norunt exercere modestiam.</i>
    </l>
    <l n="8" para="true">Ante Theodoricum ejus</l>
    <l n="9">moniti illustre exemplum sug-</l>
    <l n="10">gessit nobis Caesar de bello</l>
    <l n="11">Gallico.</l>
    <l n="12" para="true">
      <i>Unde audacter loquitur Massa;</i>
    </l>
    <l n="13">
      <i>&amp; ad magistratus autem, &amp; Prin-</i>
    </l>
    <l n="14">
      <i>cipes spectat vindicare civium in-</i>
    </l>
    <l n="15">
      <i>jurias, præsertim eorum fidem im-</i>
    </l>
    <l n="16">
      <i>plorantium. Quod nisi faciat Prin-</i>
    </l>
    <l n="17">
      <i>ceps, est in culpâ: sive is, qui inju-</i>
    </l>
    <l n="18">
      <i>riam intulit, in ejus sit ditione, ac</i>
    </l>
    <l n="19">
      <i>potestate, sive sit externus.</i>
    </l>
    <l n="20" para="true">
      <i>Ergo, inquit, si Princeps, cujus</i>
    </l>
    <l n="21">
      <i>subditus est injuriam passus, con-</i>
    </l>
    <l n="22">
      <i>venienter requisitus non curet officii</i>
    </l>
    <l n="23">
      <i>sui partes interponere, tacite quo-</i>
    </l>
    <l n="24">
      <i>dammodo significans sibi placere, ut</i>
    </l>
    <l n="25">
      <i>inter se armis decernant, is quidem</i>
    </l>
    <l n="26">
      <i>jam non amplius Princeps vocandus</i>
    </l>
  </main_text>
