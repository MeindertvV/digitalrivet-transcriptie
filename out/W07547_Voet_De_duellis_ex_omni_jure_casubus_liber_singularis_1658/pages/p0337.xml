  <running_head>De Duellis.</running_head>
  <bottom_margin>
    <catchword>quis</catchword>
  </bottom_margin>
  <main_text>
    <l n="1">nomine quærelam sæpe Phi-</l>
    <l n="2">lippo Macedoniæ regi detule-</l>
    <l n="3">rat, ut vidit, cum variis fru-</l>
    <l n="4">strationibus non sine risu dif-</l>
    <l n="5">ferri pœnam, insuper honore</l>
    <l n="6">ducatus ornari adversarium,</l>
    <l n="7">iram in Philippum vertit, &amp;</l>
    <l n="8">ultionem quam ab adversario</l>
    <l n="9">non poterat, à negligente ju-</l>
    <l n="10">dice exegit.</l>
    <l n="11" para="true">Et quia certius nihil est,</l>
    <l n="12">quam illecebram peccandi</l>
    <l n="13">spem esse Impunitatis, omnes-</l>
    <l n="14">que quia impuniti, peccant</l>
    <l n="15">crebrius, ideo etiam duellanti-</l>
    <l n="16">um eousque prorumpit auda-</l>
    <l n="17">cia, quod licentiosâ libertate</l>
    <l n="18">atque conniventiâ fere nutri-</l>
    <l n="19">tur. Quapropter meo judicio</l>
    <l n="20">non minimum erit remedium, si</l>
    <l n="21">rigide in duellatores animad-</l>
    <l n="22">vertatur, puta, vel pœnâ capi-</l>
    <l n="23">tis, vel infamiâ, exilio, inhabi-</l>
    <l n="24">litate ad munera &amp; bonorum</l>
    <l n="25">confiscatione. Quæ omnia apud</l>
    <l n="26">Moscovitas sancita fuerunt, si</l>
    <l n="27">quis</l>
  </main_text>
