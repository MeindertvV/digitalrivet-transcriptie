  <page_number>101</page_number>
  <running_head>De Duellis.</running_head>
  <bottom_margin>
    <catchword>Ita</catchword>
    <signature>E 3</signature>
  </bottom_margin>
  <main_text>
    <l n="1">prope Sylvamducis[?] initus, in-</l>
    <l n="2">ter Generosissimum Domi-</l>
    <l n="3">num de Breauté, &amp; Lecker-</l>
    <l n="4">beetjen, vix ausim affirmare.</l>
    <l n="5">Poterunt quibus vacat, hâc de</l>
    <l n="6">re consulere judicium Metera-</l>
    <l n="7">ni in suâ historiâ.</l>
    <l n="8" para="true">Tendunt itaque nonnun-</l>
    <l n="9">quam duella ad exercitus uti-</l>
    <l n="10">litatem quia victoria facilius</l>
    <l n="11">obtinetur, alacritas crescit &amp;</l>
    <l n="12">augetur, dum paucorum forti-</l>
    <l n="13">tudo, spem facit victorie. Quod</l>
    <l n="14">enim in singulis obtinuit,</l>
    <l n="15">idem in universis speratur,</l>
    <l n="16">servatâ quâ proportione. Ita so-</l>
    <l n="17">liti milites Christiani, in li-</l>
    <l n="18">mitaneis Hungariæ locis, cum</l>
    <l n="19">Turcarum militibus concur-</l>
    <l n="20">rere, facta duelli indictione, &amp;</l>
    <l n="21">genere armorum.</l>
    <l n="22" para="true">Quinimo nonnunquam dux</l>
    <l n="23">exercitus ab hostead[?] certamen</l>
    <l n="24">provocatus, se sistere poterit, &amp;</l>
    <l n="25">ut publico honori consulat, &amp;</l>
    <l n="26">ut parcat sanguini suorum.</l>
  </main_text>
  <marginalia>
    <note side="right" at="Poterunt quibus vacat," line_from="5" line_to="5">Meteran. libr. 22. p. mihi 444.</note>
    <note side="right" at="Quinimo nonnunquam dux" line_from="22" line_to="22">Xenoph. libr. Ex. ped. Cyri, p. mihi 100.</note>
