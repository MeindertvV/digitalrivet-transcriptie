  <running_head>P. VOET</running_head>
  <main_text>
    <l n="1">quod in omen tractum, eventu</l>
    <l n="2">fuit comprobatum. Licet au-</l>
    <l n="3">tem nonnunquam tali omini</l>
    <l n="4">respondeat effectus; numine</l>
    <l n="5">divino, negotium ita dirigen-</l>
    <l n="6">te: censerem tamen, nihil certi</l>
    <l n="7">ex animantium brutorum</l>
    <l n="8">commissionibus prædici posse,</l>
    <l n="9">aut debere, nisi quis spiritum</l>
    <l n="10">Propheticum se habere, certò</l>
    <l n="11">comprobet.</l>
    <l n="12" para="true">Non itidem, uti alii volunt,</l>
    <l n="13">ex eventu duellatorum, in</l>
    <l n="14">confpectu exercitus utrinque</l>
    <l n="15">dimicantium, quicquam de</l>
    <l n="16">belli aleâ ominari licebit, nisi</l>
    <l n="17">&amp; hic nos certos reddat, vel</l>
    <l n="18">divina quæ promissio, vel in-</l>
    <l n="19">fallibilis prædictio. Olim ta-</l>
    <l n="20">men hoc à Germanis observari</l>
    <l n="21">solitum fuisse, refert Annalium</l>
    <l n="22">Scriptor; qui adeo ad talia</l>
    <l n="23">omina attenti fuerunt, ut sæ-</l>
    <l n="24">pissime ante prælium aut pu-</l>
    <l n="25">gnam, cum quopiam ex ho-</l>
    <l n="26">stium numero congrederen-</l>
    <l n="27">tur,</l>
  </main_text>
