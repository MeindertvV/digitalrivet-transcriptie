  <main_text>
    <l n="1">ab imperatore exercitus assi-</l>
    <l n="2">gnatam deferere, turpe est &amp;</l>
    <l n="3">ignominiosum. Verum ag-</l>
    <l n="4">gressorem, quem te inferiorem</l>
    <l n="5">&amp; viribus &amp; armis novisti, ad</l>
    <l n="6">tempus vitasse, non in probro,</l>
    <l n="7">sed in laude positum erit. Ne</l>
    <l n="8">dicas, iniquam fore commuta-</l>
    <l n="9">tionem, si quis ob tutelam ho-</l>
    <l n="10">noris, qui ad mores probos</l>
    <l n="11">non spectat, nec reipublicae uti-</l>
    <l n="12">lis est, vitam adimat proximo.</l>
    <l n="13">Cùm ille quidem resarciri pos-</l>
    <l n="14">sit, haec vero nunquam repeti,</l>
    <l n="15">aut revocari.</l>
    <l n="16" type="heading" level="1" caput="23" para="true">CAP. XXIII.</l>
    <l n="17" type="heading" level="2" para="true">
      <i>Utrum mortem minantem liceat</i>
    </l>
    <l n="18" type="heading" level="2">
      <i>occidere?</i>
    </l>
    <l n="19" para="true">NOn semper ad justam de-</l>
    <l n="20">fensionem requiritur, ut</l>
    <l n="21">quis percutiat, aut inferat vul-</l>
    <l n="22">nus, verum quandoque sufficit</l>
    <l n="23">armorum metus, atque terror.</l>
  </main_text>
