  <main_text>
    <l n="1">modum &amp; mensuram debi-</l>
    <l n="2">tam reposcere.</l>
    <l n="3" para="true">Neque à jure civili, hacte-</l>
    <l n="4">nus allegato recedunt cano-</l>
    <l n="5">nes, aut antiqui aut novi,con-</l>
    <l n="6">ciliorum etiam anteriorum, &amp;</l>
    <l n="7">modernorum decreta, quibus</l>
    <l n="8">statutum, ut à duellis sub pœ-</l>
    <l n="9">nâ excommunicationis absti-</l>
    <l n="10">nendum sit.</l>
    <l n="11" para="true">Verùm progrediar ad ratio-</l>
    <l n="12">nes, partim ex jure divino,</l>
    <l n="13">partim aliunde desumptas. <i>1.</i>
    </l>
    <l n="14">Peccant enim qui singulare in-</l>
    <l n="15">eunt certamen in divinum</l>
    <l n="16">præceptum, in quantum inju-</l>
    <l n="17">rias illatas ipsimet ulciscuntur:</l>
    <l n="18">cum Deus peculiari jure sibi</l>
    <l n="19">vindictam reservaverit: <i>mihi,</i>
    </l>
    <l n="20">
      <i>inquit, vindicta est, &amp; ego retri-</i>
    </l>
    <l n="21">
      <i>buam.</i> Quæ verba à Moise ex-</l>
    <l n="22">pressa, reperit Apostolus Pa-</l>
    <l n="23">ulus, <i>non vosmet ipsos ulciscentes</i>
    </l>
    <l n="24">
      <i>carissimi: sed date locum iræ: scri-</i>
    </l>
    <l n="25">
      <i>ptum est enim: mihi vindicta est,</i>
    </l>
    <l n="26">
      <i>&amp; ego retribuam, dicit dominus.</i>
    </l>
  </main_text>
