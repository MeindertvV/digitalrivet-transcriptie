    <l n="6" type="heading" level="2" para="true">QUÆST. 4.</l>
    <l n="7" type="heading" level="3" para="true">
      <i>Utrum duellum licitum, quod inter</i>
    </l>
    <l n="8" type="heading" level="3">
      <i>rivales suscipitur?</i>
    </l>
    <l n="9" para="true">MULTOS reperiri vanos a-</l>
    <l n="10">matores, qui amoris</l>
    <l n="11">fortunam armis decidendam</l>
    <l n="12">esse censeant, comprobant, &amp;</l>
    <l n="13">superioris, &amp; nostri ævi exem-</l>
    <l n="14">pla. Neque alia videtur occa-</l>
    <l n="15">sio fabularum in Amadisiis,</l>
    <l n="16">quam torneamenta atque du-</l>
    <l n="17">ella varia, inter corrivales vir-</l>
    <l n="18">ginum adamatarum gratiâ su-</l>
    <l n="19">scepta. Unde quæsitum, utrum</l>
    <l n="20">talium generum certamina,</l>
    <l n="21">amoris æstu inita, ut licita to-</l>
    <l n="22">lerari possint, aut saltem excu-</l>
    <l n="23">sari? Respondeo, etiamsi nihil</l>
    <l n="24">sit vehementius cupidinis furore,</l>
  </main_text>
