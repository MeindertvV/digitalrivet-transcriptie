  <main_text>
    <l n="1">Neque veritas &amp; innocentia</l>
    <l n="2">adeo contumeliose accipere-</l>
    <l n="3">tur. Et nos forte non ea pate-</l>
    <l n="4">remur, quæ jam impune illi</l>
    <l n="5">inferunt, qui non aliter quam</l>
    <l n="6">mentiendo veritatem opprimi</l>
    <l n="7">posse censent. Si enim co-</l>
    <l n="8">nqueri liceret, &amp; quidni lice-</l>
    <l n="9">ret, quam non nuperrime non-</l>
    <l n="10">nulli Ventidii Baffi, calūniato-</l>
    <l n="11">res strenui, insulso &amp; illatino</l>
    <l n="12">stylo, in bonos perplurimos,</l>
    <l n="13">reipubl. Proceres, Reverendos</l>
    <l n="14">Ecclesiastas, Venerandū meū</l>
    <l n="15">Parentem, meq; supra modum</l>
    <l n="16">injurii fuere. Qui cū scribendi</l>
    <l n="17">genere superare non poterant,</l>
    <l n="18">terrae filii (Medicum quempi-</l>
    <l n="19">am Trajectinum defigno de</l>
    <l n="20">
      <i>litene</i>[?], <i>proculdio tumente</i> (potius</l>
    <l n="21">tamen <i>felle &amp; bile</i> dixisset) scri-</l>
    <l n="22">bentem, &amp; Crypsium quem</l>
    <l n="23">jur. doct. turpis Trapezitæ,</l>
    <l n="24">filium, infamis de jure Lom-</l>
    <l n="25">bardæ promachum) ad innu-</l>
    <l n="26">mera mendacia &amp; infrunita</l>
  </main_text>
