  <running_head>De Duellis.</running_head>
  <bottom_margin>
    <signature>C 3</signature>
  </bottom_margin>
  <main_text>
    <l n="1">committitur, &amp; pro rerum</l>
    <l n="2">controversiâ, &amp; pro dote allatâ</l>
    <l n="3">repetendâ.</l>
    <l n="4" para="true">Olim etiam inter Anglos</l>
    <l n="5">rationem hanc litium finienda-</l>
    <l n="6">rum per oblata duella receptam</l>
    <l n="7">fuisse, tradidit Bracton vetu-</l>
    <l n="8">stissimus legum Anglicanarum</l>
    <l n="9">scriptor; eorumque indicen-</l>
    <l n="10">dorum formam atque modum</l>
    <l n="11">unâ operâ describit. Nec etiam</l>
    <l n="12">in totum sublatum fuisse eo-</l>
    <l n="13">rum usum, suo tempore, desi-</l>
    <l n="14">gnavit Thomas Smithius. <i>In</i>
    </l>
    <l n="15">
      <i>desuetudinem, inquit, penitus</i>
    </l>
    <l n="16">
      <i>abivisse, nondum potui intelligere, &amp;</i>
    </l>
    <l n="17">
      <i>propterea emortuum non sentiet</i>
    </l>
    <l n="18">
      <i>esse, ubi quis flagitaverit.</i>
    </l>
    <l n="19" para="true">In Islandiâ lites forenses de</l>
    <l n="20">praediis, de hereditatibus, de</l>
    <l n="21">dotibus, nonnunquam duello</l>
    <l n="22">decisas fuisse, refert Arngrimus</l>
    <l n="23">Jonae. Sic ut bona controversa vict-</l>
    <l n="24">ori cederent, sine majore ja-</l>
    <l n="25">ctura bonorum victi. Et idem</l>
    <l n="26">etiam juris erat, sive quis ad</l>
    <l n="27">duel-</l>
  </main_text>
