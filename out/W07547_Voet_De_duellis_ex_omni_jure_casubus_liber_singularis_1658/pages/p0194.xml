  <main_text>
    <l n="1">pla illustrium virginum hoc</l>
    <l n="2">ipsum etiam probarunt, quæ-</l>
    <l n="3">vis potius esse ferenda, quam</l>
    <l n="4">ut sanguine stuprare volentis</l>
    <l n="5">manus polluantur. Exemplū</l>
    <l n="6">illustre virginis Christianæ</l>
    <l n="7">suggerunt Schutzii Chronica.</l>
    <l n="8">Ladislaus Poloniæ rex irru-</l>
    <l n="9">ptionem fecerat in Marchiam</l>
    <l n="10">Brandeburgensem. In quâ e-</l>
    <l n="11">ruptione monasterium quod-</l>
    <l n="12">dam capitur, ac simul virgo</l>
    <l n="13">nobilissima à Bojaro belli duce</l>
    <l n="14">intercipitur. Is formâ virginis</l>
    <l n="15">ac pulchritudine corporis,</l>
    <l n="16">quod pulcherrimum habebat</l>
    <l n="17">accensus, eam blanditiis at-</l>
    <l n="18">tentat, utque sui corporis fa-</l>
    <l n="19">ceret copiam, rogat. Quod</l>
    <l n="20">ut facilitate impetrare non</l>
    <l n="21">potuit, minis atque vio-</l>
    <l n="22">lentia eam aggreditur. Virgo,</l>
    <l n="23">cum se imparem homini fero-</l>
    <l n="24">cienti animadvertit, verbis ac</l>
    <l n="25">lacrymis eū obtestatur, ut sibi</l>
    <l n="26">parcat, addita promissione, se</l>
  </main_text>
