  <page_number>87</page_number>
  <running_head>De Duellis.</running_head>
  <main_text>
    <l n="1">Neque obstat illud Azorii Re-</l>
    <l n="2">us mortis juste damnari potest,</l>
    <l n="3">ut fame pereat, igitur etiam</l>
    <l n="4">non injuste damnatur ut cum</l>
    <l n="5">altero depugner. Resp. diver-</l>
    <l n="6">sam esse rationem. Qui fame</l>
    <l n="7">necatur, patitur, eique vitę sub-</l>
    <l n="8">sidia denegantur. Qui cum al-</l>
    <l n="9">tero congreditur agit, ictum</l>
    <l n="10">infert, salutem quærit per ne-</l>
    <l n="11">cem alterius, quem ut justitiæ</l>
    <l n="12">ministrum intuetur. Quod est</l>
    <l n="13">proxime &amp; immediate publi-</l>
    <l n="14">cum ministerium violare.</l>
    <l n="15" type="heading" level="1" caput="10" para="true">CAP. X.</l>
    <l n="16" type="heading" level="1" caput="10">
      <i>Quid statuendum de Duello utilita-</i>
    </l>
    <l n="17" type="heading" level="1" caput="10">
      <i>tis publica gratiâ suscepto?</i>
    </l>
    <l n="18" para="true">NOn aliter atque fortitudo</l>
    <l n="19">citra justitiam est culpa-</l>
    <l n="20">bilis, ita si cum judicio rectae</l>
    <l n="21">rationis sit conjuncta, laude</l>
    <l n="22">digna censebitur. Et quidem</l>
    <l n="23">ea quam maxime, quae patriae</l>
    <l n="24">amo-</l>
  </main_text>
