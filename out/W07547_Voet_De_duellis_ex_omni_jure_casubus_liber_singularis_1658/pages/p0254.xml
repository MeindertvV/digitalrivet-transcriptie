  <running_head>P. VOET</running_head>
  <bottom_margin>
    <catchword>De</catchword>
  </bottom_margin>
  <main_text>
    <l n="1">dissuadente congressum, hisce</l>
    <l n="2">ad eundem incitantibus. Cui</l>
    <l n="3">malo frequentato, eoque pe-</l>
    <l n="4">jori, quo frequentiori, ut ob-</l>
    <l n="5">viam eatur, rationes allegabo</l>
    <l n="6">non contemnendas, quibus ca-</l>
    <l n="7">lidioris temperamenti homi-</l>
    <l n="8">nes, in duella proni à pravo</l>
    <l n="9">proposito revocentur, &amp;</l>
    <l n="10">æquitati, longanimitati, atque ju-</l>
    <l n="11">stitiæ locum tribuant. Ubi</l>
    <l n="12">principio me operæ precium</l>
    <l n="13">facturum existimavi, si de-</l>
    <l n="14">monstravero omni jure talia</l>
    <l n="15">duella esse improbata. Ut</l>
    <l n="16">rejicienda illa Alciati distinc-</l>
    <l n="17">tio inter duella intra vel ex-</l>
    <l n="18">tra territorium Principis inita.</l>
    <l n="19">Cum si nullo jure sint recepta,</l>
    <l n="20">omne distinctionis adhibitæ</l>
    <l n="21">fundamentum evertatur. De-</l>
    <l n="22">inde si rationibus probavero, jura</l>
    <l n="23">non esse sine ratione ita condi-</l>
    <l n="24">ta. Denique si objectiones du-</l>
    <l n="25">ellantium, etiam speciosas sa-</l>
    <l n="26">tis, paucis removero.</l>
  </main_text>
