  <main_text>
    <l n="1">quid prædicant. Et ne ad an-</l>
    <l n="2">tiqua recurrā, patrum nostro-</l>
    <l n="3">rum memoriā ab Episcopo</l>
    <l n="4">Coloniensi tale editum specta-</l>
    <l n="5">culum; cum primitus Fœde-</l>
    <l n="6">ratæ Provinciæ Belgarum ex-</l>
    <l n="7">cusso Hispaniæ jugo, auspiciis</l>
    <l n="8">Wilhelmi Araufionensiū Prin-</l>
    <l n="9">cipis, sese in pristinam vindi-</l>
    <l n="10">carent libertatem. Volebat e-</l>
    <l n="11">nim seculo superiori experiri</l>
    <l n="12">Episcopus, qui Hispano fa-</l>
    <l n="13">vebat, uter victor esset futurus,</l>
    <l n="14">Hispanus, an Provinciæ Bel-</l>
    <l n="15">garum. Leoni itaque partes</l>
    <l n="16">Hispaniæ assignatæ, Tauro</l>
    <l n="17">Provinciarum Belgii. Quid</l>
    <l n="18">accidit, in principio cum Tau-</l>
    <l n="19">rus superior existeret ac me-</l>
    <l n="20">tueretur Leoni, mutatis viri-</l>
    <l n="21">bus, ut ita in Belgas malum</l>
    <l n="22">omen transferretur, Leoni</l>
    <l n="23">Belgium assignatum, Tauro</l>
    <l n="24">Hispania. Ast Leo ferociens,</l>
    <l n="25">resumptis viribus Taurum in-</l>
    <l n="26">vasit, ac subegit. Atque ita</l>
  </main_text>
