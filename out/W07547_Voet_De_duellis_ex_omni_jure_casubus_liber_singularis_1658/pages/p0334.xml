    <note side="left" at="Ut Cato senior" line_from="14" line_to="14">Plutarch. apopth. Roman. in Cato-ne.</note>
    <note side="left" at="A quo non" line_from="20" line_to="20">l. 2. 3. Cod. de Canon. largit. libr.10.</note>
