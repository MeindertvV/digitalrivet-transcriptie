  <main_text>
    <l n="1" para="true">Id quod Comicus olim in re-</l>
    <l n="2">medium suppeditavit.</l>
    <l n="3" para="true">
      <i>Quod si exquiratur, inquit, us-que ab</i>
    </l>
    <l n="4">
      <i>stirpe auctoritas.</i>
    </l>
    <l n="5" para="true">
      <i>Unde quicquid auditum dicant, nisi</i>
    </l>
    <l n="6">
      <i>id appareat,</i>
    </l>
    <l n="7">
      <i>Famigeratori res sit cum damno</i>
    </l>
    <l n="8">
      <i>&amp; malo.</i>
    </l>
    <l n="9" para="true">
      <i>Hoc ita si fiat, publico fiat bono.</i>
    </l>
    <l n="10" para="true">
      <i>Pauci sint faxim qui sciant quod</i>
    </l>
    <l n="11">
      <i>nesciunt,</i>
    </l>
    <l n="12">
      <i>Occlusioremque habeant stulti-</i>
    </l>
    <l n="13">
      <i>loquentiam.</i>
    </l>
    <l n="14" para="true">Et hoceft, quod spondent ad</l>
    <l n="15">evitamentum duellorum in</l>
    <l n="16">exercitu suis constitutionibus</l>
    <l n="17">Principes Brabantiæ: <i>se offenso</i>
    </l>
    <l n="18">
      <i>honoris reparationem curaturos.</i>
    </l>
    <l n="19">Idem quod constituerunt no-</l>
    <l n="20">stri proceres Militaribus con-</l>
    <l n="21">stitutionibus, ne quis impune</l>
    <l n="22">injuriam alteri illatam ferret,</l>
    <l n="23">quod ea res singulari certa-</l>
    <l n="24">mini occasionem suppeditaret.</l>
    <l n="25">Unde, qui alicui alapam, aut</l>
    <l n="26">colaphum impegit, ei etiam in</l>
  </main_text>
