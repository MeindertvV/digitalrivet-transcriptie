  <main_text>
    <l n="1" type="heading" level="1" para="true">OCTAVII MENINI IC. ODA IN ADVLATORES PONTIFICIS ROMANI.</l>
    <l n="2" type="heading" level="2" para="true">ADVLATORES AD PONTIFICEM.</l>
    <l n="3" para="true">
      <i>Pater</i> beate digna sat merentibus</l>
    <l n="4" para="true">
      <i>Quenam rependes premia?</i>
    </l>
    <l n="5" para="true">
      <i>Pro te pudoris cuncta frena rupi-mus</i>
    </l>
    <l n="6" para="true">
      <i>Et fronte perfricta nihil</i>
    </l>
    <l n="7" para="true">
      <i>Intactum, inausum liquimus, mendacio</i>
    </l>
    <l n="8" para="true">
      <i>Ut turpi pulsa veritas</i>
    </l>
    <l n="9" para="true">
      <i>Sinceritasque amabilis, nivea &amp; fides</i>
    </l>
    <l n="10" para="true">
      <i>Cogatur hinc facessere.</i>
    </l>
    <l n="11" para="true">
      <i>Nos nos locamus te supremo vertice</i>
    </l>
    <l n="12" para="true">
      <i>Cœlumque supra attollimus:</i>
    </l>
    <l n="13" para="true">
      <i>Nos te vocamus alterum Ioucm, tuis</i>
    </l>
    <l n="14" para="true">
      <i>Claudi, patere nutibus</i>
    </l>
    <l n="15" para="true">
      <i>Sedes Olympi dicimus; &amp; horrida</i>
    </l>
    <l n="16" para="true">
      <i>Nigrantis Orci limina.</i>
    </l>
    <l n="17" para="true">
      <i>Armamus ipsi ultricibus flammis</i>
    </l>
    <l n="18" para="true">
      <i>Tuam hanc fulgurantem dexteram,</i>
    </l>
    <l n="19" para="true">
      <i>Nec iam veremur astra cœlo dicere</i>
    </l>
    <l n="20" para="true">
      <i>Lapsura, ni tu fulcias.</i>
    </l>
    <l n="21" para="true">
      <i>Iam regna cuncta, quæ cadens Sol aspicit</i>
    </l>
    <l n="22" para="true">
      <i>Surgensque, tibi ascribimus;</i>
    </l>
    <l n="23" para="true">
      <i>Et quod coronis fulgeant nitentibus</i>
    </l>
    <l n="24" para="true">
      <i>Reges, Ducesque, &amp; ipsius</i>
    </l>
    <l n="25" para="true">
      <i>Quod sceptra gestent Imperi, totum hoc tui</i>
    </l>
    <l n="26" para="true">
      <i>Iuramus esse muneris.</i>
    </l>
    <l n="27" para="true">
      <i>Iam nostra cunctos limites modestia</i>
    </l>
    <l n="28" para="true">
      <i>Transcendit impudentia,</i>
    </l>
    <l n="29" para="true">
      <i>Dum mille lingua blandienti nomina</i>
    </l>
    <l n="30" para="true">
      <i>Tibi superba affingimus.</i>
    </l>
    <l n="31" para="true">
      <i>Hinc turba honores credula immensos tibi</i>
    </l>
    <l n="32" para="true">
      <i>Largitur, hinc vulgus stupet.</i>
    </l>
    <l n="33" para="true">
      <i>Quod si quis exstet altiori spiritu</i>
    </l>
    <l n="34" para="true">
      <i>Cui libera indignatio</i>
    </l>
    <l n="35" para="true">
      <i>Bilem tumentem suscitet fallacias</i>
    </l>
    <l n="36" para="true">
      <i>Qui tentet has refellere,</i>
    </l>
    <l n="37" para="true">
      <i>Plectroque fido veriora personet</i>
    </l>
    <l n="38" para="true">
      <i>Quam gratiora Curiæ,</i>
    </l>
    <l n="39" para="true">
      <i>In hunc venenis viperinis illita</i>
    </l>
    <l n="40" para="true">
      <i>Torquemus omnes spicula.</i>
    </l>
    <l n="41" para="true">
      <i>Nostri vocant hunc Menini mastigia</i>
    </l>
    <l n="42" para="true">
      <i>Cantu strepentes non suo,</i>
    </l>
  </main_text>
