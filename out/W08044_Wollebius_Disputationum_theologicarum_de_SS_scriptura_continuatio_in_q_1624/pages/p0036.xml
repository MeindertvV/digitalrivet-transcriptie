    <l n="1" type="heading" level="2" para="true">COROLLARIA.</l>
    <l n="2" para="true">I.</l>
    <l n="3" para="true">
      <i>Meritò damnatur illorum sententia, qui</i>
    </l>
    <l n="4">
      <i>Veteris Testaméti libros, velut ad Christia-</i>
    </l>
    <l n="5">
      <i>nismum impertinentes, reiecerunt.</i>
    </l>
    <l n="6" para="true">2.</l>
    <l n="7" para="true">
      <i>Nec absimilis huic errori est, moderno-</i>
    </l>
    <l n="8">
      <i>rum hæreticorum, opinio, qui Le-</i>
    </l>
    <l n="9">
      <i>gem Mosis à Christo corre-</i>
    </l>
    <l n="10">
      <i>ctam fuisse,</i>
    </l>
    <l n="11">
      <i>fin-gunt.</i>
    </l>
    <l n="12" para="true">FINIS.</l>
  </main_text>
