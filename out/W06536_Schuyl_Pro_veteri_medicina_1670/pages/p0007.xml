    <l n="1" type="heading" level="1" para="true">FLORENTIUS</l>
    <l n="2" type="heading" level="1">SCHUYL</l>
    <l n="3" type="heading" level="1">PRO</l>
    <l n="4" type="heading" level="1">VETERI MEDICINA.</l>
    <l n="5" para="true">Confutationem impudentissimi</l>
    <l n="6">Libelli justa extorsit indigna-</l>
    <l n="7">tio. Quis enim æquo animo</l>
    <l n="8">ferat, hominem nomine dunt-</l>
    <l n="9">axat &amp; professione Medicum, non</l>
    <l n="10">alia de causa, quàm quia Sylvius Practicam</l>
    <l n="11">suam candidè &amp; liberaliter Orbi</l>
    <l n="12">Literario impartivit, expressis verbis</l>
    <l n="13">editoque libello effutire, <i>sibi duntaxat</i>
    </l>
    <l n="14">
      <i>sordi esse Sylvium</i>, Veteranum Practicum,</l>
    <l n="15">
      <i>perstringere</i>? &amp; quidem tàm</l>
    <l n="16">contumeliosè, ut ipsum non pudeat,</l>
    <l n="17">Virum Clarissimum, &amp; de re Medica</l>
    <l n="18">optimè meritum vocitare <i>insignem er-</i>
    </l>
    <l n="19">
      <i>ronem</i>, nec <i>devium</i> modò, sed &amp;</l>
    <l n="20" type="foot" para="true">1. Pag. 4.</l>
    <l n="21" type="foot" para="true">2. Pag. 16.</l>
    <l n="22" type="foot" para="true">3. Pag. 65.</l>
  </main_text>
