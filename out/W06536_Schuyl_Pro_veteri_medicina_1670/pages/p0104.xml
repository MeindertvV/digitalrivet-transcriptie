    <l n="6">lentus conclusus est.</l>
    <l n="7" para="true">Deinde alius canis itidem viventis</l>
    <l n="8">abdomen eadem methodo aperui,</l>
    <l n="9">atque ductu bilario intestinali, qui cy-</l>
    <l n="10">stico &amp; hepatico communis est, in-</l>
    <l n="11">strumento compresso, eo modo,quem</l>
    <l n="12">figura exhibet, ut succus pancreaticus</l>
    <l n="13">solus prodiret, trium propemodum</l>
    <l n="14">horarum spatio collegimus succi aci-</l>
    <l n="15">do-austeri præterpropter ʒij. cujus</l>
    <l n="16">manifestus acor non gustus modò</l>
    <l n="17">probabat, sed &amp; illius cum calidiori</l>
    <l n="18">lacte permixtione, lac ita coagulaba-</l>
    <l n="19">tur, ut inde caseus fuerit efformatus:</l>
    <l n="20">manifesto experimento omninò aci-</l>
    <l n="21">dum in eo prævalere; nam licet sali</l>
    <l n="22">communi non parum acidi insit, uti &amp;</l>
