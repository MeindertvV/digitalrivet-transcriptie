  <page_number>22</page_number>
  <running_head>Fl. Schuyl</running_head>
  <main_text>
    <l n="1">
      <i>ergo acidus humor reliquos præcellens</i>
    </l>
    <l n="2">
      <i>maximè incommodus fuerit; si utique</i>
    </l>
    <l n="3">
      <i>dulcis, omnium commodissimus existit:</i>
    </l>
    <l n="4">
      <i>id quod si quis forinsecus quærens conse-</i>
    </l>
    <l n="5">
      <i>qui possit, is semper quod melius est con-</i>
    </l>
    <l n="6">
      <i>sequi queat. Optimum autem est quod</i>
    </l>
    <l n="7">
      <i>longissimè ab incommodo abest.</i> Idem</l>
    <l n="8">supra Text. xxxix. sedulò inculcat,</l>
    <l n="9">nempè <i>Facultatem esse, humorum sum-</i>
    </l>
    <l n="10">
      <i>mas vires ac robur nosse.</i> quod quidem,</l>
    <l n="11">ibidem docet, <i>ex manifestis forinsecus</i>
    </l>
    <l n="12">
      <i>condiscere oportere.</i>
    </l>
    <l n="13" para="true">Quemadmodum autem eos laudat,</l>
    <l n="14">qui acidum, salsum &amp; amarum appri-</l>
    <l n="15">mè norunt, sic etiam eos vehementer</l>
    <l n="16">perstringit ibid. Text. xxiii. <i>qui-</i>
    </l>
    <l n="17">
      <i>cunque hæc non considerantes non norunt.</i>
    </l>
    <l n="18">
      <i>quomodo enim, inquit, illi affectiones in</i>
    </l>
    <l n="19">
      <i>homine cognoscere possunt, ab unoquoque</i>
    </l>
    <l n="20">
      <i>enim afficitur &amp; alteratur homo, vel hoc</i>
    </l>
    <l n="21">
      <i>vel alio modo, &amp; ex his omnis vita, &amp;</i>
    </l>
    <l n="22">
      <i>sano, &amp; ex morbo convalescenti &amp; ægro-</i>
    </l>
    <l n="23">
      <i>to.</i> Sunt enim istæ potentiæ Sanitatis</l>
    <l n="24">&amp; Morborum non caussæ modò, sed</l>
    <l n="25">&amp; ipsa</l>
  </main_text>
  <notes />
</page>
