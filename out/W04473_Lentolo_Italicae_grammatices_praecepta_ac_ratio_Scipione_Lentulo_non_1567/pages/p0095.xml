    <l n="7">
      <i>Io E'ra stáro,</i> Ego fueram.</l>
    <l n="8">
      <i>tu E'ri státo,</i> tu fueras.</l>
    <l n="9">
      <i>colúi Era státo</i> ille fuerat.</l>
    <l n="10">
      <i>Nói Erauámo státi.</i> Nos fueramus.</l>
    <l n="11">
      <i>vói Erauáte státi</i> vos fueratis.</l>
    <l n="12">
      <i>coloro E'rano státi</i> illi fuerant.</l>
    <l n="13" type="heading" level="2" para="true">Futurum.</l>
    <l n="14">
      <i>Io Saro, &amp; Fia</i> Ego ero.</l>
    <l n="15">
      <i>tu Sarái</i> tu eris.</l>
    <l n="16">
      <i>colúi Sarà, Fia, &amp; Fiè</i> ille erit.</l>
    <l n="17">
      <i>Nói Sarémo</i> Nos erimus.</l>
    <l n="18">
      <i>voi Saréte</i> vos eritis.</l>
    <l n="19">
      <i>coloro Saránno, &amp; Fiáno</i> illi erunt.</l>
    <l n="20" type="heading" level="2" para="true">Imperat. mod. Temp. præs.</l>
