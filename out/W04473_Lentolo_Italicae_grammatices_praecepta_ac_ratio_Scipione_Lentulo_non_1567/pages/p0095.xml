    <l n="1">
      <i>tu Fófti,</i> tu fuisti.</l>
    <l n="2">
      <i>colúi Fu,</i> ille fuit.</l>
    <l n="3">
      <i>Nói Fúmmo,</i> Nos fuimus.</l>
    <l n="4">
      <i>voi Fófti,</i> vos fuistis.</l>
    <l n="5">
      <i>colóro Fúrono, Fúron, Fúro,</i> illi fuerunt.</l>
