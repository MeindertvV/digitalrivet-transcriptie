  <running_head>BABYLONIS MAGNÆ.</running_head>
  <bottom_margin>
    <signature>Dd 3</signature>
    <catchword>vitate</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" type="heading" level="1" caput="8" para="true">DISSERTATIO</l>
    <l n="2" type="heading" level="1" caput="8">OCTAVA</l>
    <l n="3" para="true">
      <i>QUA</i>
    </l>
    <l n="4">
      <i>Hierarchiam, seu Clerum Ecclesiæ Romanæ dominantem</i>
    </l>
    <l n="5">
      <i>Babylonem Magnam esse, probatur Tertiò, quia</i>
    </l>
    <l n="6">
      <i>in Civitate Magna, Religiosa, in populum Magnum,</i>
    </l>
    <l n="7">
      <i>Christi nomen professum licet, Clero dominanti</i>
    </l>
    <l n="8">
      <i>parentem, septem collibus, totidémque</i>
    </l>
    <l n="9">
      <i>provinciis distinctum, multorúmque</i>
    </l>
    <l n="10">
      <i>Regum potentia suffultum, im-</i>
    </l>
    <l n="11">
      <i>perium obtinet.</i>
    </l>
    <l n="12" type="heading" level="2" para="true">SECTIONIBUS TRIBUS</l>
    <l n="13" type="heading" level="2">DISTINCTA.</l>
    <l n="14" para="true">Quarum <i>Prima</i> Civitatis Romanæ Religiosæ dominantis</l>
    <l n="15">magnitudinem; <i>Secunda</i>, subditos imperio</l>
    <l n="16">ejusdem parentes; <i>Tertia</i> Imperium</l>
    <l n="17">ipsum explicat.</l>
    <l n="18" type="heading" level="2" para="true">SECTIO PRIMA QUA</l>
    <l n="19" para="true">
      <i>Hierarchiam, seu Clerum Ecclesiæ Romanæ dominantis,</i>
    </l>
    <l n="20">
      <i>esse Magnam illam Civitatem, Religiosam,</i>
    </l>
    <l n="21">
      <i>Babylonicam asseritur.</i>
    </l>
    <l n="22" type="heading" level="2" para="true">BREVIARIUM.</l>
    <l n="23" para="true">I. <i>Character tertius Babylonis Magnæ est, quòd</i>
    </l>
    <l n="24">
      <i>in Civitate</i>
    </l>
  </main_text>
