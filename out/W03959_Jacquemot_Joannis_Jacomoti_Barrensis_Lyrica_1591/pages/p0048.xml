  <running_head>LYRICA.</running_head>
  <main_text>
    <l n="1" para="true">
      <i>Franciscus ex quo mollia turpiter</i>
    </l>
    <l n="2" para="true">
      <i>Euertit audax otia Guisius,</i>
    </l>
    <l n="3" para="true">
      <i>Bellique ciuilis sceleftus</i>
    </l>
    <l n="4" para="true">
      <i>Francigenas violauit author,</i>
    </l>
    <l n="5" para="true">
      <i>Regnique spretis ordinibus ferox</i>
    </l>
    <l n="6" para="true">
      <i>Edicta princeps regia subruit,</i>
    </l>
    <l n="7" para="true">
      <i>Cum matre cogens, heu! tenellum</i>
    </l>
    <l n="8" para="true">
      <i>Armasequi miseranda Regem:</i>
    </l>
    <l n="9" para="true">
      <i>O quàm superbo sœuit impetu!</i>
    </l>
    <l n="10" para="true">
      <i>O quanta Gallis damna tulit furens?</i>
    </l>
    <l n="11" para="true">
      <i>Quantosque funestus per vrbes</i>
    </l>
    <l n="12" para="true">
      <i>Francigenas dedit ille motus!</i>
    </l>
    <l n="13" para="true">
      <i>Sic quum quietos diluuies fera</i>
    </l>
    <l n="14" para="true">
      <i>Irritat amnes, &amp; pecus &amp; domos,</i>
    </l>
    <l n="15" para="true">
      <i>Stirpesque raptas voluit una,</i>
    </l>
    <l n="16" para="true">
      <i>Murmure cuncta fremunt tremendo.</i>
    </l>
    <l n="17" para="true">
      <i>Sic inquieto nubilus Adria</i>
    </l>
    <l n="18" para="true">
      <i>Tollit procellas Africus horridas:</i>
    </l>
    <l n="19" para="true">
      <i>Nautasque per vastum vagantes</i>
    </l>
    <l n="20" para="true">
      <i>Exagitat violentus æquor.</i>
    </l>
    <l n="21" para="true">
      <i>Sic dira sœuit bellua, quum fames</i>
    </l>
    <l n="22" para="true">
      <i>Vasana torquet, dentéque feruido</i>
    </l>
    <l n="23" para="true">
      <i>Irata prædam quum repertam,</i>
    </l>
    <l n="24" para="true">
      <i>Lanigerósve greges trucidat.</i>
    </l>
    <l n="25" para="true">
      <i>Hinc arua passim Gallica sanguine</i>
    </l>
    <l n="26" para="true">
      <i>Madent refuso, prædáque tristibus</i>
    </l>
    <l n="27" para="true">
      <i>Feris per agros funeratæ</i>
    </l>
    <l n="28" para="true">
      <i>Francigenûm iacuere turmæ.</i>
    </l>
