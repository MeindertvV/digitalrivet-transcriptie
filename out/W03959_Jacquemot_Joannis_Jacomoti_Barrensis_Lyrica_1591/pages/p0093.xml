  <main_text>
    <l n="1" para="true">
      <i>Et Franca Rhœtis signa sequentibus</i>
    </l>
    <l n="2" para="true">
      <i>Repente per fines Sabaudum</i>
    </l>
    <l n="3" para="true">
      <i>Bella geris metuendus hosti.</i>
    </l>
    <l n="4" para="true">
      <i>Atque alta rumpens valla Ripariæ</i>
    </l>
    <l n="5" para="true">
      <i>Ignota nostris vincula mœnibus</i>
    </l>
    <l n="6" para="true">
      <i>Naues minatas, &amp; Lemanno</i>
    </l>
    <l n="7" para="true">
      <i>Seruitium crepitante flamma</i>
    </l>
    <l n="8" para="true">
      <i>Excindis: &amp; spes prouidus hostium</i>
    </l>
    <l n="9" para="true">
      <i>Vanas retundis victor, &amp; impetum:</i>
    </l>
    <l n="10" para="true">
      <i>Cogisque vexatos cruento</i>
    </l>
    <l n="11" para="true">
      <i>Allobroges trepidare bello.</i>
    </l>
    <l n="12" para="true">
      <i>Et plura nostra commoda protinus</i>
    </l>
    <l n="13" para="true">
      <i>Vrbi tulisses: sed metuens sibi</i>
    </l>
    <l n="14" para="true">
      <i>Te fœderata Gentis omnes</i>
    </l>
    <l n="15" para="true">
      <i>Rex voluit celerare turmas.</i>
    </l>
    <l n="16" para="true">
      <i>Nunc te reuersum post varios videt</i>
    </l>
    <l n="17" para="true">
      <i>Geneua casus lætior, &amp; tuo</i>
    </l>
    <l n="18" para="true">
      <i>Sentit periclo te redemptas</i>
    </l>
    <l n="19" para="true">
      <i>Solicitum reuocare paces.</i>
    </l>
    <l n="20" para="true">
      <i>Ducis Sabaudi quas violentia</i>
    </l>
    <l n="21" para="true">
      <i>Dudum reuulsit: dum cupidè suos</i>
    </l>
    <l n="22" para="true">
      <i>Augere fines, atque nostra</i>
    </l>
    <l n="23" para="true">
      <i>Colla iugo meditatur ardens</i>
    </l>
    <l n="24" para="true">
      <i>Vrgere tristi: dum iuuat impias</i>
    </l>
    <l n="25" para="true">
      <i>Rebelliones, atque nefarios</i>
    </l>
    <l n="26" para="true">
      <i>Turbata Gallorum per arua</i>
    </l>
    <l n="27" para="true">
      <i>Gaudet atrox renouare motus.</i>
    </l>
    <l n="28" para="true">
      <i>Quo tendis audax? publica desine</i>
    </l>
    <l n="29" para="true">
      <i>Tandem</i>
    </l>
