  <running_head>I. IACOMOTI</running_head>
  <main_text>
    <l n="1" para="true">
      <i>Raptásque stupris polluit insolens</i>
    </l>
    <l n="2">
      <i>Hostis maritas, virginésque:</i>
    </l>
    <l n="3">
      <i>Non scelere abstinuit nefando.</i>
    </l>
    <l n="4" para="true">
      <i>Quod magna summi dextera vindicis</i>
    </l>
    <l n="5">
      <i>Frata prisco tempore punijt</i>
    </l>
    <l n="6">
      <i>Quum vertit infames Sodomas</i>
    </l>
    <l n="7">
      <i>Æthereum iaculata sulphur.</i>
    </l>
    <l n="8" para="true">
      <i>Quas pleniori copia fuderat</i>
    </l>
    <l n="9">
      <i>Per arua cornu largáque faustitas</i>
    </l>
    <l n="10">
      <i>Fruges &amp; vndantis Lyæi</i>
    </l>
    <l n="11">
      <i>Dona ferox sibi vindicauit.</i>
    </l>
    <l n="12" para="true">
      <i>Boum labores perdidit &amp; sata</i>
    </l>
    <l n="13">
      <i>Flammisque pagos subiciens vagis</i>
    </l>
    <l n="14">
      <i>Incendit &amp; semen paratum</i>
    </l>
    <l n="15">
      <i>Credere humo vetuit feraci.</i>
    </l>
    <l n="16" para="true">
      <i>Quæ dixit atrox, Versoui simul</i>
    </l>
    <l n="17">
      <i>Vallauit arces: tuta nec amplius</i>
    </l>
    <l n="18">
      <i>Nauis per obsessi Lemanni</i>
    </l>
    <l n="19">
      <i>Cærule as volitauit vndas!</i>
    </l>
    <l n="20" para="true">
      <i>Geneua vitias esurie manus</i>
    </l>
    <l n="21">
      <i>Nunc tendet exspes: libera nunc iugo</i>
    </l>
    <l n="22">
      <i>Subdet Sabaudo colla, nostris</i>
    </l>
    <l n="23">
      <i>Seruiet imperiys subasta.</i>
    </l>
    <l n="24" para="true">
      <i>Cœli sed alto vertice qui sedet</i>
    </l>
    <l n="25">
      <i>Orbémque iustis arbitriis regit</i>
    </l>
    <l n="26">
      <i>Iras Tyranni tam cruentas</i>
    </l>
    <l n="27">
      <i>Spésq; trucésque minas repressit.</i>
    </l>
    <l n="28" para="true">
      <i>Quum rebus arctis impauidum tibi</i>
    </l>
    <l n="29">
      <i>Geneua</i>
    </l>
