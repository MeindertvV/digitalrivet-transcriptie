  <page_number>103</page_number>
  <running_head>LYRICA.</running_head>
  <bottom_margin>
    <signature>G 4</signature>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Quod portenta truci robore stipitis</i>
    </l>
    <l n="2" para="true">
      <i>Olim plurima contudit</i>
    </l>
    <l n="3" para="true">
      <i>Et ferro, &amp; rutilis perdidit ignibus</i>
    </l>
    <l n="4" para="true">
      <i>Lernea colubros fera</i>
    </l>
    <l n="5" para="true">
      <i>Infames: domitis atque latronibus,</i>
    </l>
    <l n="6" para="true">
      <i>Immanique Tyrannide</i>
    </l>
    <l n="7" para="true">
      <i>Pressa frugiferas reddidit urbibus</i>
    </l>
    <l n="8" para="true">
      <i>Paces fortia noxia</i>
    </l>
    <l n="9" para="true">
      <i>Imponens potior frena licentia.</i>
    </l>
    <l n="10" para="true">
      <i>Laudat postera Theseum</i>
    </l>
    <l n="11" para="true">
      <i>Semper fama recens, Dædale domus</i>
    </l>
    <l n="12" para="true">
      <i>Audax quod penetrauerit</i>
    </l>
    <l n="13" para="true">
      <i>Obscuros aditus, cacaque limina:</i>
    </l>
    <l n="14" para="true">
      <i>Atque infamis adultera</i>
    </l>
    <l n="15" para="true">
      <i>Partum Pasiphaes presserit Atticis</i>
    </l>
    <l n="16" para="true">
      <i>Impositum perimens iugum.</i>
    </l>
    <l n="17" para="true">
      <i>Et mandata Ducis tristia Cretici.</i>
    </l>
    <l n="18" para="true">
      <i>Sed laus nobilior manet</i>
    </l>
    <l n="19" para="true">
      <i>Celsis stelliferi verticibus poli:</i>
    </l>
    <l n="20" para="true">
      <i>Qui fortes vitium obruunt:</i>
    </l>
    <l n="21" para="true">
      <i>Qui Ditis resecant Tartarei dolos</i>
    </l>
    <l n="22" para="true">
      <i>Et mendacia, quo decens</i>
    </l>
    <l n="23" para="true">
      <i>Reddatur supero gloria Numini.</i>
    </l>
  </main_text>
