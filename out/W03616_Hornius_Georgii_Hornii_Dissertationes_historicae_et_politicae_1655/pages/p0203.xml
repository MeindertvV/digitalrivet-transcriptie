    <l n="7">re: ejusque exempla Iesuitas complu-</l>
    <l n="8">ria edidisse.</l>
    <l n="9" para="true">De quibus ita Iac. Aug. Thuanus in E-</l>
    <l n="10">legia in Parricidas:</l>
    <l n="11" para="true">
      <i>Nata Magistratum convellere, nata mi-</i>
    </l>
    <l n="12">
      <i>nistris</i>
    </l>
    <l n="13" para="true">
      <i>Subtrahere obsequium, Praesulibusque</i>
    </l>
    <l n="14">
      <i>suum :</i>
    </l>
    <l n="15" para="true">
      <i>Et viles regnantum animas, ipsosque</i>
    </l>
    <l n="16">
      <i>necandos</i>
    </l>
