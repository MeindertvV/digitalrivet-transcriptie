      <i>Horrenda Reges proditione docet :</i>
    </l>
    <l n="18" para="true">
      <i>Servandamque fidem negat, argutisque</i>
    </l>
    <l n="19">
      <i>cavillis</i>
    </l>
    <l n="20" para="true">
