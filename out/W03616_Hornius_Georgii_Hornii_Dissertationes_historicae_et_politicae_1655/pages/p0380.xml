  <running_head>GEORGII HORNII</running_head>
  <bottom_margin>
    <catchword>935.Gc-</catchword>
  </bottom_margin>
  <main_text>
    <l n="1">Bulchar, Apolofarus <i>Muhammed</i>, Apo-</l>
    <l n="2">chaps. <i>Deinde Sultani Tunetani Siciliam</i>
    </l>
    <l n="3">
      <i>receperunt, quorum nomine præses circa</i>
    </l>
    <l n="4">
      <i>A. clo lx. fuit</i> Belchanes,<i>quem alii Bef-</i>
    </l>
    <l n="5">
      <i>cavectum vocant Et ab eo tempore Nor-</i>
    </l>
    <l n="6">
      <i>manni Siciliam oppugnarunt, qua etiam</i>
    </l>
    <l n="7">
      <i>plene A. clo xc positi sunt.</i>
    </l>
    <l n="8" para="true">881. Carolus Craffus irrumpentes Sa-</l>
    <l n="9">racenos Italia arcuit.</l>
    <l n="10" para="true">891. Nicetes dux Constantinopolitani</l>
    <l n="11">Imperatoris,egregiam victoriam de Sa-</l>
    <l n="12">racenis reportavit.</l>
    <l n="13" para="true">910. Sarraceni Apuliam &amp; Calabriam</l>
    <l n="14">invadunt.</l>
    <l n="15" para="true">913. Ad Lyrim Campaniæ fluvium,</l>
    <l n="16">Sarraceni Romanorum civitates vastan-</l>
    <l n="17">tes vincuntur.</l>
    <l n="18" para="true">934.Sarraceni Fraxineto irrumpentes,</l>
    <l n="19">ad Aquas usque pervenerunt, ubi Sagitus</l>
    <l n="20">dux eorum cum toto exercitu deletus est.</l>
    <l n="21" para="true">
      <i>Luitprandus lib.1. Hist.cap.1.&amp; lib.v.</i>
    </l>
    <l n="22">
      <i>cap.iv. tradit Saracenos qui Fraxinetum</i>
    </l>
    <l n="23">
      <i>in Italia tenuerunt,fuisse tributarios Ab-</i>
    </l>
    <l n="24">
      <i>derahamenis Regis Cordubæ. Idem tradit</i>
    </l>
    <l n="25">
      <i>author Annalium de rebus Ludovici Pii</i>
    </l>
    <l n="26">
      <i>ad A. Io ccc xxvi, sed prater hos Hispa-</i>
    </l>
    <l n="27">
      <i>nos etiam Africani Saraceni magnam</i>
    </l>
    <l n="28">
      <i>Calabriæ &amp; Apuliæ partem sub Romano</i>
    </l>
    <l n="29">
      <i>&amp; Constantino occuparunt, teste eodem</i>
    </l>
    <l n="30">
      <i>Luitprando lib.1. cap. xii.</i>
    </l>
    <l n="31" para="true">
      <i>935.Gc-</i>
    </l>
  </main_text>
