  <main_text>
    <l n="1" type="heading" level="1" para="true">ELEMENTA</l>
    <l n="2" type="heading" level="1">ARITHMETICAE LOGICIS LEGIBVS</l>
    <l n="3" type="heading" level="1">EXPLICATA,</l>
    <l n="4" type="heading" level="1">CHRISTIANI VRSTISII</l>
    <l n="5" type="heading" level="1">Basil. opera.</l>
    <l n="6" type="heading" level="1" caput="1" para="true">CAPVT I.</l>
    <l n="7" type="heading" level="2" para="true">
      <i>De Arithmeticae definitione atque subiecto.</i>
    </l>
    <l n="8" para="true">
      <i>A</i>RITHMETICA est benè</l>
    <l n="9">numerandi scientia.</l>
    <l n="10" para="true">
      <i>Definitio breuis &amp; luculenta à fine</i>
    </l>
    <l n="11">
      <i>petita, quomodo etiam caeterae artes</i>
    </l>
    <l n="12">
      <i>definiuntur. Arithmeticā autem à</i>
    </l>
    <l n="13">
      <i>Logisticanon distinguimus, sicuti Plato in Gorgia voluit,</i>
    </l>
    <l n="14">
      <i>sed vocem eius generalem facimus, ut &amp; verbū ἀειθμῶν,</i>
    </l>
    <l n="15">
      <i>quo Notationem tantum vulgò designari receptum est,</i>
    </l>
    <l n="16">
      <i>cùm reliquarum potius partium exstat.</i>
    </l>
    <l n="17" para="true">Benè numerare, est uniuersam nume-</l>
    <l n="18">rorum uim, proprietates, usumq; inter-</l>
    <l n="19">pretari &amp; exercere.</l>
    <l n="20" para="true">
      <i>Patet ergo Numerum Arithmeticae Subiectum esse,</i>
    </l>
    <l n="21">
      <i>hoc est id, circa quod ars ipsa consumitur, &amp; ad quod</i>
    </l>
    <l n="22">
      <i>uniuersae illius praeceptiones referuntur.</i>
    </l>
  </main_text>
  <notes />
