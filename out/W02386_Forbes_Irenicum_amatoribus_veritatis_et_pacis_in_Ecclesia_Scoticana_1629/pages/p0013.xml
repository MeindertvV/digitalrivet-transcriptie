  <main_text>
    <l n="1" type="heading" level="1" para="true">REVERENDISSIMO,</l>
    <l n="2" type="heading" level="1">IN CHRISTO, PATRI</l>
    <l n="3" type="heading" level="1">PATRICIO</l>
    <l n="4" type="heading" level="1">MISERATIONE DIVINA</l>
    <l n="5" type="heading" level="1">EPISCOPO ABER-</l>
    <l n="6" type="heading" level="1">DONIENSI;</l>
    <l n="7" type="heading" level="2" para="true">ACADEMIÆ ABERDONIENSIS CAN-</l>
    <l n="8" type="heading" level="2">CELLARIO &amp; INSTAVRATORI:</l>
    <l n="9" type="foot" para="true">Domino &amp; Parenti meo honorandissimo,</l>
    <l n="10" type="foot">Salutem in DOMINO.</l>
    <l n="11" type="heading" level="2" para="true">REVERENDISSIME PATER,</l>
    <l n="12" para="true">Uasdam de receptis ritibus Aporias</l>
    <l n="13">Frater quidam combresbyter ad tenuita-</l>
    <l n="14">tem meam scriptas misit, enixè rogans ut</l>
    <l n="15">titubanti succurrerem. Quod quia since-</l>
    <l n="16">ro addiscendæ Veritatis &amp; tranquillandæ</l>
    <l n="17">conscientiæ studio facere videbatur, protinus</l>
    <l n="18">ei (invocato priùs scria ac supplice prece Nomine <i>DOMINI</i>)</l>
    <l n="19">de propositis Aporiis breviter rescripsi. Autor verò</l>
    <l n="20">mihi exstitit reverentia tua, ut nonnulla in aliorum etiam</l>
    <l n="21">utili;</l>
  </main_text>
  <notes />
