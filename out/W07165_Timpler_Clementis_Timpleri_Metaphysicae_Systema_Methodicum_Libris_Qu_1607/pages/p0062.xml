  <main_text>
    <l n="1" type="heading" level="2" para="true">Tabula Technologiæ Methodum adumbrans:</l>
    <l n="2" type="diagram" level="1">C. Differentiæ secundum quas sit liberalis scientiæ alia est [?]</l>
    <l n="3" type="diagram" level="2">Principalis, vel</l>
    <l n="4" type="diagram" level="3">Theologica.</l>
    <l n="5" type="diagram" level="3">Philosophica, vel</l>
    <l n="6" type="diagram" level="4">Prima, vel</l>
    <l n="7" type="diagram" level="5">Theoreti-ca, vel</l>
    <l n="8" type="diagram" level="6">Generalis, vt Metaphysica</l>
    <l n="9" type="diagram" level="6">Specialis, vel</l>
    <l n="10" type="diagram" level="7">Physica</l>
    <l n="11" type="diagram" level="7">Mathema-tica, vel</l>
    <l n="12" type="diagram" level="8">Geometria,</l>
    <l n="13" type="diagram" level="8">Arithmetica.</l>
    <l n="14" type="diagram" level="5">Practica, vel</l>
    <l n="15" type="diagram" level="6">Generalis vel Ethica.</l>
    <l n="16" type="diagram" level="6">Specialis, vel</l>
    <l n="17" type="diagram" level="7">Oeconomica,</l>
    <l n="18" type="diagram" level="7">Politica.</l>
    <l n="19" type="diagram" level="4">à prima orta, quæ est, vel</l>
    <l n="20" type="diagram" level="5">Primæ classis, vt</l>
    <l n="21" type="diagram" level="6">Medica,</l>
    <l n="22" type="diagram" level="6">Iuridica.</l>
    <l n="23" type="diagram" level="5">Secundæ classis, vt</l>
    <l n="24" type="diagram" level="6">Physiognomica,</l>
    <l n="25" type="diagram" level="6">Optica.</l>
    <l n="26" type="diagram" level="2">Minus principa-lis: quæ Philolo-gica dicitur: Estque vel</l>
    <l n="27" type="diagram" level="3">Sermocinatrix, quæ sermonem principaliter informat. Est-que vel</l>
    <l n="28" type="diagram" level="4">Primaria, vt</l>
    <l n="29" type="diagram" level="5">Grammatica,</l>
    <l n="30" type="diagram" level="5">Rhetorica,</l>
    <l n="31" type="diagram" level="4">Secundaria, vt</l>
    <l n="32" type="diagram" level="5">Poetica,</l>
    <l n="33" type="diagram" level="5">Musica.</l>
    <l n="34" type="diagram" level="3">Ratiocinatrix, quæ rationem principaliter informat: Est-que,</l>
    <l n="35" type="diagram" level="4">Logica,</l>
    <l n="36" type="diagram" level="4">Historica.</l>
    <l n="37" type="diagram" level="1">Divisio: [?]</l>
    <l n="38" type="diagram" level="1">Ars interna, alia est</l>
    <l n="39" type="diagram" level="2">Simplex, vel</l>
    <l n="40" type="diagram" level="3">totalis, quæ in genere, vel</l>
    <l n="41" type="diagram" level="3">Partialis.</l>
    <l n="42" type="diagram" level="4">contemplativa, operatiua, vel</l>
    <l n="43" type="diagram" level="5">Actiua, effectiua.</l>
    <l n="44" type="diagram" level="2">Composita, vel</l>
    <l n="45" type="diagram" level="3">Sapientia, vel</l>
    <l n="46" type="diagram" level="4">Theoretica.</l>
    <l n="47" type="diagram" level="3">Eloquentia.</l>
    <l n="48" type="diagram" level="4">Practica quæ proprie dicitur prudentia.</l>
    <l n="49" para="true">
      <i>FINIS.</i>
    </l>
