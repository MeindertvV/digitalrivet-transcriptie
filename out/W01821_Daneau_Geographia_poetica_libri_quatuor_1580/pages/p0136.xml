  <running_head>GEOGRAPH. LIB. I.</running_head>
  <bottom_margin>
    <catchword>Quiq;</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Petráque Olenia,&amp; Alisium,intus continet:</i>
    </l>
    <l n="2" para="true">
      <i>His quidem Amphimacus,Thalpius,Diores,&amp; Polyxenus præerant.:</i>
    </l>
    <l n="3" para="true">
      <i>Ætolis autem imperabat Thoas Andræmonis filius,</i>
    </l>
    <l n="4" para="true">
      <i>Qui Pleurona habitabant,&amp; Olenum,&amp; Pylenem,</i>
    </l>
    <l n="5" para="true">
      <i>Chalcidáque maritimam,Calydonáque petrosam.</i>
    </l>
    <l n="6" para="true">
      <i>His imperabat flauus Meleager.</i>
    </l>
    <l n="7" para="true">
      <i>Nunc autem ipsos quicúnque Pelasgicum Argos habitabant:</i>
    </l>
    <l n="8" para="true">
      <i>Quíque Alon, quíque Alopen, quíque Thrachinam incolebant:</i>
    </l>
    <l n="9" para="true">
      <i>Quíque tenebant Phthiam,&amp; Hellada,</i>
    </l>
    <l n="10" para="true">
      <i>Myrmidones autem vocabantur, &amp; Hellenes, &amp; Achiui:</i>
    </l>
    <l n="11" para="true">
      <i>His erat princeps velox Achilles.</i>
    </l>
    <l n="12" para="true">
      <i>Qui autem habitabant Philacen, &amp; Pyrrhasum floridam.</i>
    </l>
    <l n="13" para="true">
      <i>Cereris nemus,Itonáque matrem ouium,</i>
    </l>
    <l n="14" para="true">
      <i>Maritimámque Antrona,&amp; Pteleum herbosum:</i>
    </l>
    <l n="15" para="true">
      <i>Horum Protesilaus bellicosus dux erat.</i>
    </l>
    <l n="16" para="true">
      <i>Qui autem Pheras habitabant apud Boebeiden paludem,</i>
    </l>
    <l n="17" para="true">
      <i>Boebem,&amp; Glaphyras,&amp; bene ædificatam Iolcum:</i>
    </l>
    <l n="18" para="true">
      <i>His imperabat Eumelus Admeti filius.</i>
    </l>
    <l n="19" para="true">
      <i>Quivero Methonem, &amp; Thaumaciam habitabant,</i>
    </l>
    <l n="20" para="true">
      <i>Et Meliboeam tenebant,&amp; Olizonem asperam:</i>
    </l>
    <l n="21" para="true">
      <i>His Philoctetes præerat.</i>
    </l>
    <l n="22" para="true">
      <i>Quíque habitabant Triccem,&amp; Ithonem asperam.</i>
    </l>
    <l n="23" para="true">
      <i>Quíque incolebant Oechaliam ciuitatem Euryti Oechalij:</i>
    </l>
    <l n="24" para="true">
      <i>His præerant Æsculapij duo filij.</i>
    </l>
    <l n="25" para="true">
      <i>Quíque tenebant Ormenium, quiq; fontem Hyperiam,</i>
    </l>
  </main_text>
