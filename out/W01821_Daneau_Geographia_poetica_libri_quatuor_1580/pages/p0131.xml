  <page_number>123</page_number>
  <running_head>GRÆCIA.</running_head>
  <bottom_margin>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Dura manus: Deus ipso viros in puluere crudo</i>
    </l>
    <l n="2" para="true">
      <i>Arcas alit, nudaq; modo virtutis, &amp; iras</i>
    </l>
    <l n="3" para="true">
      <i>Ingenerat: vigor inde animis, &amp; mortis honora</i>
    </l>
    <l n="4" para="true">
      <i>Dulce sacrum, gaudent natorum in fata parentes,</i>
    </l>
    <l n="5" para="true">
      <i>Hortantúrque mori. deflet iámque omnis ephebum</i>
    </l>
    <l n="6" para="true">
      <i>Turba, coronato contenta est funere mater.</i>
    </l>
    <l n="7" para="true">
      <i>Frena tenent, duplexque inserto missile nodo</i>
    </l>
    <l n="8" para="true">
      <i>Exerti ingentes humeros: chlamys horrida pendet,</i>
    </l>
    <l n="9" para="true">
      <i>Et cono ledæus apex: non hi tibi solum</i>
    </l>
    <l n="10" para="true">
      <i>Amphiaraë merent: auget resupina maniplos</i>
    </l>
    <l n="11" para="true">
      <i>Elis, deprefsa populus subit incola Pisa.</i>
    </l>
    <l n="12" para="true">
      <i>Qui te flaue natant terris Alphæe Sicanis</i>
    </l>
    <l n="13" para="true">
      <i>Aduena tam longo non unquam infecte profundo.</i>
    </l>
    <l n="14" para="true">
      <i>Curribus innumeris late patria arua lacessunt,</i>
    </l>
    <l n="15" para="true">
      <i>Et bellis armenta domant, ea gloria genti</i>
    </l>
    <l n="16" para="true">
      <i>Infando de more, &amp; fractis durat ab vsque</i>
    </l>
    <l n="17" para="true">
      <i>Axibus Oenomai: stridentspumantia morsu</i>
    </l>
    <l n="18" para="true">
      <i>Vincula, &amp; effossas niueus rigat imber arenas.</i>
    </l>
    <l n="19" para="true">
      <i>Olenos tectis habitata raris,</i>
    </l>
    <l n="20" para="true">
      <i>Virginis Pleuros inimica diua.</i>
    </l>
    <l n="21" para="true">
      <i>An maris lati sinuosa Troezen?</i>
    </l>
    <l n="22" para="true">
      <i>Pelion, regnum Protei suberbum,</i>
    </l>
    <l n="23" para="true">
      <i>Tertius cælo gradus? Hic recumbens</i>
    </l>
    <l n="24" para="true">
      <i>Montis exesi spatiosus antro</i>
    </l>
    <l n="25" para="true">
      <i>Jam trucis Chiron pueri magister,</i>
    </l>
    <l n="26" para="true">
      <i>Tinnulas plectro feriente Chordas,</i>
    </l>
    <l n="27" para="true">
      <i>Tunc quoque ingentes accuebat iras</i>
    </l>
    <l n="28" para="true">
      <i>Bella canendo.</i>
    </l>
    <l n="29" para="true">
      <i>An ferax rari lapidis Carystos?</i>
    </l>
    <l n="30" para="true">
      <i>An premens littus maris inquieti</i>
    </l>
    <l n="31" para="true">
      <i>Semper Euripo properante Chalcis?</i>
    </l>
    <l n="32" para="true">
      <i>Quolibet vento faciles Echidna?</i>
    </l>
    <l n="33" para="true">
      <i>Attica pendens Teparethos ora?</i>
    </l>
  </main_text>
