  <page_number>8</page_number>
  <running_head>GEOGRAPH. LIB. I.</running_head>
  <bottom_margin>
    <catchword>Hos</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Herdus agit,iuga Pyrenes venatibus acer</i>
    </l>
    <l n="2" para="true">
      <i>Metiri,iaculove extendere prælia Mauro.</i>
    </l>
    <l n="3" para="true">
      <i>Venere &amp; Celta sociati nomen Iberis.</i>
    </l>
    <l n="4" para="true">
      <i>His pugna cecidisse decus,corpusque cremari.</i>
    </l>
    <l n="5" para="true">
      <i>Tale nefas caelo credunt,superisque referri,</i>
    </l>
    <l n="6" para="true">
      <i>Impastus carpat si membra iacentia vultur.</i>
    </l>
    <l n="7" para="true">
      <i>Fibrarum &amp; penna,diuinarumque sagacem</i>
    </l>
    <l n="8" para="true">
      <i>Flammarum,misit diues Gallecia pubem.</i>
    </l>
    <l n="9" para="true">
      <i>Barbara nunc patriis vlulantem carmina linguis,</i>
    </l>
    <l n="10" para="true">
      <i>Nuncpedis alterno percussa verbere terra</i>
    </l>
    <l n="11" para="true">
      <i>Ad numerum resonas gaudentem plaudere cetras.</i>
    </l>
    <l n="12" para="true">
      <i>Haec requies,ludisque viris,ea sacra voluptas.</i>
    </l>
    <l n="13" para="true">
      <i>Catera foemineus peragit labor:addere sulco</i>
    </l>
    <l n="14" para="true">
      <i>Semina,&amp; impressio tellurem vertere aratro,</i>
    </l>
    <l n="15" para="true">
      <i>Segne viris,quicquid duro sine Marte gerendum est,</i>
    </l>
    <l n="16" para="true">
      <i>Callaici coniux obit irrequieta mariti.</i>
    </l>
    <l n="17" para="true">
      <i>Vos Viriatthus agit,Lusitanumque remotis</i>
    </l>
    <l n="18" para="true">
      <i>Extractum lustris primo Viriatthus in auo</i>
    </l>
    <l n="19" para="true">
      <i>Nomen Romanis suetum mox nobile damnis.</i>
    </l>
    <l n="20" para="true">
      <i>Nec Ceretani quondam Tirynthia castra,</i>
    </l>
    <l n="21" para="true">
      <i>Aut Vasco insuetus galea,ferre arma morati.</i>
    </l>
    <l n="22" para="true">
      <i>Nec qua Dardanios post vidit Ilerda furores,</i>
    </l>
    <l n="23" para="true">
      <i>Nec qui Massagetem monstrans feritate parentem</i>
    </l>
    <l n="24" para="true">
      <i>Cornipedis fusa satiaris Concane vena.</i>
    </l>
    <l n="25" para="true">
      <i>Iamq; Ebusus Phoenissa mouet,mouet Artabrus arma,</i>
    </l>
    <l n="26" para="true">
      <i>Actide,vel tenui pugnax instare veruto.</i>
    </l>
    <l n="27" para="true">
      <i>Iam cui Tlepolemus sator,&amp; cui Lyndus origo,</i>
    </l>
    <l n="28" para="true">
      <i>Feruida bella ferens Balearis,&amp; alite plumbo.</i>
    </l>
    <l n="29" para="true">
      <i>Et quos nunc Grauia violato nomine Graium,</i>
    </l>
    <l n="30" para="true">
      <i>Oenea misere domus,Aetolaque Tyde.</i>
    </l>
    <l n="31" para="true">
      <i>Dat Carthago viros Teucro fundata vetusto.</i>
    </l>
    <l n="32" para="true">
      <i>Phocaica dant Emporia,dat Tarraco pubem</i>
    </l>
    <l n="33" para="true">
      <i>Vitifera,&amp; Latio tantum cessura Lyaeo.</i>
    </l>
  </main_text>
  <marginalia>
