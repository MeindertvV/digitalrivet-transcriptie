  <main_text>
    <l n="1" para="true">
      <i>An sacris gaudens tacitus Eleusis?</i>
    </l>
    <l n="2" para="true">
      <i>Nunquid Aiacis Salamina veri,</i>
    </l>
    <l n="3" para="true">
      <i>An fera notam Calidona saeua?</i>
    </l>
    <l n="4" para="true">
      <i>Quaesve perfundit subiturus aequor,</i>
    </l>
    <l n="5" para="true">
      <i>Segnibus terras Titaresos vndis?</i>
    </l>
    <l n="6" para="true">
      <i>Bessan, et Scarphen? Philon an senilem?</i>
    </l>
    <l n="7" para="true">
      <i>Pharin? an Pisam Iouis, &amp; coronis</i>
    </l>
    <l n="8" para="true">
      <i>Elida claram?</i>
    </l>
    <l n="9" para="true">
      <i>Quolibet tristis miseras procella</i>
    </l>
    <l n="10" para="true">
      <i>Mittat, &amp; donet cuicunque terrae:</i>
    </l>
    <l n="11" para="true">
      <i>Dum lucem tantum Troia, atque Achiuis</i>
    </l>
    <l n="12" para="true">
      <i>Quae tulit Sparte, procul abfit, abfit</i>
    </l>
    <l n="13" para="true">
      <i>Argos, &amp; fauui Pelopis Mycenae,</i>
    </l>
    <l n="14" para="true">
      <i>Neritos parua breuior Zacintho,</i>
    </l>
    <l n="15" para="true">
      <i>Et nocens saxis Ithace dolosis.</i>
    </l>
    <l n="16" para="true">
      <i>Proxima vicino vires dat Graecia bello.</i>
    </l>
    <l n="17" para="true">
      <i>Phocaicas Amphisa manus, scopulosaque Cyrrha,</i>
    </l>
    <l n="18" para="true">
      <i>Parnassusque ingo misit desertus utroque.</i>
    </l>
    <l n="19" para="true">
      <i>Boeoti coiere duces, quos impiger ambit</i>
    </l>
    <l n="20" para="true">
      <i>Fatidica Cephisos aqua, Cadmaeaque Dirce.</i>
    </l>
    <l n="21" para="true">
      <i>Pisaeaq; manus, populisque per aequora mittens</i>
    </l>
    <l n="22" para="true">
      <i>Sicanius Alphaeus aquas. tunc Maenala liquit</i>
    </l>
    <l n="23" para="true">
      <i>Arcas, &amp; Herculeam miles Thrachinius Oeten.</i>
    </l>
    <l n="24" para="true">
      <i>Thesproti, Dryopesque ruunt, quercusque silentes</i>
    </l>
    <l n="25" para="true">
      <i>Chaonio veteres liquerunt vertice Sella.</i>
    </l>
    <l n="26" para="true">
      <i>Exhausit totas quamuis delectus Athenas,</i>
    </l>
    <l n="27" para="true">
      <i>Exigua Phoebea tenent nauialia puppes,</i>
    </l>
    <l n="28" para="true">
      <i>Tresque petunt veram credi Salamina carina.</i>
    </l>
    <l n="29" para="true">
      <i>Jam dilecta Iouî centenis venit in arma</i>
    </l>
    <l n="30" para="true">
      <i>Creta vetus populis, Cnossasque agitare phare-tras</i>
    </l>
    <l n="31" para="true">
      <i>Dolta: nec Eois peior Gortyna sagittis.</i>
    </l>
  </main_text>
