  <page_number>293</page_number>
  <running_head>MARE MEDITERR. ET INSVL.</running_head>
  <main_text>
    <l n="1" para="true">
      <i>Sidonia &amp; Drepane,atque vnda clamofus Helorus,</i>
    </l>
    <l n="2" para="true">
      <i>Et mox ferui li vastata Triochala bello,</i>
    </l>
    <l n="3" para="true">
      <i>Sidonios Arabeia ferox,&amp; celsius Ietas,</i>
    </l>
    <l n="4" para="true">
      <i>Et bellare Tabas docilis,Cossyráque parua:</i>
    </l>
    <l n="5" para="true">
      <i>Nec maior Megara Mute concordibus ausis</i>
    </l>
    <l n="6" para="true">
      <i>Iuuere,&amp; strato Caulum spectabile ponto</i>
    </l>
    <l n="7" para="true">
      <i>Cùm sonat Halcyones cantu,nidósque notantes</i>
    </l>
    <l n="8" para="true">
      <i>Immota gestat sopitis fluctibus vnda.</i>
    </l>
    <l n="9" para="true">
      <i>Ipsa Syracuse patulos vrbs inclyta muros</i>
    </l>
    <l n="10" para="true">
      <i>Milite colleƈto,varisque impleuerat armis.</i>
    </l>
    <l n="11" para="true">
      <i>Duƈtores facilem impelli,latánque tumultus</i>
    </l>
    <l n="12" para="true">
      <i>Vaniloquo pubem furiabant insuper ore.</i>
    </l>
    <l n="13" para="true">
      <i>Nunquam hoste intratos muros,&amp; quatuor arces,</i>
    </l>
    <l n="14" para="true">
      <i>Et Salaminiacis quantam,Eoisque trophæis</i>
    </l>
    <l n="15" para="true">
      <i>Ingenio portus vrbs inuia fecerit vmbram,</i>
    </l>
    <l n="16" para="true">
      <i>Spectatum pro auis: ter centum ante ora triremes</i>
    </l>
    <l n="17" para="true">
      <i>V num naufragium,mersásque impune profundo</i>
    </l>
    <l n="18" para="true">
      <i>Clade Pharetrigeri subnixas regis Athenas.</i>
    </l>
    <l n="19" para="true">
      <i>Flammabant vulgum geniti Carthagine fratres</i>
    </l>
    <l n="20" para="true">
      <i>Pœni matre genus,sed quos sub crimine pulsos</i>
    </l>
    <l n="21" para="true">
      <i>Vrbe Syracosia Libycis eduxerat oris</i>
    </l>
    <l n="22" para="true">
      <i>Trinacrius genitor,geminaque astirpe parentum</i>
    </l>
    <l n="23" para="true">
      <i>Astus miscebant Tyrios leuitate Sicana.</i>
    </l>
    <l n="24" para="true">
      <i>Qua cernens duƈtor,postquam immedicabile visum</i>
    </l>
    <l n="25" para="true">
      <i>Seditio,atque vltro bellum surgebat ab hoste,</i>
    </l>
    <l n="26" para="true">
      <i>Testatus diuos Siculorum,amnésque,lacúsque,</i>
    </l>
    <l n="27" para="true">
      <i>Et fontes Arethusa tuos,ad bella vocari</i>
    </l>
    <l n="28" para="true">
      <i>Inuitum,qua sponte diu non sumpserit,hostem</i>
    </l>
    <l n="29" para="true">
      <i>Induere arma sibi,telorum turbine vasto,</i>
    </l>
    <l n="30" para="true">
      <i>Aggreditur muros,atque armis intonat vrbi.</i>
    </l>
  </main_text>
