  <page_number>114</page_number>
  <running_head>GEOGRAPH. LIB. I.</running_head>
  <bottom_margin>
    <catchword>Misit</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Et Penei qui rura colunt, quorúmque labore</i>
    </l>
    <l n="2" para="true">
      <i>Thessalus Aemoniam vomer proscindit Iolcon.</i>
    </l>
    <l n="3" para="true">
      <i>Inde lacessitum primò mare, cùm rudis Argo</i>
    </l>
    <l n="4" para="true">
      <i>Miscuit ignotas temerato littore gentes,</i>
    </l>
    <l n="5" para="true">
      <i>Primáque cùm ventis, pelagique furentibus undis</i>
    </l>
    <l n="6" para="true">
      <i>Compositi mortale genus, fatisque per illam</i>
    </l>
    <l n="7" para="true">
      <i>Accessit mors vna ratem.</i>
    </l>
    <l n="8" para="true">
      <i>Thessalus ardet ager: reticet pastore fugato</i>
    </l>
    <l n="9" para="true">
      <i>Pelion.</i>
    </l>
    <l n="10" para="true">
      <i>Cede puer facta Patroclus Opunta reliquit,</i>
    </l>
    <l n="11" para="true">
      <i>Thessalicámque adyt hospes Achillis humum.</i>
    </l>
    <l n="12" para="true">
      <i>Exul ab Aemonia Pirenida cessit ad vndam,</i>
    </l>
    <l n="13" para="true">
      <i>Quo duce trabs Colchà sacra cucurrit aqua.</i>
    </l>
    <l n="14" para="true">
      <i>Iunctior Aemonia est Ponto, quàm Romasit Istro.</i>
    </l>
    <l n="15" para="true">
      <i>Remis adurgens: accipiter velut</i>
    </l>
    <l n="16" para="true">
      <i>Molles columbas, aut leporem citus</i>
    </l>
    <l n="17" para="true">
      <i>Venator in campis nivalis</i>
    </l>
    <l n="18" para="true">
      <i>Aemonia.</i>
    </l>
    <l n="19" para="true">
      <i>Sic, cùm Thessaliam scopulis inclusa teneret</i>
    </l>
    <l n="20" para="true">
      <i>Paneo stagnante palus, &amp; mersa negaret</i>
    </l>
    <l n="21" para="true">
      <i>Arua coli, trifida Neptunus cuspide montes</i>
    </l>
    <l n="22" para="true">
      <i>Impulit aduersos: tum forti saucius ictu</i>
    </l>
    <l n="23" para="true">
      <i>Dissiluit gelido vertex Ossaus Olympo.</i>
    </l>
    <l n="24" para="true">
      <i>Carceribus laxantur aquae, fractóque meatu,</i>
    </l>
    <l n="25" para="true">
      <i>Reddūtur fluuiique mari, tellúsque colonis.</i>
    </l>
    <l n="26" para="true">
      <i>Qua vocat sedes habitanda captas?</i>
    </l>
    <l n="27" para="true">
      <i>Thessali montes, &amp; Opaca Tempe?</i>
    </l>
    <l n="28" para="true">
      <i>An viros tellus dare militares</i>
    </l>
    <l n="29" para="true">
      <i>Aptior Phthie? meliórque fœtu</i>
    </l>
    <l n="30" para="true">
      <i>Fortis armenti lapidosa Thrachin?</i>
    </l>
    <l n="31" para="true">
      <i>An maris vasti domitrix Iolchos?</i>
    </l>
    <l n="32" para="true">
      <i>An frequens rusicis leuibus Methone,</i>
    </l>
    <l n="33" para="true">
      <i>Quasub Oetais latebrosa sylvis</i>
    </l>
  </main_text>
