  <running_head>GRÆCIA.</running_head>
  <bottom_margin>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>His præerat bello strenuus Diomedes.</i>
    </l>
    <l n="2" para="true">
      <i>Qui autem Mycenas incolebant celebrem vrbem,</i>
    </l>
    <l n="3" para="true">
      <i>Opulentámque Corinthum, bene habitatásque Cleonas,</i>
    </l>
    <l n="4" para="true">
      <i>Orniásque habitabant, Arathyreamq; amabilem,</i>
    </l>
    <l n="5" para="true">
      <i>Et Syciona, vbi Adrastus primùm regnauit:</i>
    </l>
    <l n="6" para="true">
      <i>Quíque Hyperesiam, &amp; excelsam Gonoessam,</i>
    </l>
    <l n="7" para="true">
      <i>Pellenámque habitabant, &amp; Ægium incolebant,</i>
    </l>
    <l n="8" para="true">
      <i>Et omnem oram illam maritimam, &amp; circa Helicen</i>
    </l>
    <l n="9" para="true">
      <i>spatiosam,</i>
    </l>
    <l n="10" para="true">
      <i>Horum centum nauibus imperabat rex Agamemnon.</i>
    </l>
    <l n="11" para="true">
      <i>Quíque incolebant cocauam Lacedæmona immensam,</i>
    </l>
    <l n="12" para="true">
      <i>Pharémque, Spartámque, abundantémque columbis</i>
    </l>
    <l n="13" para="true">
      <i>Messenem:</i>
    </l>
    <l n="14" para="true">
      <i>Bryfiasq habitabant, &amp; Augias amabiles:</i>
    </l>
    <l n="15" para="true">
      <i>Quíque Amyclas tenebant, Helósque maritimum op-</i>
    </l>
    <l n="16" para="true">
      <i>pidum:</i>
    </l>
    <l n="17" para="true">
      <i>Quiq; Laam habitabant, &amp; Oetylon incolebant:</i>
    </l>
    <l n="18" para="true">
      <i>His ipsius frater præerat Menelaus.</i>
    </l>
    <l n="19" para="true">
      <i>Quíque Pylúmque habitabant, &amp; Arenen amabilem,</i>
    </l>
    <l n="20" para="true">
      <i>Et Thryon Alphai vadum, &amp; bene adificatum Æpy:</i>
    </l>
    <l n="21" para="true">
      <i>Et Cyparisseentem, &amp; Amphigeniam habitabant,</i>
    </l>
    <l n="22" para="true">
      <i>Et Pteleon, &amp; Helos, &amp; Dorion,</i>
    </l>
    <l n="23" para="true">
      <i>His præerat Gerenius eques Nestor.</i>
    </l>
    <l n="24" para="true">
      <i>Quiq; habitabant Arcadiá sub Cyllenes monte altum,</i>
    </l>
    <l n="25" para="true">
      <i>Prope Æpyti monumentum.</i>
    </l>
    <l n="26" para="true">
      <i>Qui Pheneumq; incolebant, &amp; Orchomenû pecorosum</i>
    </l>
    <l n="27" para="true">
      <i>Ripénque, Straciénque, &amp; altam Enispen,</i>
    </l>
    <l n="28" para="true">
      <i>Et Tegeam habitabant, &amp; Mantineam amabilem:</i>
    </l>
    <l n="29" para="true">
      <i>Stymphalúmque tenebant, &amp; Parrhasien habitabant:</i>
    </l>
    <l n="30" para="true">
      <i>His imperabat Ancaï filius rex Agapenor.</i>
    </l>
    <l n="31" para="true">
      <i>Qui Buprasiúmque, &amp; Elidem nobilem incolebant</i>
    </l>
    <l n="32" para="true">
      <i>Quantum agri Hyrmine, &amp; Myrsinum extrema,</i>
    </l>
  </main_text>
