<page type="text" lines="ocr">
  <layout>One column of italic verse, centred-ragged, with a signature mark at the foot right. Running head centred at top; page number top right.</layout>
  <page_number>7</page_number>
  <running_head>IBERICA.</running_head>
  <bottom_margin>
    <signature>A iiij</signature>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Quod Veritatis feruida candidæ</i>
    </l>
    <l n="2">
      <i>Ignes per orbem spargere lucidos:</i>
    </l>
    <l n="3">
      <i>Et fraudis inuisas fugare</i>
    </l>
    <l n="4">
      <i>Tartareæ meditatur umbras.</i>
    </l>
    <l n="5" para="true">
      <i>O TAM celebri nunc ter &amp; amplius</i>
    </l>
    <l n="6">
      <i>Regnata felix Anglia Principe!</i>
    </l>
    <l n="7">
      <i>O nunc triumphatis Iberum</i>
    </l>
    <l n="8">
      <i>Nobilior ducibus superbis!</i>
    </l>
    <l n="9" para="true">
      <i>Nunc nunc Britanni Cœlituum Patrem</i>
    </l>
    <l n="10">
      <i>Laudare tempus, nunc fora, compita,</i>
    </l>
    <l n="11">
      <i>Et templa, diuinos fauores</i>
    </l>
    <l n="12">
      <i>Perpetuo resonate cantu.</i>
    </l>
    <l n="13" para="true">
      <i>Lucémque festam quæ redeuntibus</i>
    </l>
    <l n="14">
      <i>Ridebit annis semper Adoreâ:</i>
    </l>
    <l n="15">
      <i>Quæ fudit Hispanos potentes</i>
    </l>
    <l n="16">
      <i>Per memores celebrate fastos.</i>
    </l>
    <l n="17" para="true">
      <i>Fas &amp; fauenti plaudere murmure</i>
    </l>
    <l n="18">
      <i>Quos cura Christi prouida fustinet</i>
    </l>
    <l n="19">
      <i>Cum frangit hostes, cum nefandæ</i>
    </l>
    <l n="20">
      <i>Turba perit truculenta gentis.</i>
    </l>
    <l n="21" para="true">
      <i>Quacunque lucis conscia Olympicæ</i>
    </l>
    <l n="22">
      <i>Terras per omnes æthereum colis,</i>
    </l>
    <l n="23">
      <i>Gens sacra patrem fœderatis</i>
    </l>
    <l n="24">
      <i>Pectoribus sociate vota.</i>
    </l>
    <l n="25" para="true">
      <i>Vt tanta cunctis sospes ab hostibus</i>
    </l>
    <l n="26">
      <i>Regina, vitæ tempora prorogans</i>
    </l>
    <l n="27">
      <i>Felicis, Antiquos Britannos</i>
    </l>
    <l n="28">
      <i>Imperiis moderetur æquis.</i>
    </l>
  </main_text>
  <notes>Printed page 7 with running head IBERICA. Text is set in italic throughout; the initial capitals Q, O, N, L, F, Q, Q and V are decorative and copied as plain letters. "Iberum" is printed with a long-s form, read as Iberum. The signature mark at the foot reads "A .iiij." in print, given here as "A iiij".</notes>
</page>
