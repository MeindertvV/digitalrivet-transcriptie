  <page_number>11</page_number>
  <running_head>IBERICA,</running_head>
  <main_text>
    <l n="1" para="true">
      <i>Heu, heu, quantus adest militibus tuis</i>
    </l>
    <l n="2">
      <i>Sudor! Quanta moues funera Ibericæ</i>
    </l>
    <l n="3">
      <i>Genti. Quanta ferox Angla triremibus</i>
    </l>
    <l n="4">
      <i>Pubes damna tuis feret!</i>
    </l>
    <l n="5" para="true">
      <i>Te mox fulmineo turbine glandium</i>
    </l>
    <l n="6">
      <i>Quassabit, rutilis te petet ignibus,</i>
    </l>
    <l n="7">
      <i>Incendétque simul lintea, remiges,</i>
    </l>
    <l n="8">
      <i>Malos, transtráque navium,</i>
    </l>
    <l n="9" para="true">
      <i>Spumantéfque tuo sanguine gurgites</i>
    </l>
    <l n="10">
      <i>Infecisse feri gestiet æquoris.</i>
    </l>
    <l n="11">
      <i>Ridebit spolis auctus Americis,</i>
    </l>
    <l n="12">
      <i>Auro ditior Indico.</i>
    </l>
    <l n="13" para="true">
      <i>Nequicquam æquoreos perdita tunc</i>
    </l>
    <l n="14">
      <i>roga Diuos, supplicibus pietàve numina</i>
    </l>
    <l n="15">
      <i>Votis sollicita. Non miseræ preces</i>
    </l>
    <l n="16">
      <i>Duris mortibus eximent.</i>
    </l>
    <l n="17" para="true">
      <i>Nequicquam fugient hostibus impares,</i>
    </l>
    <l n="18">
      <i>Et duris lacerae vulneribus rates.</i>
    </l>
    <l n="19">
      <i>Nequicquam latebras Oceano petent.</i>
    </l>
    <l n="20">
      <i>Exspes nil fuga proderit.</i>
    </l>
    <l n="21" para="true">
      <i>Si vicina petis littora Belgii,</i>
    </l>
    <l n="22">
      <i>Parmensemque vocas præsidio Ducem,</i>
    </l>
    <l n="23">
      <i>Te pellet Bataus miles acerbior,</i>
    </l>
    <l n="24">
      <i>Hispani metuens ingi.</i>
    </l>
    <l n="25" para="true">
      <i>Est Anglis stabili fœdere Dania</i>
    </l>
    <l n="26">
      <i>Iuncta, &amp; quæ latitant tecta Trionibus</i>
    </l>
    <l n="27">
      <i>Septenis profugos æquora negligunt,</i>
    </l>
    <l n="28">
      <i>Tutúmque hospitium negant.</i>
    </l>
    <l n="29" type="foot" para="true" merged="true">[?] Marked readings: "Exspes" and "Parmensemque" are read with the long s taken as s; the accents on "Incendétque", "Spumantéfque" and "Tutúmque" are as printed.</l>
  </main_text>
