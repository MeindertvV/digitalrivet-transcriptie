  <main_text>
    <l n="1" para="true">
      <i>Hac ille fidens toxica (subdola</i>
    </l>
    <l n="2">
      <i>Gentis latentes insidias) cauet.</i>
    </l>
    <l n="3" para="true">
      <i>Hac ille securus feroces</i>
    </l>
    <l n="4">
      <i>Sape minas gladiosq; fregit</i>
    </l>
    <l n="5">
      <i>Authore suo Præfule[?] quum furor:</i>
    </l>
    <l n="6">
      <i>Non ante visus frena licentia</i>
    </l>
    <l n="7">
      <i>Laxauit ardenti per urbes</i>
    </l>
    <l n="8">
      <i>Effera quum laniena Francas</i>
    </l>
    <l n="9">
      <i>Graffata, Gentes terruit insolens.</i>
    </l>
    <l n="10" para="true">
      <i>Quum turba veri conscia Numinis,</i>
    </l>
    <l n="11">
      <i>Incauta, fallacisq; dira</i>
    </l>
    <l n="12">
      <i>Fraude ruit iugulata pacis:</i>
    </l>
    <l n="13">
      <i>Et sacra Christo pectora credito</i>
    </l>
    <l n="14">
      <i>Mactauit[?] atrox carnificum manus</i>
    </l>
    <l n="15">
      <i>Passim, nec imbelli iuuenta</i>
    </l>
    <l n="16">
      <i>Virginibus puerisq; parcens.</i>
    </l>
    <l n="17" para="true">
      <i>Quum luctuoso Gallia classico</i>
    </l>
    <l n="18">
      <i>Lymphata cives diripuit suos,</i>
    </l>
    <l n="19">
      <i>Fusoque cunctas Innocentum</i>
    </l>
    <l n="20">
      <i>Sanguine conscelerauit vrbes.</i>
    </l>
    <l n="21" para="true">
      <i>Sic quae celebrant Orgia Manades</i>
    </l>
    <l n="22">
      <i>Bacchantur acres, tympana quum crepant.</i>
    </l>
    <l n="23">
      <i>Penthea sic damnis Agaue</i>
    </l>
    <l n="24">
      <i>Laeta suis genitrix trucidat.</i>
    </l>
    <l n="25" para="true">
      <i>Sed te benignus Caelituum fauor</i>
    </l>
    <l n="26">
      <i>Per tela &amp; hostes, Optime Principum,</i>
    </l>
    <l n="27">
      <i>Seruauit ereptum furentes,</i>
    </l>
    <l n="28">
      <i>Auxiliumq; feret perenne.</i>
