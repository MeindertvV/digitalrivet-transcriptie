  <page_number>48</page_number>
  <main_text>
    <l n="1" type="heading" level="1" para="true">ODE MONOCOLOS,</l>
    <l n="2" type="heading" level="1">IN SVBLATVM MERITA</l>
    <l n="3" type="heading" level="1">MORTE GVISIVM.</l>
    <l n="4" para="true">
      <i>ANNOSAE Thetidis fluctiuagum pecus,</i>
    </l>
    <l n="5">
      <i>Regnatæque domus Nereidum</i>
    </l>
    <l n="6">
      <i>choro Mirantes validæ pondera</i>
    </l>
    <l n="7">
      <i>dexteræ, Quæ puppes pelago nuper Ibericas</i>
    </l>
    <l n="8">
      <i>Imis prætumidas fluctibus obruit,</i>
    </l>
    <l n="9">
      <i>Stant fixæ, veluti dum stupor irruens</i>
    </l>
    <l n="10">
      <i>Furatur vigilum munera sensuum.</i>
    </l>
    <l n="11" para="true">
      <i>Et sint muta licet monstra natantia,</i>
    </l>
    <l n="12">
      <i>Clamant illa tamen mirificæ manus</i>
    </l>
    <l n="13">
      <i>Fortem non solito more potentiam.</i>
    </l>
    <l n="14" para="true">
      <i>Quotquot terra parens continet incolas,</i>
    </l>
    <l n="15">
      <i>Et qui soliuagis montibus incubant,</i>
    </l>
    <l n="16">
      <i>Camporumque</i>
    </l>
    <l n="17">
      <i>tenent æquora qui procul.</i>
    </l>
    <l n="18" para="true">
      <i>Aer quotquot habet lympidus hospites,</i>
    </l>
    <l n="19">
      <i>Testantes, celebrant eximiam Dei</i>
    </l>
    <l n="20">
      <i>Fortis non solito more potentiam.</i>
    </l>
    <l n="21" para="true">
      <i>Nos qui sydereis fornicibus bonæ</i>
    </l>
    <l n="22">
      <i>Auræ particulam ducimus, &amp; sumus</i>
    </l>
    <l n="23">
      <i>Haud mentis vacui, flammea quam fides</i>
    </l>
    <l n="24">
      <i>Illustrat radiis non morientibus,</i>
    </l>
    <l n="25">
      <i>Robur suspicimus, summe Deus, tuum.</i>
    </l>
  </main_text>
  <bottom_margin>
    <catchword>Robur</catchword>
  </bottom_margin>
