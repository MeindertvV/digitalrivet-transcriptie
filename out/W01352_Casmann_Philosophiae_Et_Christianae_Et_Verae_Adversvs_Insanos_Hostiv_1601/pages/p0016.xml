  <main_text>
    <l n="1" type="heading" level="1" para="true">De contrariis vitiis vanæ Philosophiæ Pseudo Aristotelicæ.</l>
    <l n="2" type="heading" level="2" para="true">Primum.</l>
    <l n="3" para="true">
      <i>Philosophia ne sit impia.</i>
    </l>
    <l n="4" type="heading" level="2" para="true">Secundum.</l>
    <l n="5" para="true">
      <i>Philosophia ne sit iniusta &amp; iniqua in proximū.</i>
    </l>
    <l n="6" type="heading" level="2" para="true">Tertium.</l>
    <l n="7" para="true">
      <i>Philosophia ne sit falsa, nec hominum nitatur traditionibus.</i>
    </l>
    <l n="8" type="heading" level="2" para="true">Quartum.</l>
    <l n="9" para="true">
      <i>Philosophia ne sit Sophistica &amp; fuco tincta.</i>
    </l>
    <l n="10" type="heading" level="2" para="true">Quintum.</l>
    <l n="11" para="true">
      <i>Philosophia ne sit serua.</i>
    </l>
    <l n="12" type="heading" level="2" para="true">Sextum.</l>
    <l n="13" para="true">
      <i>Philosophia ne sit inutilis &amp; futilis.</i>
    </l>
    <l n="14" type="heading" level="2" para="true">Septimum.</l>
    <l n="15" para="true">
      <i>Philosophia ne sit immodesta ac inflata.</i>
    </l>
    <l n="16" type="heading" level="2" para="true">Octauum.</l>
    <l n="17" para="true">
      <i>Philosophia ne sit perturbata &amp; promiscue confusa.</i>
    </l>
    <l n="18" type="heading" level="2" para="true">Nonum.</l>
    <l n="19" para="true">
      <i>Philosophia ne sit obscura &amp; difficilis.</i>
    </l>
    <l n="20" type="heading" level="2" para="true">Decimum.</l>
    <l n="21" para="true">
      <i>Philosophia ne sit vasta nimis &amp; prolixa, validum, fallaciam &amp; deformitatem pariens.</i>
    </l>
    <l n="22" type="heading" level="2" para="true">Undecimum.</l>
    <l n="23" para="true">
      <i>Philosophia ne sit indoctis ac ignaua, ne sit admo-</i>
    </l>
  </main_text>
