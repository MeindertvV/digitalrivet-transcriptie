  <running_head>De N / Nomine Iesu.</running_head>
  <bottom_margin>
    <catchword>EXER-</catchword>
    <signature>Q</signature>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">XL. iv. Is denique</l>
    <l n="2">commu[n] gaudio ineffabili cujus naturam</l>
    <l n="3">sum illum suum omni ope</l>
    <l n="4">oper[a] intercedat quod jucundissimam [?]</l>
    <l n="5">turbet. Cant. 111.4. C.</l>
    <l n="6">Liqu[?] patietur se ab illius amplexibus a[?]</l>
    <l n="7" para="true">XLI. Hos similesque</l>
    <l n="8">creden[?] fectus eleganti cantico profecut[?]</l>
    <l n="9">moriter discatur, &amp; frequenter[?]</l>
    <l n="10">tur. Quod propterea in</l>
    <l n="11">eoru[?] bent, hic dabo.</l>
    <l n="12" para="true">
      <i>O Jesu mi dulcissime,</i>
    </l>
    <l n="13">
      <i>Spes suspirantis anima,</i>
    </l>
    <l n="14">
      <i>Te quaerunt pia lachryma,</i>
    </l>
    <l n="15">
      <i>Te clamor mentis intima.</i>
    </l>
    <l n="16" para="true">
      <i>Jesu dulcedo cordium,</i>
    </l>
    <l n="17">
      <i>Fons vivus, lumen mentium,</i>
    </l>
    <l n="18">
      <i>Excedens omne gaudium,</i>
    </l>
    <l n="19">
      <i>Et omne desiderium.</i>
    </l>
    <l n="20" para="true">
      <i>Quando cor nostrum visitas,</i>
    </l>
    <l n="21">
      <i>Tunc lucet ei veritas,</i>
    </l>
    <l n="22">
      <i>Mundi vilescit vanitas,</i>
    </l>
    <l n="23">
      <i>Et intus fervet charitas.</i>
    </l>
    <l n="24" para="true">
      <i>Jesu mi bone, sentiam,</i>
    </l>
    <l n="25">
      <i>Amoris tui copiam,</i>
    </l>
    <l n="26">
      <i>Da mihi per praesentiam</i>
    </l>
    <l n="27">
      <i>Tuam videre gloriam.</i>
    </l>
    <l n="28" para="true">
      <i>Quem tuus amor ebriat,</i>
    </l>
    <l n="29">
      <i>Novit quid Jesus sapiat.</i>
    </l>
    <l n="30">
      <i>Quam felix est, quem satiat!</i>
    </l>
    <l n="31">
      <i>Non est ultra quod capiat.</i>
    </l>
    <l n="32" para="true">
      <i>Jesu decus Angelicum,</i>
    </l>
    <l n="33">
      <i>In aure dulce canticum,</i>
    </l>
    <l n="34">
      <i>In ore mel mirificum,</i>
    </l>
    <l n="35">
      <i>In corde nectar coelicum.</i>
    </l>
    <l n="36" para="true">
      <i>Desidero te mi-</i>
    </l>
    <l n="37">
      <i>llies.</i> nionis suae cum Iesu</l>
    <l n="38">certus A. Exsultabit &amp; proprietates alibi descripsimus. B. Iesu,</l>
    <l n="39">qui aque solicite custodiet, ne quid fortasse</l>
    <l n="40">Salvatoris sui &amp; salutis in eo fruitionem.</l>
    <l n="41" para="true">ut Iesu desiderans. Cant. VIII. 6. 7.</l>
    <l n="42" para="true">amantisque animae adversus Iesum</l>
    <l n="43">affectus est Bernardus, digno certe</l>
    <l n="44">quod merito ... D. IESU in Spiritu &amp; Veritate</l>
    <l n="45">occinamus gratiam, qui Bernardi Opera non habet.</l>
    <l n="46">Mi Iesu, quando venies?</l>
    <l n="47">Me laetum quando facies?</l>
    <l n="48">Me de te quando satias?</l>
    <l n="49">Jam quod quaesivi video,</l>
    <l n="50">Quod concupivi teneo.</l>
    <l n="51">Amore Iesu langueo,</l>
    <l n="52">Et corde totus ardeo.</l>
    <l n="53">O beatum incendium,</l>
    <l n="54">Et ardens desiderium!</l>
    <l n="55">O dulce refrigerium,</l>
    <l n="56">Amare Deum Filium!</l>
    <l n="57">Tu mentis delectatio,</l>
    <l n="58">Amoris consummatio.</l>
    <l n="59">Tu mea gloriatio,</l>
    <l n="60">Iesu mundi salvatio.</l>
    <l n="61">Tu verum coeli gaudium;</l>
    <l n="62">Iesu cordis tripudium,</l>
    <l n="63">Tollens omne fastidium,</l>
    <l n="64">Mel, nectar, melos, suavitas.</l>
    <l n="65">Iesu corona Martyrum,</l>
    <l n="66">Et flos perennis virginum:</l>
    <l n="67">Tu casti cordis lilium,</l>
    <l n="68">Tu decertantis praemium.</l>
    <l n="69">Exaudi preces supplicum</l>
    <l n="70">Nil extra te quaerentium.</l>
  </main_text>
