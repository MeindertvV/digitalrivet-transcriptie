  <running_head>EPISTOLA NVNCVPATORIA</running_head>
  <bottom_margin>
    <catchword>nundi-</catchword>
  </bottom_margin>
  <main_text>
    <l n="1">non adoptionem, non Baptismum, non</l>
    <l n="2">verbum Dei,non vocationem superesse</l>
    <l n="3">dixerunt; aut aliunde de integro aliam</l>
    <l n="4">construi domum, cæteráque omnia, ut</l>
    <l n="5">prorsus amissa, novo quodam fœdere</l>
    <l n="6">inito, concedi oportere docuerunt.</l>
    <l n="7">Quinimò Ecclesiæ vicem doluerunt;</l>
    <l n="8">&amp; statum ejus prorsus corruptum, sive</l>
    <l n="9">ejus regendæ rationem &amp; formam, ho-</l>
    <l n="10">minum Christo non servientium facto,</l>
    <l n="11">perversam &amp; eversam jure indignati</l>
    <l n="12">sunt. Cæterùm corpori ipsi ex admini-</l>
    <l n="13">stratione iniqua, sive potiùs ex domi-</l>
    <l n="14">natione Tyrannica, illata damna resar-</l>
    <l n="15">citi, numulariorum mensas subverti,</l>
    <l n="16">errores ab hominibus invectos corrigi,</l>
    <l n="17">doctrinamque ex verbi divini præscri-</l>
    <l n="18">pto repurgari flagitârunt; ipsiúque facto</l>
    <l n="19">suo, ex muneris demandati jure, tan-</l>
    <l n="20">tum opus non segniter inchoatum in-</l>
    <l n="21">defesso studio persecuti, omnes exem-</l>
    <l n="22">plo, &amp; ex divinis oraculis desumptis ar-</l>
    <l n="23">gumentis, persuadere conati sunt.</l>
    <l n="24" para="true">Quam ineptum verò fuisset, Lutherò</l>
    <l n="25">de remissione peccatorum ex verbo</l>
    <l n="26">Dei tractanti, &amp; satisfactiones humanas,</l>
    <l n="27">profanamque indulgentiarum</l>
    <l n="28">nundi-</l>
  </main_text>
