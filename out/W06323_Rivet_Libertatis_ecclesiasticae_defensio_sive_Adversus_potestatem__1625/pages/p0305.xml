  <main_text>
    <l n="1" type="heading" level="1" para="true">LIBERTATIS</l>
    <l n="2" type="heading" level="1">ECCLESIASTICAE</l>
    <l n="3" type="heading" level="1">DEFENSIONIS</l>
    <l n="4" type="heading" level="1">Pars tertia,</l>
    <l n="5" type="heading" level="1">
      <i>in qua demonstratur</i>
    </l>
    <l n="6" type="heading" level="1">Quae priscis seculis, post Apostolorum</l>
    <l n="7" type="heading" level="1">tempora, de Romani Episcopi</l>
    <l n="8" type="heading" level="1">authoritate sententia fuerit.</l>
    <l n="9" type="heading" level="2" para="true">PRAEFATIO.</l>
    <l n="10" para="true">INGENS illa Papatûs arbos, quæ in hac</l>
    <l n="11">sæculorum fæce, exitialem planè, ut-</l>
    <l n="12">cúmque gratam, sub ea recubantibus</l>
    <l n="13">infert umbram, terræ habitatoribus, ad-</l>
    <l n="14">mirationis præbet argumentum. Siquidem, pro-</l>
    <l n="15">ceritate eximiâ, &amp; ramis porrectis, species oculis</l>
    <l n="16">carnis perelegans mirum in modum eos afficit</l>
    <l n="17">queis ejusdem ignota est origo, ménsque caligi-</l>
    <l n="18">ne obducta haud animadvertit illam</l>
    <l n="19">
      <i>-Quantum vertice ad auras</i>
    </l>
    <l n="20">
      <i>AEthereas, tantùm radice in Tartara</i>--</l>
    <l n="21" para="true">tendere, ex ipsóque adeò abysso ascendere. Nam cùm nec à principio, ut antea demonstravimus,</l>
  </main_text>
