  <running_head>De Orthographia</running_head>
  <bottom_margin>
    <catchword>Di-</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">[D]icuntur autem ancipites: quòd in</l>
    <l n="2">quibusdam dictionibus producantur;</l>
    <l n="3">in quibusdam corripiantur;</l>
    <l n="4">in quibus-</l>
    <l n="5">dam denique, modò producta, modò</l>
    <l n="6">correpta inveniantur.]</l>
    <l n="7" type="heading" level="2" para="true">II. Vocalium aliæ</l>
    <l n="8" type="heading" level="2">sunt mutabiles, aliæ immutabiles.</l>
    <l n="9" para="true">Mutabiles, quæ formandis</l>
    <l n="10">temporibus Verborum in alias commutari</l>
    <l n="11">solent, ut, α &amp; ε in η: o in ω.</l>
    <l n="12" para="true">Immutabiles,</l>
    <l n="13">quæ sic in alias</l>
    <l n="14">mutari non solent, ut, η, ι, υ, &amp; ω.</l>
    <l n="15" type="heading" level="2" para="true">III. Vocalium aliæ sunt præpositivæ,</l>
    <l n="16" type="heading" level="2">aliæ postpositivæ.</l>
    <l n="17" para="true">Præpositivæ, quæ in diphthongis</l>
    <l n="18">præponuntur, ut: α, ε, η, ο, &amp; ω.</l>
    <l n="19" para="true">Postpositivæ, quæ in diphthongis</l>
    <l n="20">postponuntur, ut: ι, &amp; υ. [Quanquam</l>
    <l n="21">υ in unica diphthongo etiam præponi-</l>
    <l n="22">tur, sequente ι.]</l>
    <l n="23" para="true">
      <i>Diphthongi</i> sunt duodecim: sex pro-</l>
    <l n="24">priæ, &amp; sex impropriæ.</l>
    <l n="25" para="true">Propriæ, quarum mistus sonus in</l>
    <l n="26">pronuntiando exauditur, ut: αυ, ευ, ευ, ου, οι, υι.</l>
    <l n="27" para="true">Impropriæ, quarum mistus sonus in</l>
    <l n="28">pronuntiando non exauditur, ut: α, η, ω, η, ηυ, ωυ.</l>
  </main_text>
