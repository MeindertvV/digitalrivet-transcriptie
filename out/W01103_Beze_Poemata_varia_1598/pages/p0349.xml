  <main_text>
    <l n="1" para="true">
      <i>Origo rerum: nescia Principum</i>
    </l>
    <l n="2" para="true">
      <i>Sperare Regem, nescia credere,</i>
    </l>
    <l n="3" para="true">
      <i>Vero, potenti, nostra proteruitas.</i>
    </l>
    <l n="4" para="true">
      <i>Hac caterorum femina criminum,</i>
    </l>
    <l n="5" para="true">
      <i>Hunc fas reatum dicere seculi:</i>
    </l>
    <l n="6" para="true">
      <i>Iustus malorum luxuriantium</i>
    </l>
    <l n="7" para="true">
      <i>Fons Ynde, &amp; omnis causa periculi.</i>
    </l>
    <l n="8" para="true">
      <i>Dedere lustris anterioribus</i>
    </l>
    <l n="9" para="true">
      <i>Hac nempe Gallum talia pracinem,</i>
    </l>
    <l n="10" para="true">
      <i>Illum, parentis munus Olympici.</i>
    </l>
    <l n="11" para="true">
      <i>Egressa priscum qua penitus modum</i>
    </l>
    <l n="12" para="true">
      <i>Nunc nunc Britannus, nunc Latialibus,</i>
    </l>
    <l n="13" para="true">
      <i>Nunc Lusitanis, nunc Calydoniis,</i>
    </l>
    <l n="14" para="true">
      <i>Et Vltimarum denique gentium</i>
    </l>
    <l n="15" para="true">
      <i>Egent cothurnis. Viuite perpetes</i>
    </l>
    <l n="16" para="true">
      <i>Par grande Vatum, Viuite, Viuite:</i>
    </l>
    <l n="17" para="true">
      <i>Piaque cinKti tempora laurea</i>
    </l>
    <l n="18" para="true">
      <i>Verum sacratis ISACIVM modis</i>
    </l>
    <l n="19" para="true">
      <i>Effere. Lauri non alia magis</i>
    </l>
    <l n="20" para="true">
      <i>Amoliantur fulmina Calitum.</i>
    </l>
    <l n="21" type="heading" level="1" para="true">IAC. LECTIVS</l>
