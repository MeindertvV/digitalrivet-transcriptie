  <page_number>188</page_number>
  <running_head />
  <bottom_margin>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Celant Leones se gravioribus</i>
    </l>
    <l n="2">
      <i>Audax Viator casibus obiicit.</i>
    </l>
    <l n="3">
      <i>Nam faustitatis nescia Olympica</i>
    </l>
    <l n="4">
      <i>Vitaque velox curriculum breuis</i>
    </l>
    <l n="5">
      <i>Ignara certo tramite flectere.</i>
    </l>
    <l n="6">
      <i>Mox poscit, auri cæca cupidine,</i>
    </l>
    <l n="7">
      <i>Merces remoto sole per Indicos</i>
    </l>
    <l n="8">
      <i>Portus &amp; oras Aethiopum, aut Syrtha</i>
    </l>
    <l n="9">
      <i>Campos rigentes perpetuo gelu.</i>
    </l>
    <l n="10">
      <i>Mox dirus illam laudis amor dies</i>
    </l>
    <l n="11">
      <i>Noctesque torquet, perque pericula</i>
    </l>
    <l n="12">
      <i>Leuesque curas, perfidiam &amp; dolos</i>
    </l>
    <l n="13">
      <i>Vrget volucrem quaerere gloriam.</i>
    </l>
    <l n="14">
      <i>Mox impotentis seruitio gula</i>
    </l>
    <l n="15">
      <i>Abrepta molles ventricolæ probat</i>
    </l>
    <l n="16">
      <i>Mensas Apicii, Sinaeque Præsulum</i>
    </l>
    <l n="17">
      <i>Seruata cellis frigidioribus,</i>
    </l>
    <l n="18">
      <i>Atque infolentis Cyprigenæ locos,</i>
    </l>
    <l n="19">
      <i>Quæ furta monstrat turpia, &amp; improbam</i>
    </l>
    <l n="20">
      <i>Sectatur ardens Ingluuiem comes.</i>
    </l>
    <l n="21">
      <i>Hinc pallet horrens, quum Stygios specus</i>
    </l>
    <l n="22">
      <i>Intrare cogit fama Necessitas.</i>
    </l>
    <l n="23">
      <i>Nec morte quicquam censet amarius,</i>
    </l>
    <l n="24">
      <i>Quod curta mutat perpetuis ferox</i>
    </l>
    <l n="25">
      <i>Fugacis aui gaudia fletibus:</i>
    </l>
    <l n="26">
      <i>Nec ferre secum lucra laboribus</i>
    </l>
    <l n="27">
      <i>Quaesita magnis ad tumulum sinat.</i>
    </l>
    <l n="28">
      <i>Hoc peius Vrit, quod miseras pauet</i>
    </l>
    <l n="29">
      <i>Post fata mortes mens male conscia</i>
    </l>
  </main_text>
  <notes>Printed page number "188" at top right, in the upper corner of the text block. Section of verse set in italic; ornamental ampersand forms rendered as &amp;. Long s is plain s throughout. Transcribed as printed, including the printed spellings.</notes>
