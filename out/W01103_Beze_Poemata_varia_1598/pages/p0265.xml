  <page_number>114</page_number>
  <running_head>EPIGRAMMATA.</running_head>
  <bottom_margin>
    <signature>†o 2</signature>
  </bottom_margin>
  <main_text>
    <l n="1" type="heading" level="2" para="true">Lamentatio animæ Christianæ</l>
    <l n="2" type="heading" level="2">ad æternam vitam anhelantis.</l>
    <l n="3" para="true">
      <i>O Quando, quando, mi</i>
    </l>
    <l n="4">
      <i>Deus, Hoc me bono dignaberis,</i>
    </l>
    <l n="5">
      <i>Splendore vultus vt tui</i>
    </l>
    <l n="6">
      <i>Præsente præsens perfruar?</i>
    </l>
    <l n="7" para="true">
      <i>Vultus serena splendeat</i>
    </l>
    <l n="8">
      <i>Qui luce quauis purior,</i>
    </l>
    <l n="9">
      <i>Vultu ipse qualis cœlitus</i>
    </l>
    <l n="10">
      <i>Aspectus olim fum tibi.</i>
    </l>
    <l n="11" para="true">
      <i>Quum mille mille criminum</i>
    </l>
    <l n="12">
      <i>Chnoxium pœnis tibi.</i>
    </l>
    <l n="13">
      <i>Solutor, at non debitor,</i>
    </l>
    <l n="14">
      <i>Me liberum dimitteres!</i>
    </l>
    <l n="15" para="true">
      <i>O quando tandem, mi Deus,</i>
    </l>
    <l n="16">
      <i>Quando infidentem gemmeo,</i>
    </l>
    <l n="17">
      <i>Excelsa supra sydera</i>
    </l>
    <l n="18">
      <i>Te conspicabor in throno?</i>
    </l>
    <l n="19" para="true">
      <i>Throno tui cultoribus</i>
    </l>
    <l n="20">
      <i>Cunctis ter optatissimo,</i>
    </l>
    <l n="21">
      <i>Throno tuis sed hostibus</i>
    </l>
    <l n="22">
      <i>Summe timendo cateris.</i>
    </l>
    <l n="23" para="true">
      <i>Natiua qua meas adhuc</i>
    </l>
  </main_text>
</page>
