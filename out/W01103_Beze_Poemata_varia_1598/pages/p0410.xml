      <i>Tot bella miror &amp; feras</i>
    </l>
    <l n="5">
      <i>Vigere lites, quibus muce</i>
    </l>
    <l n="6">
      <i>Sit causa cassa vilior.</i>
    </l>
    <l n="7" para="true">
      <i>Augere si suam queat</i>
    </l>
    <l n="8">
      <i>Rem pauper arduos petit</i>
    </l>
    <l n="9">
      <i>Gradus honorum tangere.</i>
    </l>
    <l n="10">
      <i>Quo plura dives possidet</i>
    </l>
    <l n="11">
      <i>Illum cupido saevior</i>
    </l>
    <l n="12">
      <i>Torrere saevit anxium.</i>
    </l>
    <l n="13" para="true">
      <i>Et Imperatores movent</i>
    </l>
    <l n="14">
      <i>Regesque passim proelia</i>
    </l>
    <l n="15">
      <i>Funesta: &amp; ut suos magis</i>
    </l>
    <l n="16">
      <i>Augere possint limites</i>
    </l>
    <l n="17">
      <i>Totum cruentis gestiunt</i>
    </l>
    <l n="18">
      <i>Orbem replere cadibus.</i>
    </l>
    <l n="19" para="true">
      <i>Et cuncta litibus fora</i>
    </l>
    <l n="20">
      <i>Clamoribusque dissonis</i>
    </l>
    <l n="21">
      <i>Strepunt: Deique perfidus</i>
    </l>
    <l n="22">
      <i>Contemptor audet brachio</i>
    </l>
    <l n="23">
      <i>Fidens furente Olympicis</i>
    </l>
    <l n="24">
      <i>Bellum minari sedibus.</i>
    </l>
    <l n="25" para="true">
      <i>Quarit per irati maris</i>
