  <main_text>
    <l n="1" para="true">
      <i>Unde orbis inferi loca</i>
    </l>
    <l n="2">
      <i>Iam puriore lumine</i>
    </l>
    <l n="3">
      <i>Cernens, ubique tot mala,</i>
