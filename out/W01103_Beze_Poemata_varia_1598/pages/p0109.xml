  <main_text>
    <l n="1" type="heading" level="1" para="true">THEODORI BEZÆ</l>
    <l n="2" type="heading" level="1">EPITAPHIA.</l>
    <l n="3" type="heading" level="2" para="true">Francisci I. Francorum Regis. P.P.</l>
    <l n="4" type="heading" level="2">Et bonarum literarum excitatoris Sacræ</l>
    <l n="5" type="heading" level="2">Memori-</l>
    <l n="6" type="heading" level="2">æ.</l>
    <l n="7" para="true">OBILE, quisquis ades, Regis Genera-</l>
    <l n="8">re sepulchrum,</l>
    <l n="9">Regis sepulchrum nobilis,</l>
    <l n="10">Nec pigeat mecum Francorum in-</l>
    <l n="11">commoda flere,</l>
    <l n="12">Dum multa paucis explico:</l>
    <l n="13" para="true">Corporis atque animi florentem dotibus, atque</l>
    <l n="14">Re facile primum, vt nomine,</l>
    <l n="15">Franciscum hunc Regem vidit fors falsa, simulq;</l>
    <l n="16">Invidit, vt bonis solet.</l>
    <l n="17" para="true">Illum igitur ficto interdum demulsit amore,</l>
    <l n="18">Et inclytis victoriis,</l>
    <l n="19">Repulit irata interdum, saltuque minaci</l>
    <l n="20">Tradidit in hostium manus.</l>
    <l n="21" para="true">Sed nec fors illum melior sic extulit unquam,</l>
    <l n="22">Vt esset immemor sui,</l>
    <l n="23">Nec fors unquam animos illi sic fregit acerba,</l>
    <l n="24">Quin victus, illam vinceret.</l>
    <l n="25" para="true">Ergo suos cernens vanos fors ista labores,</l>
    <l n="26">Et irritos omnes dolos,</l>
  </main_text>
  <bottom_margin>
    <signature>E 4</signature>
  </bottom_margin>
</page>
