  <main_text>
    <l n="1" type="heading" level="1" para="true">X GALLICA TH. BEZÆ</l>
    <l n="2" type="heading" level="1">CANTIONE QVÆ SIC</l>
    <l n="3" type="heading" level="1">INCIPIT.</l>
    <l n="4" type="heading" level="2" para="true">Seiché de douleur.</l>
    <l n="5" para="true">
      <i>DOlore ficcum languido,</i>
    </l>
    <l n="6">
      <i>Calore coctum feruido</i>
    </l>
    <l n="7">
      <i>Me,Cælitum ô parens,Sides:</i>
    </l>
    <l n="8">
      <i>Adhuc tamen tuum semel</i>
    </l>
    <l n="9">
      <i>umen,quod inuocat,cupit</i>
    </l>
    <l n="10">
      <i>lens nostra laude tollere.</i>
    </l>
    <l n="11" para="true">
      <i>ors dura nigris debile</i>
    </l>
    <l n="12">
      <i>orpus meum circumuolat</i>
    </l>
    <l n="13">
      <i>ennis:sed altas,te duce,</i>
    </l>
    <l n="14">
      <i>estit Volucris Spiritus</i>
    </l>
    <l n="15">
      <i>edes Olympi tangere,</i>
    </l>
    <l n="16">
      <i>uisque Vultibus frui.</i>
    </l>
    <l n="17" para="true">
      <i>Me,corpus inquit, iam premet</i>
    </l>
    <l n="18">
      <i>is Lethi inexorabilis.</i>
    </l>
    <l n="19">
      <i>eruire contrà corpori,</i>
    </l>
    <l n="20">
      <i>Mens inquit,ecce desinam.</i>
    </l>
    <l n="21">
      <i>Nil Vita nunc tecum est mihi</i>
    </l>
    <l n="22">
      <i>Polluta multo crimine.</i>
    </l>
    <l n="23" para="true">
      <i>Cordis panores anxij</i>
    </l>
  </main_text>
