  <page_number>183</page_number>
  <running_head />
  <bottom_margin>
    <catchword>Sed</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Vt mente curas, &amp; vigiles metus</i>
    </l>
    <l n="2">
      <i>Depellat ægra: quæque Amor improbo</i>
    </l>
    <l n="3">
      <i>Inflixit arcu vulnera, leniens</i>
    </l>
    <l n="4">
      <i>Dormire noctes audeat integras.</i>
    </l>
    <l n="5" para="true">
      <i>Fusum per umbras sub patula ilice</i>
    </l>
    <l n="6">
      <i>Aut in virenti gramine dulcibus</i>
    </l>
    <l n="7">
      <i>Suadet fusurris lympha loquax leues</i>
    </l>
    <l n="8">
      <i>Inire somnos, quà trepidans salit</i>
    </l>
    <l n="9">
      <i>Per saxa, ripas aut quatit herbidas.</i>
    </l>
    <l n="10" para="true">
      <i>Non dormientem tympana, nec tubæ</i>
    </l>
    <l n="11">
      <i>Bellum cientes euigilant: neque</i>
    </l>
    <l n="12">
      <i>Iniuncta cogunt corripere ocyus</i>
    </l>
    <l n="13">
      <i>Arma, &amp; sequentem signa ducis sui</i>
    </l>
    <l n="14">
      <i>Stratis relictis ad tumulum rapi.</i>
    </l>
    <l n="15" para="true">
      <i>Vt lucis ales nuntia cantibus</i>
    </l>
    <l n="16">
      <i>Hunc excitauit, certaque languida</i>
    </l>
    <l n="17">
      <i>Signans quietis tempora non finit</i>
    </l>
    <l n="18">
      <i>Lecto iacentem stertere longius:</i>
    </l>
    <l n="19" para="true">
      <i>Mox intrat hortum, quosque suo rigat</i>
    </l>
    <l n="20">
      <i>Aurora flores rore videns stupet,</i>
    </l>
    <l n="21">
      <i>Auctosque caules, &amp; viridans olus,</i>
    </l>
    <l n="22">
      <i>Et grata crudo ruricolæ allia.</i>
    </l>
    <l n="23" para="true">
      <i>Dehinc poscit agros adque suum redit</i>
    </l>
    <l n="24">
      <i>Pronus laborem, charaque munia.</i>
    </l>
    <l n="25" para="true">
      <i>Non urbis illum strictior inficit</i>
    </l>
    <l n="26">
      <i>Fœtore vicus, cum canis igneos</i>
    </l>
    <l n="27">
      <i>Torquet vapores, &amp; sitiens Leo</i>
    </l>
    <l n="28">
      <i>Febres anhelas corporibus parit.</i>
    </l>
    <l n="29">
      <i>Sed carpit auras incola rustica</i>
    </l>
  </main_text>
