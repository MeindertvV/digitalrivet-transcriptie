  <page_number>167</page_number>
  <running_head>ABRA. SACRIFICANS.</running_head>
  <main_text>
    <l n="1" para="true">
      <i>Abfunt: panida qua mater optat annue,</i>
    </l>
    <l n="2" para="true">
      <i>Annue marita fi fuum fibi cupit</i>
    </l>
    <l n="3" para="true">
      <i>Reddi maritum. Sed diutius fi Ȼelis</i>
    </l>
    <l n="4" para="true">
      <i>Illos morari, robur auge pectori:</i>
    </l>
    <l n="5" para="true">
      <i>Labantis animum fustine, &amp; fac, ut datu</i>
    </l>
    <l n="6" para="true">
      <i>Subnixa promissis tuos nutus sequar.</i>
    </l>
    <l n="7" type="heading" level="2" para="true">Abrahamus. Sathanas.</l>
    <l n="8" para="true">
      <i>O magne Cæli Rector, ô parens bone,</i>
    </l>
    <l n="9" para="true">
      <i>O cerne, quàm nunc sauientum turbine</i>
    </l>
    <l n="10" para="true">
      <i>Tentationum attonitus horribili opprimar!</i>
    </l>
    <l n="11" para="true">
      <i>Quibus procellis impetitus æstuem!</i>
    </l>
    <l n="12" para="true">
      <i>Accurre, fer opem mitis, &amp; graues, precor,</i>
    </l>
    <l n="13" para="true">
      <i>Compone fluctus: namque solus asperis</i>
    </l>
    <l n="14" para="true">
      <i>Rebus mederis. Pectus inuictum tuo</i>
    </l>
    <l n="15" para="true">
      <i>Largire seruo, ne fatiscat seruidis</i>
    </l>
    <l n="16" para="true">
      <i>Tandem duellis pressus. Aurem commodi</i>
    </l>
    <l n="17" para="true">
      <i>Concede, quaso, ut in tuum queam sinum</i>
    </l>
    <l n="18" para="true">
      <i>Mentis querelas inquieta effundere,</i>
    </l>
    <l n="19" para="true">
      <i>Quantisque luctor cum malis, recludere.</i>
    </l>
    <l n="20" type="heading" level="3" para="true">Sathanas.</l>
    <l n="21" para="true">
      <i>Mens nutat illi, cum Deo duras parat</i>
    </l>
    <l n="22" para="true">
      <i>Mouere lites: haret incertus, neque</i>
    </l>
    <l n="23" para="true">
      <i>Tam firma eeu nuper manet fides, ubi</i>
    </l>
    <l n="24" para="true">
      <i>Illi</i>
    </l>
    <l n="25">
      <i>propius nunc congredi est opus, fugit</i>
    </l>
    <l n="26" para="true">
      <i>Horrens Isaci sanguine aras tingere.</i>
    </l>
    <l n="27" type="heading" level="3" para="true">Abrahamus.</l>
    <l n="28" para="true">
      <i>Num dicta mutas, quaque sanxisti prius</i>
    </l>
  </main_text>
