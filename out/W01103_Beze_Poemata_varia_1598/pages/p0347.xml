  <main_text>
    <l n="1" para="true">
      <i>Quod nequeant abolere</i> PARCÆ.</l>
    <l n="2" para="true">
      <i>Mox cana formam perdit anilitas</i>
    </l>
    <l n="3" para="true">
      <i>Pallescsque febris: nec Iuuenum diu</i>
    </l>
    <l n="4" para="true">
      <i>Durat caducum robur, auctas</i>
    </l>
    <l n="5" para="true">
      <i>Vastat opes, nitidosque census,</i>
    </l>
    <l n="6" para="true">
      <i>Quum Sceleste tectus</i> MARS <i>adamantina</i>
    </l>
    <l n="7" para="true">
      <i>Replet cruentis omnia motibus,</i>
    </l>
    <l n="8" para="true">
      <i>Dirisque flammis, &amp; scelesto</i>
    </l>
    <l n="9" para="true">
      <i>Ense furens populatur arces.</i>
    </l>
    <l n="10" para="true">
      <i>Sed dona casta</i> PALLADIS <i>haud timent</i>
    </l>
    <l n="11" para="true">
      <i>Funesta belli damna, nec improbos</i>
    </l>
    <l n="12" para="true">
      <i>Regum furores: temporisque</i>
    </l>
    <l n="13" para="true">
      <i>Inuidiam, rapidosque dentes.</i>
    </l>
    <l n="14" para="true">
      <i>Sic perge, rectos &amp; monitus tuí</i>
    </l>
    <l n="15" para="true">
      <i>Ductoris audi: dum tibi florida</i>
    </l>
    <l n="16" para="true">
      <i>Nunc Sernat aetas, per labores</i>
    </l>
    <l n="17" para="true">
      <i>Egregios meliora semper</i>
    </l>
    <l n="18" para="true">
      <i>Addisce prudens: clarior ut domum</i>
    </l>
    <l n="19" para="true">
      <i>Tandem remigres, &amp; MORAVVM Urbibus</i>
    </l>
    <l n="20" para="true">
      <i>Prodesse possis, seu sit acri</i>
    </l>
    <l n="21" para="true">MARTE <i>ferox superandus hostis:</i>
    </l>
    <l n="22" para="true">
      <i>Praestantiori publica seu tibi</i>
    </l>
    <l n="23" para="true">
      <i>Augenda res sit consilio, aut bona</i>
    </l>
    <l n="24" para="true">
      <i>Paces inuanda, si pudendum</i>
    </l>
    <l n="25" para="true">
      <i>Poena nefas metuenda perdat.</i>
    </l>
    <l n="26" para="true">
      <i>Non robur auffert cordibus insitum</i>
    </l>
    <l n="27" para="true">
      <i>Doctrina honestis: fortior artibus</i>
    </l>
    <l n="28" para="true">CHIRONIS <i>infestos</i> ACHILLES</l>
    <l n="29" para="true">TROIVGENAS PRIAMVMQVE <i>Sicit,</i>
    </l>
