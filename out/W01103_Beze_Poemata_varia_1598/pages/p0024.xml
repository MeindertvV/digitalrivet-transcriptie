    <catchword>Ridétque</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" type="heading" level="1" para="true">AD EVNDEM.</l>
    <l n="2" para="true">
      <i>Non sola Satum nobilior cohors</i>
    </l>
    <l n="3">
      <i>Laudes meretur, pollice qua lyras</i>
    </l>
    <l n="4">
      <i>Dulci retractans digna Phæbo,</i>
    </l>
    <l n="5">
      <i>Digna canit Charitum choris.</i>
    </l>
    <l n="6" para="true">
      <i>Parem reportat postuenientibus</i>
    </l>
    <l n="7">
      <i>Seclis honorem qui melicribus</i>
    </l>
    <l n="8">
      <i>Fauet camoenis, Palladisque</i>
    </l>
    <l n="9">
      <i>Doctificas veneratur artes,</i>
    </l>
    <l n="10" para="true">
      <i>Frontésque lauru Pieria colit</i>
    </l>
    <l n="11">
      <i>Semper virentes: nec cariesfinit</i>
    </l>
    <l n="12">
      <i>Squallente morderi specu</i>
    </l>
    <l n="13">
      <i>Tartareo monumenta mergi,</i>
    </l>
    <l n="14" para="true">
      <i>Qua docta finxit Thespiadum manus,</i>
    </l>
    <l n="15">
      <i>Et laudat auspex Cynthius. Hinc decus</i>
    </l>
    <l n="16">
      <i>Auxit superbum qui ferocem</i>
    </l>
    <l n="17">
      <i>Rex Macedo Babylona vicit,</i>
    </l>
    <l n="18" para="true">
      <i>Atque ipse Cæsar qui Pharias rates</i>
    </l>
    <l n="19">
      <i>Mersit profundis fluctibus Actij,</i>
    </l>
    <l n="20">
      <i>Thuscusque Mæcenas, &amp; omni</i>
    </l>
    <l n="21">
      <i>Scipiades memorandus æuo.</i>
    </l>
    <l n="22" para="true">
      <i>Hi dona pluris Pegasidum Indicis</i>
    </l>
    <l n="23">
      <i>Fecere gemmis. Nam capiunt citas</i>
    </l>
    <l n="24">
      <i>Oblitiones, si diferto</i>
    </l>
    <l n="25">
      <i>Vate carent benefacta Regum,</i>
    </l>
    <l n="26" para="true">
      <i>Sed Recta cunctis temporibus manet</i>
    </l>
    <l n="27">
      <i>Virtus senero carmine alite,</i>
    </l>
    <l n="28" para="true">
      <i>Ridétque</i>
    </l>
  </main_text>
