  <main_text>
    <l n="1" para="true">
      <i>Illius at sæpe impotens</i>
    </l>
    <l n="2">
      <i>Procella mersis nauibus</i>
    </l>
    <l n="3">
      <i>Ponit modum cupidini.</i>
    </l>
    <l n="4" para="true">
      <i>Terris relictis ad suos</i>
    </l>
    <l n="5">
      <i>Fugere cælos Veritas</i>
    </l>
    <l n="6">
      <i>Fideíque: Cuncta Pontifex,</i>
    </l>
    <l n="7">
      <i>Cohorsque Cardinalium</i>
    </l>
    <l n="8">
      <i>Passim gubernant: hoc fluunt</i>
    </l>
    <l n="9">
      <i>Prognata fonte tot mala.</i>
    </l>
    <l n="10" para="true">
      <i>Vbique cuncta Turcicum</i>
    </l>
    <l n="11">
      <i>Domare cerno militem:</i>
    </l>
    <l n="12">
      <i>Canum cateruas &amp; suum</i>
    </l>
    <l n="13">
      <i>Vbique denso confpicor</i>
    </l>
    <l n="14">
      <i>Mersas voluptabro sequi</i>
    </l>
    <l n="15">
      <i>Erroris atri dogmata.</i>
    </l>
    <l n="16" para="true">
      <i>Sunt rura plena &amp; oppida</i>
    </l>
    <l n="17">
      <i>Nefariorum cœtibus,</i>
    </l>
    <l n="18">
      <i>Audaciumque hostilia</i>
    </l>
    <l n="19">
      <i>Monere bella Numini:</i>
    </l>
    <l n="20">
      <i>Quorum furentes dexteras</i>
    </l>
    <l n="21">
      <i>Supreme Iudex obtere.</i>
    </l>
    <l n="22" para="true">
      <i>O, bruta corda Plebium!</i>
    </l>
    <l n="23">
      <i>Mortalium, ò, demens furor,</i>
    </l>
    <l n="24">
      <i>Suique nescius mali!</i>
    </l>
    <l n="25">
      <i>O, terra cadium appetens!</i>
    </l>
    <l n="26">
      <i>O, terra semper ebria</i>
    </l>
    <l n="27">
      <i>Innoxiorum sanguine!</i>
    </l>
  </main_text>
