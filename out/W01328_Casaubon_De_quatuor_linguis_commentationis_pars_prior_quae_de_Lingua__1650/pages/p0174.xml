    <l n="19" para="true">Tertiò, in vestigandis originibus</l>
    <l n="20">magna ratio habenda analogiæ, tum</l>
    <l n="21">communis, tum peculiaris cujusque</l>
    <l n="22">linguæ.</l>
    <l n="23" para="true">Analogiam voco quicquid in ver-</l>
    <l n="24">borum formatione, vel literarum per-</l>
    <l n="25">mutatione, ratione aliquâ, in natura</l>
    <l n="26">vel confuetudine fundatâ, nititur. Hoc</l>
