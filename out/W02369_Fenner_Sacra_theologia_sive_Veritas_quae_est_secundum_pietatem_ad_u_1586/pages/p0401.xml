    <l n="1" para="true">'Hinc etiam ministeria intermedia. <i>Exprace-</i>
    </l>
    <l n="2">
      <i>dentibus omnibus cum</i> Rom. 15. 8. <i>inter se com-</i>
    </l>
    <l n="3">
      <i>paratis.</i>
    </l>
    <l n="4" type="diagram" level="1">Intermedij ministerij propria membra sunt</l>
    <l n="5" type="diagram" level="2">Specialis doctrinae</l>
    <l n="6" type="diagram" level="2">Eam etiam obsignantis</l>
    <l n="7" type="diagram" level="2">administratio</l>
    <l n="8" para="true">Act. 19. 1.4.5. Mat.3.1.2.3.4.5.6.11. &amp; 4.17. Ioa.4.1.2.</l>
    <l n="9" type="diagram" level="1">Specialis doctrinae duo membra erant</l>
    <l n="10" type="diagram" level="2">Primum, regnum Dei iam iam appro-</l>
    <l n="11" type="diagram" level="2">pinquare.</l>
    <l n="12" type="diagram" level="2">Secundū, vt ex vera resipiscentia ad il-</l>
    <l n="13" type="diagram" level="2">lud recipiendū sint comparati.</l>
    <l n="14" para="true">Mat.3.2. &amp; 4.17. &amp; 10.5.6.7.8. Ioan.4. 1.2.35.36. 37.38.</l>
    <l n="15">
      <i>inter se collatis.</i>
    </l>
    <l n="16" type="diagram" level="1">Intermedia ministeria, fuit</l>
    <l n="17" type="diagram" level="2">Ioannis Baptistae ministerium.</l>
    <l n="18" type="diagram" level="2">Euangelicae politeiae</l>
    <l n="19" type="diagram" level="2">magis contiguū.</l>
    <l n="20">Ioa.2.25.26. Mat. 10. 1.6. 7. Luc.3. 13. &amp; 9.1.2 3.4.</l>
    <l n="21">Luc.7. 33.34.</l>
    <l n="22" para="true">Iohannis Baptistae ministerium, est ministerium</l>
    <l n="23">intermedium, quo Christi erat praenuncius. Mat. vlt.</l>
    <l n="24">Mar.1.1.2.3. Luc.3.4.5.6.7.8. &amp; 2.76.77.78.</l>
    <l n="25" type="diagram" level="1">Eius membra pro-</l>
