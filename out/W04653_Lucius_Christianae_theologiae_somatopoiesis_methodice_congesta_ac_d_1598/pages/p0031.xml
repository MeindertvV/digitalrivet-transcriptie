<page type="text" lines="ocr">
  <layout>One page of text, single column; running head at top with page number left. No margin notes.</layout>
  <page_number>24</page_number>
  <running_head>De Sacramentis</running_head>
  <main_text>
    <l n="1" para="true">Vetus Teftamétum, <i>eft verbum</i>
    </l>
    <l n="2">
      <i>Euángelii, de Chrifto incarnando.</i> Vetus <i>d-</i>
    </l>
    <l n="3">
      <i>icitur, quòd Chrifto exhibito cesserit.</i> Heb.</l>
    <l n="4">8.v.13.</l>
    <l n="5" para="true">Novum Teftamentum, <i>eft verbum</i>
    </l>
    <l n="6">
      <i>Euangelii, de Chrifto jam incarnato.</i>
    </l>
    <l n="7">Novum <i>appellatur, quòd Veteri successerit.</i>
    </l>
    <l n="8" type="heading" level="2" para="true">Tractandum nunc etiam est</l>
    <l n="9" type="heading" level="2">de Sacramentis.</l>
    <l n="10" para="true">Sacramentum, <i>est symbolum visibile,</i>
    </l>
    <l n="11">
      <i>à Christo institutū, quo id, quod Verbo promissum</i>
    </l>
    <l n="12">
      <i>est, ob oculos repræsentatum</i>
    </l>
    <l n="13">
      <i>obsignatur.</i> Rom.4.v.11.</l>
    <l n="14" para="true">
      <i>Partes Sacramenti duæ sunt:</i> elementū</l>
    <l n="15">externum, &amp; ritus.</l>
    <l n="16" para="true">Elementum, <i>est res quædam corporea,</i>
    </l>
    <l n="17">
      <i>ad sacrum usumdestinata.</i>
    </l>
    <l n="18" para="true">Ritus, <i>est actio certa, quâ elementum</i>
    </l>
    <l n="19">
      <i>tractatur.</i>
    </l>
    <l n="20" para="true">
      <i>Sic duo etiam significantur à Sacramento:</i>
    </l>
    <l n="21">
      <i>res aliqua, &amp; actiones certæ.</i>
    </l>
    <l n="22" para="true">Res significata <i>omnium Sacramentorū,</i>
    </l>
    <l n="23">
      <i>est Christus cum omnibus suis beneficiis.</i>
    </l>
    <l n="24" para="true">Actio significatur: <i>cùm Dei, interius</i>
    </l>
    <l n="25">
      <i>in homine fideli gratia sua operantis; tum</i>
    </l>
    <l n="26">Hominis fidelis, <i>gratia Dei admittentis,</i>
    </l>
    <l n="27">
      <i>eiq; per fidem cooperantis.</i> Sa-</l>
  </main_text>
  <notes>Catchword "Sa-" at lower right; it is a line-end hyphenated word continuing on next page, shown in text.</notes>
</page>
