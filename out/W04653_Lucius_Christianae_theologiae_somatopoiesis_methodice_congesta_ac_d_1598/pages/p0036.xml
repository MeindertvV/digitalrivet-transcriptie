  <running_head>De Sacerd. &amp; Regno Christi</running_head>
  <bottom_margin>
    <signature>C 2</signature>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>Sacerdotale Christi officium est, quo</i>
    </l>
    <l n="2">
      <i>Christus, ut Sacerdos, Deum hominibus</i>
    </l>
    <l n="3">
      <i>propitium reddit.</i> Psal.110. v.4. Heb.5. v.9.</l>
    <l n="4" para="true">
      <i>Partes illius sunt:</i> satisfactio, &amp; inter-</l>
    <l n="5">cessio <i>apud Deum.</i>
    </l>
    <l n="6" para="true">Satisfactio <i>est, quâ Christus</i> λύτρον</l>
    <l n="7">
      <i>sufficiens pro peccatis generis humani, tam pro</i>
    </l>
    <l n="8">
      <i>culpa, quàm pro pœna, Deo persolvit, adeoque</i>
    </l>
    <l n="9">
      <i>justitiam ac salutem hominibus restituit.</i>
    </l>
    <l n="10">Jesaj.53.v.12. Dan.9.v.24. Rom.3.v.25. &amp; 5.</l>
    <l n="11">v.17.18. Heb.10.v.12. 1 Joh 1.v.7. &amp; 2.v.2.</l>
    <l n="12" para="true">Intercessio <i>est, quâ Christus pro suis</i>
    </l>
    <l n="13">
      <i>orat Deum Patrem, ut eos propter meritum &amp;</i>
    </l>
    <l n="14">
      <i>satisfactionem suam in gratiâ recipiat,</i>
    </l>
    <l n="15">
      <i>ac justitiâ vitamque æternam ipsis attribuat.</i>
    </l>
    <l n="16">Joh.17.v.9.seq. Heb.9.v.24.</l>
    <l n="17" type="heading" level="2" para="true">Restat de munere Regio.</l>
    <l n="18" para="true">Regium <i>denique Christi officium est, quo</i>
    </l>
    <l n="19">
      <i>ipse rex &amp; dominus creaturarum omnium,</i>
    </l>
    <l n="20">
      <i>præsertim verò suorum, à Deo Patre constitu-</i>
    </l>
    <l n="21">
      <i>tus, summâ cum autoritate præest &amp;</i>
    </l>
    <l n="22">
      <i>regnat.</i> Psal.2.v.6. Luc.1.v.33. Act.2.v.36.</l>
    <l n="23" para="true">
      <i>Atque hoc exserit maximè: in</i> conser-</l>
    <l n="24">vatione &amp; defensione suorum, Psal.2.</l>
    <l n="25">v.9. Joh.10.v.28. Ephes.4.v.8.seq. <i>ac</i> de-</l>
    <l n="26">bellatione hostium. Psalm.110. v.1.2.6.7.</l>
    <l n="27">1 Cor.15.v.26.</l>
  </main_text>
