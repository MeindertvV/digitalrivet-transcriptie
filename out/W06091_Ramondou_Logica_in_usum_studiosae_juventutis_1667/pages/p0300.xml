  <main_text>
    <l n="1" type="heading" level="1" caput="3" para="true">DISPVTATIO TERTIA.</l>
    <l n="2" type="heading" level="2" para="true">De qualitatibus inter</l>
    <l n="3" type="heading" level="2">se comparatis.</l>
    <l n="4" para="true">QValitates, vt dixi, aliæ carent con-</l>
    <l n="5">trario, vt lux, &amp; species inten-</l>
    <l n="6">tionales; quædam contrarium habent,</l>
    <l n="7">quemadmodum primæ 4. habitus, colo-</l>
    <l n="8">res, &amp;c. Oritur inde, vt si quando in</l>
    <l n="9">vno, eodemq; subiecto sint, mutuò pu-</l>
    <l n="10">gnent, agant, reagant, expellant se. Mo-</l>
    <l n="11">dò igitur comparandæ sunt ad inuicem,</l>
    <l n="12">&amp; primò disquirendum, qua ratione</l>
    <l n="13">actio ista, &amp; reactio, resistentia, &amp;</l>
    <l n="14">pulsio qualitatum. Vndè sit.</l>
    <l n="15" type="heading" level="1" caput="1" para="true">DISQVISITIO PRIMA.</l>
    <l n="16" type="heading" level="2" para="true">
      <i>Quomodo qualitates in subiecto</i>
    </l>
    <l n="17" type="heading" level="2">
      <i>reagant.</i>
    </l>
    <l n="18" para="true">PRO Intelligentia meminisse debetis</l>
    <l n="19">commune philosophorum axioma;</l>
    <l n="20">quod <i>agens agendo repatitur</i>, hoc est,</l>
    <l n="21">qualitates contrariæ quotiescunq; pugnât,</l>
    <l n="22">vna imminuit aliam, &amp; vicissim ab ea</l>
    <l n="23">imminuitur. Ratio autem est, nam qua-</l>
    <l n="24">litas aggressa non solùm resistit passiuè</l>
    <l n="25">se opponendo, sed etiam actiuè conan-</l>
    <l n="26">do aliquid, agendo, vulnusque infli-</l>
    <l n="27">gendo. Porrò actio differt à reactio-</l>
    <l n="28">ne iuxta modum operandi, nam</l>
    <l n="29">actio validior simpliciter actio denomina-</l>
  </main_text>
  <marginalia>
    <note side="right" at="Modò igitur comparandæ" line_from="10" line_to="10">fiat</note>
  </marginalia>
