  <page_number>113</page_number>
  <main_text>
    <l n="1" type="heading" level="1" caput="2" para="true">LIBER</l>
    <l n="2" type="heading" level="1" caput="2">SECUNDVS</l>
    <l n="3" type="heading" level="1" caput="2">PHYSICORVM</l>
    <l n="4" type="heading" level="2" para="true">De rerum naturalium</l>
    <l n="5" type="heading" level="2">caufis.</l>
    <l n="6" para="true">V<i>Idimus hucusque principia,qui-</i>
    </l>
    <l n="7">
      <i>bus vnaquæque res naturalis</i>
    </l>
    <l n="8">
      <i>intrinsecè conflatur, &amp; in esse</i>
    </l>
    <l n="9">
      <i>suo perfectissimo constituitur.</i>
    </l>
    <l n="10">
      <i>Iam verò explicandum foret,</i>
    </l>
    <l n="11">
      <i>quomodo hæc principia conueniant</i>
    </l>
    <l n="12">
      <i>simul, vnianturque ad compositi effectio-</i>
    </l>
    <l n="13">
      <i>nem. Sed quia id non fit, nisi ex prævio</i>
    </l>
    <l n="14">
      <i>causarum influxu, propterea nobis aderit</i>
    </l>
    <l n="15">
      <i>in hoc libro Tractatus de causis. Quid ni-</i>
    </l>
    <l n="16">
      <i>mirum sit Causa, quotuplex, quid in</i>
    </l>
    <l n="17">
      <i>se requirat, vt operetur, quid expectet ab</i>
    </l>
    <l n="18">
      <i>alio,&amp; huiusmodi. Quæ vtplurimum tam</i>
    </l>
    <l n="19">
      <i>Aristoteli, quàm cæteris philosophis com-</i>
    </l>
    <l n="20">
      <i>munia cùm sint, ideo sine multo dissidio</i>
    </l>
    <l n="21">
      <i>à nobis pertractabuntur.</i>
    </l>
    <l n="22" para="true">Diuidetur autem hoc opus quadruplici</l>
    <l n="23">disputatione. Prima erit de causis in</l>
    <l n="24">communi. Secunda fiet de causa Effi-</l>
    <l n="25">ciente particulari. Tertia de Finali.</l>
    <l n="26">Quarta de causa Prima, nempe Deo, cuius</l>
    <l n="27">influxu omnis causa secunda tam eget, vt</l>
    <l n="28">sine</l>
  </main_text>
  <notes />
</page>
