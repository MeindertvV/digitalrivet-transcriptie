  <running_head>Prima Pars</running_head>
  <main_text>
    <l n="1" type="heading" level="1" caput="3" para="true">DISQVISITIO TERTIA.</l>
    <l n="2" type="heading" level="2" para="true">An gradus qualitatis producta</l>
    <l n="3" type="heading" level="2">sint homogenei.</l>
    <l n="4" para="true">PRO intelligentia quæstionis aduer-</l>
    <l n="5">tite, gradus eos dici homogeneos,</l>
    <l n="6">qui sunt omnino similes, &amp; æqua-</l>
    <l n="7">lem habent perfectionem inter se, adeout</l>
    <l n="8">alter alterum non excedat. Ex aduer-</l>
    <l n="9">so siqui fierent dissimiles, &amp; perfe-</l>
    <l n="10">ctione inæquales, dicerentur eteroge-</l>
    <l n="11">nei. Quæritur ergo: dum agens intendit</l>
    <l n="12">qualitatem addendo primo gradui v.</l>
    <l n="13">gr. caloris, frigorisve alios, hi gra-</l>
    <l n="14">dus omnes itane habent se, vt sint si-</l>
    <l n="15">miles ? æquales ? æquè perfecti ? an</l>
    <l n="16">potiùs è contra, vt putat Suarez, Hur-</l>
    <l n="17">tadus, &amp; alij, secundus perfectior est</l>
    <l n="18">primo, tertius maior secundo ? &amp;c. Pro</l>
    <l n="19">solutione, sit.</l>
    <l n="20" type="heading" level="1" para="true">CONCLVSIO.</l>
    <l n="21" para="true">
      <i>Gradus qualitatis intensa homogenei</i>
    </l>
    <l n="22">
      <i>sunt, unde qualitas intensa non</i>
    </l>
    <l n="23">
      <i>differt a remissa, nisi per hoc</i>
    </l>
    <l n="24">
      <i>quod illa plures, hac</i>
    </l>
    <l n="25">
      <i>pauciores habet</i>
    </l>
    <l n="26">
      <i>gradus.</i>
    </l>
    <l n="27" para="true">PRobatur 1. quia si duo gradus om-</l>
    <l n="28">nino similes producantur in eadem</l>
    <l n="29">subiecti parte, constituunt maiorem</l>
    <l n="30">intensionem, ergo intensio qualitatis</l>
    <l n="31">fit</l>
  </main_text>
