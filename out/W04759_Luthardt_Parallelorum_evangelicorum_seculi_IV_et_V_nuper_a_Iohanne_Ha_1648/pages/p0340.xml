  <running_head>EVANGELII. SECULI V.</running_head>
  <bottom_margin>
    <catchword>disputa-</catchword>
    <signature>X 3</signature>
  </bottom_margin>
  <main_text>
    <l n="1">&amp; nos &amp; posteros nostros complecti-</l>
    <l n="2">tur, sequitur etiam Abelem peccasse.</l>
    <l n="3">Nullus itaque hic est parallelismus.</l>
    <l n="4" para="true">Interim non diffiteor Calvinum &amp;</l>
    <l n="5">cum ipso Theologos Orthodoxos tra-</l>
    <l n="6">ditiones dogmaticas, quas Pontificii</l>
    <l n="7">praeter &amp; contra scripturam urgent, &amp;</l>
    <l n="8">ecclesiae tanquam ad salutem necessa-</l>
    <l n="9">rias obtrudunt, reiicere. Nam <i>tradi-</i>
    </l>
    <l n="10">
      <i>tiones cum verbo conjungere est miscere a-</i>
    </l>
    <l n="11">
      <i>quam cum vino,</i> inquit Irenæus lib 3.</l>
    <l n="12">cap. 1. Et graviter Hieronymus in</l>
    <l n="13">Agg. c. 1. <i>Quae absque authoritate &amp; te-</i>
    </l>
    <l n="14">
      <i>stimoniis scripturarum quasi apostolica trad-</i>
    </l>
    <l n="15">
      <i>itione sponte reperiunt &amp; confingunt per-</i>
    </l>
    <l n="16">
      <i>cutit gladius Dei.</i> Cùm itaque Bellar-</l>
    <l n="17">minus fateatur <i>traditiones non fuisse scri-</i>
    </l>
    <l n="18">
      <i>pturae committendas, quòd mysteria sint</i>
    </l>
    <l n="19">
      <i>populo non divulganda,</i> &amp; hac ratione</l>
    <l n="20">in scriptura non contineantur, sequitur</l>
    <l n="21">secundùm Hieronymi iudicium illas</l>
    <l n="22">gladio Dei percutiendas esse.</l>
    <l n="23" para="true">Sed contra hanc sententiam nostram</l>
    <l n="24">disputa-</l>
  </main_text>
