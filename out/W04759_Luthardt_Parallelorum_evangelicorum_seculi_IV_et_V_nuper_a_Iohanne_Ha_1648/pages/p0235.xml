  <running_head>CASTIGATIO PARAL.</running_head>
  <main_text>
    <l n="1">ram datur signum ad collationem, &amp;</l>
    <l n="2">hic iterum lautè.</l>
    <l n="3" para="true">Nam Prælatis &amp; Canonicis appo-</l>
    <l n="4">nuntur confectiones, ficus, placentæ,</l>
    <l n="5">boleti, dactyli: aliis placentæ, poma,</l>
    <l n="6">pyra, nuces, uvæ, cum vino generoso</l>
    <l n="7">aut cerevisia. De his recte Augustinus</l>
    <l n="8">in Domin. in octavam Paschæ: <i>Sunt</i>
    </l>
    <l n="9">
      <i>quidam observantes quadragesimæ, deli-</i>
    </l>
    <l n="10">
      <i>tiosi potius, quàm religiosi, exquirentes novas</i>
    </l>
    <l n="11">
      <i>suavitates magis quàm veteres concu-</i>
    </l>
    <l n="12">
      <i>piscentias castigantes, qui pretiosis copiosis-</i>
    </l>
    <l n="13">
      <i>que diversorum, fructuum apparatibus</i>
    </l>
    <l n="14">
      <i>aliorum ciborum sapores superare contendunt.</i>
    </l>
    <l n="15">
      <i>Vasa in quibus coctæ sunt carnes,</i>
    </l>
    <l n="16">
      <i>tanquam immunda formidant, &amp; in carne</i>
    </l>
    <l n="17">
      <i>sua ventris &amp; gutturis luxuriam non</i>
    </l>
    <l n="18">
      <i>formidant.</i>
    </l>
    <l n="19" para="true">Ut ergò olim pharisæus dixerat;</l>
    <l n="20">
      <i>jejuno bis in sabbatho:</i> Sic Jesuita dicere</l>
    <l n="21">potest: <i>ego edo bis in jejunio.</i> Apud re-</l>
    <l n="22">liquos autem in papatu sicuti septua-</l>
    <l n="23">gesimæ</l>
  </main_text>
