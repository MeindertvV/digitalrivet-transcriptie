    <l n="3">homine fideli idcirco peccatum non</l>
    <l n="4">esse. <i>Quamdiu vivis</i>, inquit Augustinus</l>
    <l n="5">tract. 42. in Joh. <i>necessum est peccatum</i>
    </l>
    <l n="6">
      <i>esse in membris tuis</i>, <i>&amp; quisquis se incul-</i>
    </l>
