  <running_head>EVANGELI. SECULI. IV.</running_head>
  <bottom_margin>
    <catchword>SECV-</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">Ex Patribus profert <i>Basilium</i>, <i>Atha-</i>
    </l>
    <l n="2">
      <i>nasium</i>, deinde <i>Sophronium</i>, <i>Methodium</i>,</l>
    <l n="3">
      <i>Petrum Damiani</i>, <i>Anshelmum</i>, <i>Bernhar-</i>
    </l>
    <l n="4">
      <i>dum</i>. Sed responsio ad hæc facilis est.</l>
    <l n="5">
      <i>Primo</i> Basilii Liturgiam &amp; Athanasii</l>
    <l n="6">lib. de Deipara supposititia scripta esse</l>
    <l n="7">superius probavimus. Reliqui omnes</l>
    <l n="8">sunt neoterici, qui vixerunt in ea</l>
    <l n="9">ætate, quando idololatria</l>
    <l n="10">iam in ecclesia incepit</l>
    <l n="11">obtinere.</l>
  </main_text>
