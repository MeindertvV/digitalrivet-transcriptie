  <running_head>EVANGELI. SECULI. IV.</running_head>
  <bottom_margin>
    <signature>A 3</signature>
  </bottom_margin>
  <main_text>
    <l n="1">
      <i>aeternum Deum &amp; filium ipsius, quem ipse</i>
    </l>
    <l n="2">
      <i>creavit ante secula, &amp; filium suum fecit,</i>
    </l>
    <l n="3">
      <i>ita ut quicquid habet filius aliquando non</i>
    </l>
    <l n="4">
      <i>habuerit.</i> Sed &amp; spiritum sanctum a</l>
    <l n="5">Filio creatum esse, afferuit. Contra</l>
    <l n="6">hunc haereticum coacta fuit Synodus</l>
    <l n="7">Nicena anno cccxxv, ubi ipsius haere-</l>
    <l n="8">sis fuit damnata a 300. Episcopis, &amp;</l>
    <l n="9">Symbolum, quod Nicenum dictum,</l>
    <l n="10">conscriptum, in quo quid de Filio</l>
    <l n="11">Dei orthodoxe credendum perspicue</l>
    <l n="12">traditum fuit.</l>
    <l n="13" para="true">De progressu huius haeresewos plura</l>
    <l n="14">non dicam, quia apud <i>Athanasium</i>,</l>
    <l n="15">
      <i>Theodoretum</i>, alios haec fuse leguntur.</l>
    <l n="16">Unum hoc addam, verisimile esse Je-</l>
    <l n="17">suitas novam suam artem mentiendi</l>
    <l n="18">per <i>reservationem mentalem</i> ab hoc hae-</l>
    <l n="19">retico didicisse. Nam postquam</l>
    <l n="20">Constantia Constantini Imperatoris</l>
    <l n="21">soror, fratri obiiceret, quod cum Ario</l>
    <l n="22">inique actum esset in synodo Nicena,</l>
    <l n="23">&amp; quod Arius nihil aliud crederet,</l>
    <l n="24">quam quod ipsa synodus credit, permi-</l>
    <l n="25">sit.</l>
  </main_text>
  <notes />
</page>
