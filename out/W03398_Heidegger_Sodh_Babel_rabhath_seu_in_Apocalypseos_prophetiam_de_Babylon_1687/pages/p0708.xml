  <running_head>MYSTERIUM</running_head>
  <bottom_margin>
    <catchword>In</catchword>
  </bottom_margin>
  <main_text>
    <l n="1" para="true">
      <i>In opulenta requie,De</i>
    </l>
    <l n="2">
      <i>sorte miserorum.</i>
    </l>
    <l n="3">
      <i>Vivendo supervacuè:Qui</i>
    </l>
    <l n="4">
      <i>charitatem maximè-</i>
    </l>
    <l n="5">
      <i>Deberent exercere,</i>
    </l>
    <l n="6">
      <i>Pra cateris fidelibus-</i>
    </l>
    <l n="7">
      <i>In omnibus hominibus:</i>
    </l>
    <l n="8">
      <i>Virtutes exhibere.</i>
    </l>
    <l n="9">
      <i>Cum bonus exemplaribus-</i>
    </l>
    <l n="10">
      <i>Tam fœminis, quàm mari-</i>
    </l>
    <l n="11">
      <i>bus:</i>
    </l>
    <l n="12">
      <i>Viam salutis dare:</i>
    </l>
    <l n="13">
      <i>Non alta quidem sapere:</i>
    </l>
    <l n="14">
      <i>Non fremere, non rapere:</i>
    </l>
    <l n="15">
      <i>Non aliquem truffare-</i>
    </l>
    <l n="16">
      <i>Hæc essent meritoria,</i>
    </l>
    <l n="17">
      <i>Servorum Dei gloria,</i>
    </l>
    <l n="18">
      <i>Fidelium tutela:</i>
    </l>
    <l n="19">
      <i>Per quæ manerêt Principes,</i>
    </l>
    <l n="20">
      <i>Et Christiani simplices-</i>
    </l>
    <l n="21">
      <i>In fidei sequela.</i>
    </l>
    <l n="22">
      <i>Sed ubi possunt hæc discerni?</i>
    </l>
    <l n="23">
      <i>Cùm nec priores nec moderniPro</i>
    </l>
    <l n="24">
      <i>Deo famulentur:</i>
    </l>
    <l n="25">
      <i>Imò pro temporalibus-</i>
    </l>
    <l n="26">
      <i>Omnes ceu Spiritualibus-</i>
    </l>
    <l n="27">
      <i>Insistere videntur.</i>
    </l>
    <l n="28">
      <i>Majores cum minoribus-</i>
    </l>
    <l n="29">
      <i>Indocti cum doctoribus-</i>
    </l>
    <l n="30">
      <i>Et cæteri de clero,</i>
    </l>
    <l n="31">
      <i>Non habent rectam speciem,</i>
    </l>
    <l n="32">
      <i>Nec curant Cœli pretium,</i>
    </l>
    <l n="33" para="true">
      <i>De Christo Deo vero,</i>
    </l>
    <l n="34">
      <i>Sub cujus umbra latitant,</i>
    </l>
    <l n="35">
      <i>Et sua bona dissipant-</i>
    </l>
    <l n="36">
      <i>In pompa seculari:</i>
    </l>
    <l n="37">
      <i>Sunt PILATI non PRÆ-</i>
    </l>
    <l n="38">
      <i>LATI,</i>
    </l>
    <l n="39">
      <i>Plus quàm Tyranni depra-</i>
    </l>
    <l n="40">
      <i>vati:</i>
    </l>
    <l n="41">
      <i>In virtutibus ignari.</i>
    </l>
    <l n="42" para="true">
      <i>Per quos &amp; grex fidelium</i>
    </l>
    <l n="43" para="true">
      <i>Tractatur in interitum,</i>
    </l>
    <l n="44" para="true">
      <i>Messiâ permittente:</i>
    </l>
    <l n="45" para="true">
      <i>Corrupti simul pereunt,</i>
    </l>
    <l n="46" para="true">
      <i>Abominabilésque facti sunt</i>
    </l>
    <l n="47" para="true">
      <i>Diabolo suadente.</i>
    </l>
    <l n="48" para="true">
      <i>Non est qui bonum faciat,</i>
    </l>
    <l n="49" para="true">
      <i>Non est qui Deum diligat,</i>
    </l>
    <l n="50" para="true">
      <i>I-</i>
    </l>
    <l n="51">
      <i>nutiles effecti.</i>
    </l>
    <l n="52" para="true">
      <i>Ad munera respiciunt,</i>
    </l>
    <l n="53" para="true">
      <i>Justitiam non sitiunt,</i>
    </l>
    <l n="54" para="true">
      <i>Delicias illecti.</i>
    </l>
    <l n="55" para="true">
      <i>Non vivunt Christianiter,</i>
    </l>
    <l n="56" para="true">
      <i>Nec justè, nec humaniter,</i>
    </l>
    <l n="57" para="true">
      <i>In seculo præsenti:</i>
    </l>
    <l n="58" para="true">
      <i>Ut magna fortalitia,</i>
    </l>
    <l n="59" para="true">
      <i>Et plura beneficia</i>
    </l>
    <l n="60" para="true">
      <i>Possideant, intenti.</i>
    </l>
    <l n="61" para="true">
      <i>Eorum vere spiritus</i>
    </l>
    <l n="62" para="true">
      <i>Inanis est, &amp; irritus</i>
    </l>
    <l n="63" para="true">
      <i>Ad Dei famulatum:</i>
    </l>
    <l n="64" para="true">
      <i>Ab istis omnis gravitas</i>
    </l>
    <l n="65" para="true">
      <i>Egreditur, &amp; ruit pravi-tas.</i>
    </l>
  </main_text>
